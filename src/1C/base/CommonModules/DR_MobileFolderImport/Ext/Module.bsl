Функция Импортировать(ПользовательНастроек) Экспорт

	КореньОбмена = DR_MobileFiles.ПроверитьСерверныйКаталог(
		DR_MobileSettings.ПолучитьПутьХранилища(ПользовательНастроек));
	Корень = DR_MobileFiles.ПроверитьСерверныйКаталог(
		DR_MobileFiles.ПолучитьПутьСлужебногоКаталога(КореньОбмена, "Incoming"));
	ПроверитьРазделениеКаталогов(Корень);
	Итог = Новый Структура("Обработано,Принято,Повторов,Ошибок,Сообщения,УдаленоПакетов,ОсталосьПослеПриема", 0, 0, 0, 0, "", 0, 0);
	НайденныеОбъекты = НайтиФайлы(Корень, "*", Ложь);
	Для Каждого КаталогПакета Из НайденныеОбъекты Цикл
		Если НЕ КаталогПакета.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Итог.Обработано = Итог.Обработано + 1;
		Контекст = Новый Структура("document_id,Код,КодОшибки,request_id",
			Неопределено, 500, "internal_error", НРег(Строка(Новый УникальныйИдентификатор)));
		Этап = "Некорректный UUID имени каталога пакета.";
		Попытка
			Если НЕ DR_Validation.КорректныйUUID(КаталогПакета.Имя) Тогда
				ВызватьИсключение "Invalid package directory";
			КонецЕсли;

			Снимок = ПолучитьСнимокПакета(Корень, КаталогПакета.Имя);
			Этап = "Не удалось прочитать document.json.";
			Описание = Новый Файл(DR_MobileFiles.ПутьВнутри(КаталогПакета.ПолноеИмя, "document.json"));
			Если НЕ Описание.Существует() ИЛИ НЕ Описание.ЭтоФайл() Тогда
				ОтклонитьПакет(Контекст, "Отсутствует файл document.json.");
			КонецЕсли;
			Если Описание.Размер() < 1 ИЛИ Описание.Размер() > 32768 Тогда
				ОтклонитьПакет(Контекст, "Недопустимый размер document.json (от 1 до 32768 байт).");
			КонецЕсли;
			ДанныеОписания = Новый ДвоичныеДанные(Описание.ПолноеИмя);
			Этап = "Некорректный JSON или кодировка UTF-8 в document.json.";
			Пакет = ПрочитатьОписаниеПакета(ДанныеОписания, КаталогПакета.Имя, Контекст);
			Этап = "Недействительный файловый токен или мобильный обмен запрещён.";
			Доступ = DR_MobileSettings.АвторизоватьФайловыйТокен(Пакет.token);
			Для Каждого Свойство Из Доступ Цикл
				Контекст.Вставить(Свойство.Ключ, Свойство.Значение);
			КонецЦикла;
			Контекст.document_id = Пакет.document_id;
			Этап = "Не удалось проверить оригиналы пакета.";
			Документ = ПрочитатьФайлыПакета(Пакет, КаталогПакета.ПолноеИмя, Контекст);
			Этап = "Ошибка проверки ранее принятого документа или серверного пути оригиналов.";

			Если DR_MobileStorage.ПроверитьПовтор(Документ, Контекст) = Неопределено Тогда
				DR_MobileFiles.ПроверитьДлинуПутиДокумента(Документ.document_id, Контекст);
			КонецЕсли;
			Этап = "Ошибка серверного хранения или регистрации документа.";
			Результат = DR_MobileStorage.Зарегистрировать(Документ, Контекст);
			Если НЕ Результат.Квитанция.accepted ИЛИ Результат.Квитанция.document_id <> Документ.document_id
				ИЛИ НЕ DR_MobileStorage.МанифестыРавны(Результат.Квитанция.manifest, Документ.manifest)
				ИЛИ (Результат.Код = 201 И Результат.Квитанция.status <> "accepted")
				ИЛИ (Результат.Код = 200 И Результат.Квитанция.status <> "duplicate") Тогда
				ВызватьИсключение "Unconfirmed registration result";
			КонецЕсли;
			Если Результат.Код = 201 Тогда
				Итог.Принято = Итог.Принято + 1;
			ИначеЕсли Результат.Код = 200 Тогда
				Итог.Повторов = Итог.Повторов + 1;
			Иначе
				ВызватьИсключение "Unexpected registration result";
			КонецЕсли;

			Попытка
				ОчиститьПринятыйПакет(Корень, Пакет, Документ, Снимок, Контекст);
				Итог.УдаленоПакетов = Итог.УдаленоПакетов + 1;
			Исключение
				Итог.ОсталосьПослеПриема = Итог.ОсталосьПослеПриема + 1;
				Итог.Сообщения = Итог.Сообщения + "Пакет №" + Формат(Итог.Обработано, "ЧГ=0")
					+ ": документ принят; входной пакет не очищен полностью. Требуется ручная проверка папки." + Символы.ПС;
			КонецПопытки;
		Исключение
			Итог.Ошибок = Итог.Ошибок + 1;

			Причина = Этап;
			Уточнение = "";
			Если Контекст.Свойство("ПричинаОшибкиИмпорта", Уточнение) Тогда
				Причина = Уточнение;
			КонецЕсли;
			Если Контекст.КодОшибки = "uuid_content_conflict" Тогда
				Причина = "Конфликт UUID: документ уже имеет другие metadata или размеры.";
			КонецЕсли;
			Итог.Сообщения = Итог.Сообщения + "Пакет №" + Формат(Итог.Обработано, "ЧГ=0") + ": " + Причина + Символы.ПС;
		КонецПопытки;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ПрочитатьОписаниеПакета(Знач Данные, Знач UUIDКаталога, Контекст) Экспорт

	Попытка
		Пакет = DR_MobileMultipart.ПрочитатьСтрогийJSON(Данные, Контекст);
	Исключение
		ОтклонитьПакет(Контекст, "Некорректный JSON или кодировка UTF-8 в document.json.");
	КонецПопытки;
	ПроверитьПоля(Пакет, "format,version,document_id,token,document_type,page_count,files", Контекст);
	Если ТипЗнч(Пакет.format) <> Тип("Строка") ИЛИ ТипЗнч(Пакет.version) <> Тип("Число")
		ИЛИ ТипЗнч(Пакет.document_id) <> Тип("Строка") ИЛИ ТипЗнч(Пакет.token) <> Тип("Строка")
		ИЛИ ТипЗнч(Пакет.document_type) <> Тип("Строка") ИЛИ ТипЗнч(Пакет.page_count) <> Тип("Число")
		ИЛИ ТипЗнч(Пакет.files) <> Тип("Массив") Тогда
		ОтклонитьПакет(Контекст, "Некорректный тип поля в document.json.");
	КонецЕсли;
	Если Пакет.format <> "DoRIS.FileExchange" Тогда
		ОтклонитьПакет(Контекст, "Неподдерживаемый формат пакета.");
	КонецЕсли;
	Если Пакет.version <> 2 Тогда
		ОтклонитьПакет(Контекст, "Неподдерживаемая версия пакета. Требуется версия 2.");
	КонецЕсли;
	Если НЕ DR_Validation.КорректныйUUID(UUIDКаталога) ИЛИ НЕ DR_Validation.КорректныйUUID(Пакет.document_id) Тогда
		ОтклонитьПакет(Контекст, "Некорректный UUID документа или каталога пакета.");
	КонецЕсли;
	Если Пакет.document_id <> UUIDКаталога Тогда
		ОтклонитьПакет(Контекст, "UUID документа не совпадает с именем каталога пакета.");
	КонецЕсли;
	Возврат Пакет;

КонецФункции

Процедура ПроверитьРазделениеКаталогов(КаталогИмпорта) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПутьКПапке КАК Каталог, ИСТИНА КАК ЭтоКорень
        |ИЗ РегистрСведений.DR_НастройкиМобильныхДокументов
        |ГДЕ ПутьКПапке <> &ПустойПуть
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ РАЗЛИЧНЫЕ КаталогОригиналов, ЛОЖЬ
        |ИЗ РегистрСведений.DR_ПринятыеМобильныеДокументы
        |ГДЕ КаталогОригиналов <> &ПустойПуть";
	Запрос.УстановитьПараметр("ПустойПуть", "");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КаталогОригиналов = Выборка.Каталог;
		Если Выборка.ЭтоКорень Тогда
			КаталогОригиналов = DR_MobileFiles.ПутьВнутри(КаталогОригиналов, "Documents");
		КонецЕсли;
		Если DR_MobileFiles.КаталогиПересекаются(КаталогИмпорта, КаталогОригиналов) Тогда
			ВызватьИсключение "Входная папка пересекается с каталогом зарегистрированных оригиналов.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьСнимокПакета(Знач Корень, Знач UUIDПакета)

	Попытка
		Если НЕ DR_Validation.КорректныйUUID(UUIDПакета) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Путь = DR_MobileFiles.ПутьВнутри(Корень, UUIDПакета);
		КаталогПакета = Новый Файл(Путь);
		Если НЕ КаталогПакета.Существует() ИЛИ НЕ КаталогПакета.ЭтоКаталог() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Атрибуты = Новый Соответствие;
		Найденные = НайтиФайлы(Путь, "*", Ложь);
		Если Найденные.Количество() < 2 ИЛИ Найденные.Количество() > 101 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Для Каждого ОбъектПакета Из Найденные Цикл
			Если НЕ ОбъектПакета.ЭтоФайл() ИЛИ ОбъектПакета.ЭтоКаталог() Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если ОбъектПакета.ПолноеИмя <> DR_MobileFiles.ПутьВнутри(Путь, ОбъектПакета.Имя) Тогда
				Возврат Неопределено;
			КонецЕсли;
			Размер = ОбъектПакета.Размер();
			Изменен = ОбъектПакета.ПолучитьУниверсальноеВремяИзменения();
			Если Размер < 1 ИЛИ Размер > 20971520 ИЛИ НЕ ЗначениеЗаполнено(Изменен)
				ИЛИ Изменен >= ТекущаяУниверсальнаяДата() - 2 Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если Атрибуты.Получить(ОбъектПакета.Имя) <> Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Атрибуты.Вставить(ОбъектПакета.Имя, Новый Структура("Размер,Изменен", Размер, Изменен));
		КонецЦикла;
		Возврат Новый Структура("Путь,Файлы", КаталогПакета.ПолноеИмя, Атрибуты);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Процедура ПроверитьОстатокПакета(Знач Путь, Остаток)

	КаталогПакета = Новый Файл(Путь);
	Если НЕ КаталогПакета.Существует() ИЛИ НЕ КаталогПакета.ЭтоКаталог() Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;
	Найденные = НайтиФайлы(Путь, "*", Ложь);
	Если Найденные.Количество() <> Остаток.Количество() Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;
	Для Каждого ОбъектПакета Из Найденные Цикл
		Атрибуты = Остаток.Получить(ОбъектПакета.Имя);
		Если Атрибуты = Неопределено Тогда
			ВызватьИсключение "Package changed";
		КонецЕсли;
		Если НЕ ОбъектПакета.ЭтоФайл() ИЛИ ОбъектПакета.ЭтоКаталог()
			ИЛИ ОбъектПакета.ПолноеИмя <> DR_MobileFiles.ПутьВнутри(Путь, ОбъектПакета.Имя)
			ИЛИ ОбъектПакета.Размер() <> Атрибуты.Размер
			ИЛИ ОбъектПакета.ПолучитьУниверсальноеВремяИзменения() <> Атрибуты.Изменен Тогда
			ВызватьИсключение "Package changed";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьПринятыйПакет(Знач Корень, Пакет, Документ, Снимок, Контекст)

	Если Снимок = Неопределено Тогда
		ВызватьИсключение "Unreliable package attributes";
	КонецЕсли;
	Если НЕ DR_Validation.КорректныйUUID(Пакет.document_id) Тогда
		ВызватьИсключение "Invalid package directory";
	КонецЕсли;

	Путь = DR_MobileFiles.ПутьВнутри(Корень, Пакет.document_id);
	Если Путь <> Снимок.Путь Тогда
		ВызватьИсключение "Package path changed";
	КонецЕсли;
	ПроверитьРазделениеКаталогов(Путь);
	Если Снимок.Файлы.Количество() <> Пакет.files.Количество() + 1 Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;
	Описание = Снимок.Файлы.Получить("document.json");
	Если Описание = Неопределено Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;
	Если Описание.Размер > 32768 Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;
	Для Каждого Оригинал Из Пакет.files Цикл
		Атрибуты = Снимок.Файлы.Получить(Оригинал.filename);
		Если Атрибуты = Неопределено Тогда
			ВызватьИсключение "Package changed";
		КонецЕсли;
		Если Атрибуты.Размер <> Оригинал.size Тогда
			ВызватьИсключение "Package changed";
		КонецЕсли;
	КонецЦикла;
	ПроверитьОстатокПакета(Путь, Снимок.Файлы);

	ТекущийПакет = ПрочитатьОписаниеПакета(Новый ДвоичныеДанные(
		DR_MobileFiles.ПутьВнутри(Путь, "document.json")), Пакет.document_id, Контекст);
	ТекущийДокумент = ПрочитатьФайлыПакета(ТекущийПакет, Путь, Контекст);
	Если ТекущийПакет.token <> Пакет.token
		ИЛИ НЕ DR_MobileStorage.МанифестыРавны(ТекущийДокумент.manifest, Документ.manifest) Тогда
		ВызватьИсключение "Package changed";
	КонецЕсли;

	Для Каждого Оригинал Из Пакет.files Цикл
		ПроверитьОстатокПакета(Путь, Снимок.Файлы);
		УдалитьФайлы(DR_MobileFiles.ПутьВнутри(Путь, Оригинал.filename));
		Снимок.Файлы.Удалить(Оригинал.filename);
	КонецЦикла;
	ПроверитьОстатокПакета(Путь, Снимок.Файлы);
	УдалитьФайлы(DR_MobileFiles.ПутьВнутри(Путь, "document.json"));
	Снимок.Файлы.Удалить("document.json");
	ПроверитьОстатокПакета(Путь, Снимок.Файлы);

	УдалитьФайлы(Путь);
	КаталогПакета = Новый Файл(Путь);
	Если КаталогПакета.Существует() Тогда
		ВызватьИсключение "Package cleanup incomplete";
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьФайлыПакета(Пакет, Каталог, Контекст)

	Если Пакет.files.Количество() < 1 ИЛИ Пакет.files.Количество() > 100 Тогда
		ОтклонитьПакет(Контекст, "Недопустимое количество оригиналов: от 1 до 100.");
	КонецЕсли;
	ФайлыMetadata = Новый Массив;
	Для Каждого Файл Из Пакет.files Цикл
		ПроверитьПоля(Файл, "filename,page_number,size", Контекст);
		Если ТипЗнч(Файл.filename) <> Тип("Строка") ИЛИ ТипЗнч(Файл.size) <> Тип("Число")
			ИЛИ (Пакет.document_type = "image" И ТипЗнч(Файл.page_number) <> Тип("Число"))
			ИЛИ (Пакет.document_type = "pdf" И Файл.page_number <> Неопределено) Тогда
			ОтклонитьПакет(Контекст, "Некорректный тип поля оригинала в document.json.");
		КонецЕсли;
		Если Файл.size <> Цел(Файл.size) ИЛИ Файл.size < 1 ИЛИ Файл.size > 20971520 Тогда
			ОтклонитьПакет(Контекст, "Недопустимый размер оригинала: от 1 до 20 МиБ.");
		КонецЕсли;
		ФайлыMetadata.Добавить(Новый Структура("filename,page_number", Файл.filename, Файл.page_number));
	КонецЦикла;
	МетаданныеПакета = Новый Структура("document_id,document_type,page_count,files",
		Пакет.document_id, Пакет.document_type, Пакет.page_count, ФайлыMetadata);
	JSON = Новый ЗаписьJSON;
	JSON.УстановитьСтроку();
	ЗаписатьJSON(JSON, МетаданныеПакета);

	Попытка
		DR_MobileMultipart.ПрочитатьМетаданные(ПолучитьДвоичныеДанныеИзСтроки(
			JSON.Закрыть(), КодировкаТекста.UTF8, Ложь), Пакет.document_id, Контекст);
	Исключение
		ОтклонитьПакет(Контекст, "Некорректны тип документа, число или порядок страниц либо имена оригиналов.");
	КонецПопытки;
	Источники = Новый Массив;
	МанифестФайлов = Новый Массив;
	Имена = Новый Соответствие;
	Имена.Вставить("document.json", Истина);
	Всего = 0;
	Для Каждого Файл Из Пакет.files Цикл
		Расширение = НРег(СтрРазделить(Файл.filename, ".")[СтрРазделить(Файл.filename, ".").Количество() - 1]);
		Если Пакет.document_type = "image" И Расширение <> "jpg" И Расширение <> "jpeg" И Расширение <> "png" Тогда
			ОтклонитьПакет(Контекст, "Неподдерживаемое расширение оригинала изображения.");
		КонецЕсли;
		ИсходныйФайл = Новый Файл(DR_MobileFiles.ПутьВнутри(Каталог, Файл.filename));
		Если НЕ ИсходныйФайл.Существует() ИЛИ НЕ ИсходныйФайл.ЭтоФайл() Тогда
			ОтклонитьПакет(Контекст, "Отсутствует оригинал документа.");
		КонецЕсли;
		Если ИсходныйФайл.Размер() <> Файл.size Тогда
			ОтклонитьПакет(Контекст, "Фактический размер оригинала не совпадает с document.json.");
		КонецЕсли;
		Всего = Всего + Файл.size;
		Если Всего > 52428800 Тогда
			ОтклонитьПакет(Контекст, "Общий размер оригиналов превышает 50 МиБ.");
		КонецЕсли;
		Источники.Добавить(ИсходныйФайл.ПолноеИмя);
		МанифестФайлов.Добавить(Новый Структура("filename,page_number,size", Файл.filename, Файл.page_number, Файл.size));
		Имена.Вставить(Файл.filename, Истина);
	КонецЦикла;
	Список = НайтиФайлы(Каталог, "*", Ложь);
	Если Список.Количество() <> Пакет.files.Количество() + 1 Тогда
		ОтклонитьПакет(Контекст, "Состав файлов каталога не совпадает с document.json.");
	КонецЕсли;
	Для Каждого Элемент Из Список Цикл
		Если НЕ Элемент.ЭтоФайл() ИЛИ Имена.Получить(Элемент.Имя) = Неопределено Тогда
			ОтклонитьПакет(Контекст, "В пакете обнаружены лишние файлы или вложенные каталоги.");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("document_id,manifest,ИсточникиФайлов", Пакет.document_id,
		Новый Структура("document_type,page_count,files", Пакет.document_type, Пакет.page_count, МанифестФайлов), Источники);

КонецФункции

Процедура ПроверитьПоля(Объект, Поля, Контекст = Неопределено)

	Если ТипЗнч(Объект) <> Тип("Структура") Тогда
		ОтклонитьПакет(Контекст, "Некорректный тип поля: ожидается объект JSON.");
	КонецЕсли;
	Список = СтрРазделить(Поля, ",");
	Для Каждого Имя Из Список Цикл
		Если НЕ Объект.Свойство(Имя) Тогда
			ОтклонитьПакет(Контекст, "Отсутствует обязательное поле в document.json.");
		КонецЕсли;
	КонецЦикла;
	Если Объект.Количество() <> Список.Количество() Тогда
		ОтклонитьПакет(Контекст, "Неизвестное поле в JSON-объекте.");
	КонецЕсли;
	Для Каждого Свойство Из Объект Цикл
		Если Список.Найти(Свойство.Ключ) = Неопределено Тогда
			ОтклонитьПакет(Контекст, "Неизвестное поле в JSON-объекте.");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОтклонитьПакет(Контекст, Сообщение)

	Если Контекст <> Неопределено Тогда
		Контекст.Вставить("ПричинаОшибкиИмпорта", Сообщение);
	КонецЕсли;
	ВызватьИсключение Сообщение;

КонецПроцедуры
