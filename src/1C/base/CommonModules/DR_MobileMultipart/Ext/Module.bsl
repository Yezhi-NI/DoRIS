Функция ПрочитатьЗапрос(Запрос, Контекст) Экспорт

	ДлинаСтрокой = DR_MobileHttp.Заголовок(Запрос, "content-length");
	Если ДлинаСтрокой = "" Тогда
		DR_MobileHttp.Отклонить(Контекст, 411, "content_length_required");
	КонецЕсли;
	Требовать(СтрДлина(ДлинаСтрокой) <= 10, Контекст);
	Для Индекс = 1 По СтрДлина(ДлинаСтрокой) Цикл
		Требовать(СтрНайти("0123456789", Сред(ДлинаСтрокой, Индекс, 1)) > 0, Контекст);
	КонецЦикла;
	Длина = Число(ДлинаСтрокой);
	Требовать(Длина > 0, Контекст);
	ПроверитьЛимит(Длина, 53477376, Контекст);
	Требовать(DR_MobileHttp.Заголовок(Запрос, "transfer-encoding") = "", Контекст);
	Если DR_MobileHttp.Заголовок(Запрос, "content-encoding") <> "" Тогда
		DR_MobileHttp.Отклонить(Контекст, 415, "unsupported_media_type");
	КонецЕсли;
	Идентификатор = DR_MobileHttp.Заголовок(Запрос, "idempotency-key");
	Требовать(DR_Validation.КорректныйUUID(Идентификатор), Контекст);
	Контекст.document_id = Идентификатор;
	ПараметрыТипа = ПараметризованныйЗаголовок(
		DR_MobileHttp.Заголовок(Запрос, "content-type"), Контекст);
	Если ПараметрыТипа.Тип <> "multipart/form-data" Тогда
		DR_MobileHttp.Отклонить(Контекст, 415, "unsupported_media_type");
	КонецЕсли;
	Требовать(ПараметрыТипа.Параметры.Количество() = 1, Контекст);
	Граница = ПараметрыТипа.Параметры.Получить("boundary");
	Требовать(ТипЗнч(Граница) = Тип("Строка"), Контекст);
	Требовать(СтрДлина(Граница) >= 1 И СтрДлина(Граница) <= 70, Контекст);
	Для Индекс = 1 По СтрДлина(Граница) Цикл
		Требовать(СтрНайти("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'()+_,-./:=? ",
			Сред(Граница, Индекс, 1)) > 0, Контекст);
	КонецЦикла;
	Требовать(Прав(Граница, 1) <> " ", Контекст);

	DR_MobileHttp.ЭтапЗамера(Контекст, "body");
	Тело = ПрочитатьОграниченноеТело(Запрос, Длина, Контекст);
	DR_MobileHttp.ЭтапЗамера(Контекст, "multipart");
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(Тело);
	Тело = Неопределено;
	CRLF = Символы.ВК + Символы.ПС;
	Начало = ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Граница + CRLF, КодировкаТекста.UTF8, Ложь);
	Требовать(Совпадает(Буфер, 0, Начало), Контекст);
	Маркер = ПолучитьБуферДвоичныхДанныхИзСтроки(CRLF + "--" + Граница, КодировкаТекста.UTF8, Ложь);
	РазделительЗаголовков = ПолучитьБуферДвоичныхДанныхИзСтроки(CRLF + CRLF, КодировкаТекста.UTF8, Ложь);
	Позиция = Начало.Размер;
	НомерЧасти = 0;
	ОбщийРазмер = 0;
	Л_Метаданные = Неопределено;
	Файлы = Новый Массив;
	ЧастиФайлов = Новый Массив;
	Пока Истина Цикл
		ПроверитьЛимит(НомерЧасти, 100, Контекст);
		КонецЗаголовков = НайтиБайты(Буфер, РазделительЗаголовков, Позиция,
			Мин(Буфер.Размер, Позиция + 8192 + 4), Ложь);
		Требовать(КонецЗаголовков >= 0, Контекст);
		Заголовки = ПрочитатьЗаголовки(Буфер.Прочитать(Позиция, КонецЗаголовков - Позиция), Контекст);
		НачалоДанных = КонецЗаголовков + 4;
		ЛимитЧасти = ?(НомерЧасти = 0, 32768, 20971520);
		КонецДанных = НайтиБайты(Буфер, Маркер, НачалоДанных,
			Мин(Буфер.Размер, НачалоДанных + ЛимитЧасти + Маркер.Размер + 2), Истина);
		Если КонецДанных < 0 Тогда
			Если Буфер.Размер - НачалоДанных > ЛимитЧасти Тогда
				DR_MobileHttp.Отклонить(Контекст, 413, "size_limit_exceeded");
			КонецЕсли;
			Требовать(Ложь, Контекст);
		КонецЕсли;
		РазмерЧасти = КонецДанных - НачалоДанных;
		ПроверитьЛимит(РазмерЧасти, ЛимитЧасти, Контекст);
		Требовать(РазмерЧасти > 0, Контекст);
		Диспозиция = ПараметризованныйЗаголовок(Заголовки.Получить("content-disposition"), Контекст);
		Требовать(Диспозиция.Тип = "form-data", Контекст);
		Если НомерЧасти = 0 Тогда
			Требовать(Диспозиция.Параметры.Количество() = 1
				И Диспозиция.Параметры.Получить("name") = "metadata", Контекст);
			ТипМетаданных = ПараметризованныйЗаголовок(Заголовки.Получить("content-type"), Контекст);
			Требовать(ТипМетаданных.Тип = "application/json", Контекст);
			Кодировка = ТипМетаданных.Параметры.Получить("charset");
			Если Кодировка <> Неопределено Тогда
				Требовать(НРег(Кодировка) = "utf-8", Контекст);
			КонецЕсли;
			ДанныеJSON = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
				Буфер.Прочитать(НачалоДанных, РазмерЧасти));
			DR_MobileHttp.ЭтапЗамера(Контекст, "metadata");
			Л_Метаданные = ПрочитатьМетаданные(ДанныеJSON, Идентификатор, Контекст);
			DR_MobileHttp.ЭтапЗамера(Контекст, "multipart");
		Иначе
			Требовать(Диспозиция.Параметры.Количество() = 2
				И Диспозиция.Параметры.Получить("name") = "files", Контекст);
			Требовать(НомерЧасти <= Л_Метаданные.files.Количество(), Контекст);
			Описание = Л_Метаданные.files[НомерЧасти - 1];
			Требовать(Диспозиция.Параметры.Получить("filename") = Описание.filename, Контекст);
			ОбщийРазмер = ОбщийРазмер + РазмерЧасти;
			ПроверитьЛимит(ОбщийРазмер, 52428800, Контекст);
			MIME = Заголовки.Получить("content-type");
			ПроверитьТипФайла(MIME, Описание.filename, Л_Метаданные.document_type, Контекст);
			Файлы.Добавить(Новый Структура("filename,page_number,size",
				Описание.filename, Описание.page_number, РазмерЧасти));

			ЧастиФайлов.Добавить(Новый Структура("Начало,Размер,MIME",
				НачалоДанных, РазмерЧасти, MIME));
		КонецЕсли;
		НомерЧасти = НомерЧасти + 1;
		Позиция = КонецДанных + Маркер.Размер;
		Если Буфер[Позиция] = 45 И Буфер[Позиция + 1] = 45 Тогда
			Позиция = Позиция + 2;

			Требовать(Позиция + 2 = Буфер.Размер, Контекст);
			Требовать(Буфер[Позиция] = 13 И Буфер[Позиция + 1] = 10, Контекст);
			Прервать;
		КонецЕсли;
		Позиция = Позиция + 2;
	КонецЦикла;
	Требовать(Л_Метаданные <> Неопределено, Контекст);
	Требовать(Файлы.Количество() = Л_Метаданные.files.Количество(), Контекст);
	Возврат Новый Структура("document_id,manifest,Буфер,ЧастиФайлов,Оригиналы", Идентификатор,
		Новый Структура("document_type,page_count,files", Л_Метаданные.document_type, Л_Метаданные.page_count, Файлы),
		Буфер, ЧастиФайлов, Неопределено);

КонецФункции

Процедура ПроверитьТипФайла(MIME, Имя, ТипДокумента, Контекст)

	Расширения = СтрРазделить(Имя, ".");
	Расширение = НРег(Расширения[Расширения.Количество() - 1]);
	Допустим = (ТипДокумента = "pdf" И MIME = "application/pdf" И Имя = "document.pdf")
		ИЛИ (ТипДокумента = "image" И MIME = "image/png" И Расширение = "png")
		ИЛИ (ТипДокумента = "image" И MIME = "image/jpeg"
		И (Расширение = "jpg" ИЛИ Расширение = "jpeg"));
	Если НЕ Допустим Тогда
		DR_MobileHttp.Отклонить(Контекст, 415, "unsupported_media_type");
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьОграниченноеТело(Запрос, ОжидаемаяДлина, Контекст)

	Источник = Запрос.ПолучитьТелоКакПоток();
	Приемник = Новый ПотокВПамяти;
	Попытка
		Порция = Новый БуферДвоичныхДанных(65536);
		Всего = 0;
		Пока Истина Цикл
			Прочитано = Источник.Прочитать(Порция, 0, Порция.Размер);
			Если Прочитано = 0 Тогда
				Прервать;
			КонецЕсли;
			Всего = Всего + Прочитано;
			ПроверитьЛимит(Всего, 53477376, Контекст);
			Требовать(Всего <= ОжидаемаяДлина, Контекст);
			Приемник.Записать(Порция, 0, Прочитано);
		КонецЦикла;
		Требовать(Всего = ОжидаемаяДлина, Контекст);
		Источник.Закрыть();
		Возврат Приемник.ЗакрытьИПолучитьДвоичныеДанные();
	Исключение
		Источник.Закрыть();
		Приемник.Закрыть();
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция Совпадает(Буфер, Позиция, Образец)

	Если Позиция < 0 ИЛИ Позиция + Образец.Размер > Буфер.Размер Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Образец.Размер - 1 Цикл
		Если Буфер[Позиция + Индекс] <> Образец[Индекс] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция НайтиБайты(Буфер, Образец, Начало, Конец, ПроверятьСуффикс)

	Если НЕ ПроверятьСуффикс Тогда
		Возврат НайтиБайтыКМП(Буфер, Образец, Начало, Конец, Ложь);
	КонецЕсли;
	ДлинаОбразца = Образец.Размер;
	Сдвиги = Новый Массив;
	Для Индекс = 0 По 255 Цикл
		Сдвиги.Добавить(ДлинаОбразца);
	КонецЦикла;
	Для Индекс = 0 По ДлинаОбразца - 2 Цикл
		Сдвиги[Образец[Индекс]] = ДлинаОбразца - 1 - Индекс;
	КонецЦикла;
	Позиция = Начало;
	Сравнений = 0;
	Бюджет = Конец - Начало;
	Пока Позиция <= Конец - ДлинаОбразца Цикл
		ПоследнийБайт = Буфер[Позиция + ДлинаОбразца - 1];
		Индекс = ДлинаОбразца - 1;
		Пока Индекс >= 0 Цикл
			Сравнений = Сравнений + 1;
			Если Сравнений > Бюджет Тогда
				Возврат НайтиБайтыКМП(Буфер, Образец, Позиция, Конец, Истина);
			КонецЕсли;
			Байт = ?(Индекс = ДлинаОбразца - 1, ПоследнийБайт, Буфер[Позиция + Индекс]);
			Если Байт <> Образец[Индекс] Тогда
				Прервать;
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Если Индекс < 0 Тогда
			Если КорректныйСуффикс(Буфер, Позиция + ДлинаОбразца - 1) Тогда
				Возврат Позиция;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + Сдвиги[ПоследнийБайт];
	КонецЦикла;
	Возврат -1;

КонецФункции

Функция КорректныйСуффикс(Буфер, Индекс)

	Если Индекс + 2 < Буфер.Размер Тогда
		Если Буфер[Индекс + 1] = 13 И Буфер[Индекс + 2] = 10 Тогда
			Возврат Истина;
		КонецЕсли;
		Если Индекс + 4 < Буфер.Размер Тогда
			Если Буфер[Индекс + 1] = 45 И Буфер[Индекс + 2] = 45
				И Буфер[Индекс + 3] = 13 И Буфер[Индекс + 4] = 10 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция НайтиБайтыКМП(Буфер, Образец, Начало, Конец, ПроверятьСуффикс)

	Префикс = Новый Массив;
	Префикс.Добавить(0);
	Длина = 0;
	Для Индекс = 1 По Образец.Размер - 1 Цикл
		Пока Длина > 0 И Образец[Индекс] <> Образец[Длина] Цикл
			Длина = Префикс[Длина - 1];
		КонецЦикла;
		Если Образец[Индекс] = Образец[Длина] Тогда
			Длина = Длина + 1;
		КонецЕсли;
		Префикс.Добавить(Длина);
	КонецЦикла;
	Длина = 0;
	Для Индекс = Начало По Конец - 1 Цикл
		Байт = Буфер[Индекс];
		Пока Длина > 0 И Байт <> Образец[Длина] Цикл
			Длина = Префикс[Длина - 1];
		КонецЦикла;
		Если Байт = Образец[Длина] Тогда
			Длина = Длина + 1;
		КонецЕсли;
		Если Длина = Образец.Размер Тогда
			Если НЕ ПроверятьСуффикс Тогда
				Возврат Индекс - Длина + 1;
			КонецЕсли;
			Если КорректныйСуффикс(Буфер, Индекс) Тогда
				Возврат Индекс - Длина + 1;
			КонецЕсли;
			Длина = Префикс[Длина - 1];
		КонецЕсли;
	КонецЦикла;
	Возврат -1;

КонецФункции

Функция ПрочитатьЗаголовки(Буфер, Контекст)

	Для Индекс = 0 По Буфер.Размер - 1 Цикл
		Требовать((Буфер[Индекс] >= 32 И Буфер[Индекс] <= 126)
			ИЛИ Буфер[Индекс] = 13 ИЛИ Буфер[Индекс] = 10, Контекст);
	КонецЦикла;
	Текст = ПолучитьСтрокуИзБуфераДвоичныхДанных(Буфер, КодировкаТекста.UTF8);
	Строки = СтрРазделить(Текст, Символы.ПС, Ложь);
	Результат = Новый Соответствие;
	Для Индекс = 0 По Строки.Количество() - 1 Цикл
		СтрокаЗаголовка = Строки[Индекс];
		Если Индекс < Строки.Количество() - 1 Тогда
			Требовать(Прав(СтрокаЗаголовка, 1) = Символы.ВК, Контекст);
			СтрокаЗаголовка = Лев(СтрокаЗаголовка, СтрДлина(СтрокаЗаголовка) - 1);
		КонецЕсли;
		Требовать(СтрНайти(СтрокаЗаголовка, Символы.ВК) = 0, Контекст);
		Двоеточие = СтрНайти(СтрокаЗаголовка, ":");
		Требовать(Двоеточие > 1, Контекст);
		Имя = НРег(Лев(СтрокаЗаголовка, Двоеточие - 1));
		Требовать(Имя = "content-type" ИЛИ Имя = "content-disposition", Контекст);
		Требовать(Результат.Получить(Имя) = Неопределено, Контекст);
		Результат.Вставить(Имя, СокрЛП(Сред(СтрокаЗаголовка, Двоеточие + 1)));
	КонецЦикла;
	Требовать(Результат.Количество() = 2, Контекст);
	Возврат Результат;

КонецФункции

Функция ПараметризованныйЗаголовок(Текст, Контекст)

	Требовать(ТипЗнч(Текст) = Тип("Строка"), Контекст);
	Требовать(СтрДлина(Текст) > 0 И СтрДлина(Текст) <= 8192, Контекст);

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Индекс);
		Требовать(Код >= 32 И Код <= 126, Контекст);
	КонецЦикла;
	Части = СтрРазделить(Текст, ";", Истина);
	Параметры = Новый Соответствие;
	Для Индекс = 1 По Части.Количество() - 1 Цикл
		Часть = СокрЛП(Части[Индекс]);
		Равно = СтрНайти(Часть, "=");
		Требовать(Равно > 1, Контекст);
		Имя = НРег(СокрЛП(Лев(Часть, Равно - 1)));
		Требовать(Параметры.Получить(Имя) = Неопределено, Контекст);
		Значение = СокрЛП(Сред(Часть, Равно + 1));
		Требовать(СтрДлина(Значение) > 0, Контекст);
		Если Лев(Значение, 1) = """" Тогда
			Требовать(СтрДлина(Значение) >= 2 И Прав(Значение, 1) = """", Контекст);
			Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		Иначе

			Для Позиция = 1 По СтрДлина(Значение) Цикл
				Символ = Сред(Значение, Позиция, 1);
				Требовать(СтрНайти(" ()<>@,;:\""/[]?=", Символ) = 0, Контекст);
			КонецЦикла;
		КонецЕсли;
		Требовать(СтрНайти(Значение, """") = 0 И СтрНайти(Значение, "\") = 0, Контекст);
		Параметры.Вставить(Имя, Значение);
	КонецЦикла;
	Возврат Новый Структура("Тип,Параметры", НРег(СокрЛП(Части[0])), Параметры);

КонецФункции

Функция ПрочитатьСтрогийJSON(Данные, Контекст) Экспорт

	Требовать(Данные.Размер() <= 32768, Контекст);
	Попытка
		Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Исключение
		Требовать(Ложь, Контекст);
	КонецПопытки;
	Требовать(СтрДлина(Текст) > 0, Контекст);
	Требовать(КодСимвола(Текст, 1) <> 65279, Контекст);

	Обратно = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
	Требовать(ПолучитьHexСтрокуИзДвоичныхДанных(Данные)
		= ПолучитьHexСтрокуИзДвоичныхДанных(Обратно), Контекст);
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Текст);
		Стек = Новый Массив;
		Корней = 0;
		Токенов = 0;
		Пока Чтение.Прочитать() Цикл
			Токенов = Токенов + 1;
			Требовать(Токенов <= 2000, Контекст);
			ТипУзла = Чтение.ТипТекущегоЗначения;
			Если Стек.Количество() = 0 Тогда
				Корней = Корней + 1;
				Требовать(Корней = 1 И ТипУзла = ТипЗначенияJSON.НачалоОбъекта, Контекст);
			КонецЕсли;
			Если ТипУзла = ТипЗначенияJSON.НачалоОбъекта ИЛИ ТипУзла = ТипЗначенияJSON.НачалоМассива Тогда
				Стек.Добавить(Новый Соответствие);
				Требовать(Стек.Количество() <= 8, Контекст);
			ИначеЕсли ТипУзла = ТипЗначенияJSON.КонецОбъекта ИЛИ ТипУзла = ТипЗначенияJSON.КонецМассива Тогда
				Стек.Удалить(Стек.Количество() - 1);
			ИначеЕсли ТипУзла = ТипЗначенияJSON.ИмяСвойства Тогда
				Имена = Стек[Стек.Количество() - 1];
				Имя = Чтение.ТекущееЗначение;
				Требовать(Имена.Получить(Имя) = Неопределено, Контекст);
				Имена.Вставить(Имя, Истина);
			ИначеЕсли ТипУзла = ТипЗначенияJSON.Комментарий Тогда
				Требовать(Ложь, Контекст);
			КонецЕсли;
		КонецЦикла;
		Требовать(Корней = 1 И Стек.Количество() = 0, Контекст);
		Чтение.Закрыть();
		Чтение.УстановитьСтроку(Текст);
		Результат = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		Чтение.Закрыть();
		Требовать(Ложь, Контекст);
	КонецПопытки;
	Возврат Результат;

КонецФункции

Функция ПрочитатьМетаданные(Данные, Идентификатор, Контекст) Экспорт

	Результат = ПрочитатьСтрогийJSON(Данные, Контекст);
	ПроверитьПоля(Результат, "document_id,document_type,page_count,files", Контекст);
	Требовать(Результат.document_id = Идентификатор, Контекст);
	Требовать(Результат.document_type = "image" ИЛИ Результат.document_type = "pdf", Контекст);
	Требовать(ТипЗнч(Результат.page_count) = Тип("Число"), Контекст);
	Требовать(Результат.page_count >= 1 И Цел(Результат.page_count) = Результат.page_count, Контекст);
	Требовать(ТипЗнч(Результат.files) = Тип("Массив"), Контекст);
	Требовать(Результат.files.Количество() >= 1, Контекст);
	ПроверитьЛимит(Результат.files.Количество(), 100, Контекст);
	ПроверитьЛимит(Результат.page_count, ?(Результат.document_type = "pdf", 1000, 100), Контекст);
	Если Результат.document_type = "pdf" Тогда
		Требовать(Результат.files.Количество() = 1, Контекст);
	Иначе
		Требовать(Результат.page_count = Результат.files.Количество(), Контекст);
	КонецЕсли;
	Имена = Новый Соответствие;
	Для Индекс = 0 По Результат.files.Количество() - 1 Цикл
		Файл = Результат.files[Индекс];
		ПроверитьПоля(Файл, "filename,page_number", Контекст);
		Требовать(ТипЗнч(Файл.filename) = Тип("Строка"), Контекст);
		Требовать(СтрДлина(Файл.filename) >= 1 И СтрДлина(Файл.filename) <= 128, Контекст);
		Требовать(Лев(Файл.filename, 1) <> ".", Контекст);
		Для Позиция = 1 По СтрДлина(Файл.filename) Цикл
			Требовать(СтрНайти("0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_-.",
				Сред(Файл.filename, Позиция, 1)) > 0, Контекст);
		КонецЦикла;
		Требовать(Имена.Получить(Файл.filename) = Неопределено, Контекст);
		Имена.Вставить(Файл.filename, Истина);
		Если Результат.document_type = "pdf" Тогда
			Требовать(Файл.filename = "document.pdf" И Файл.page_number = Неопределено, Контекст);
		Иначе
			Требовать(ТипЗнч(Файл.page_number) = Тип("Число"), Контекст);
			Требовать(Файл.page_number = Индекс + 1, Контекст);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьПоля(Объект, Поля, Контекст)

	Требовать(ТипЗнч(Объект) = Тип("Структура"), Контекст);
	Список = СтрРазделить(Поля, ",");
	Требовать(Объект.Количество() = Список.Количество(), Контекст);
	Для Каждого Пара Из Объект Цикл
		Требовать(Список.Найти(Пара.Ключ) <> Неопределено, Контекст);
	КонецЦикла;
	Для Каждого Имя Из Список Цикл
		Требовать(Объект.Свойство(Имя), Контекст);
	КонецЦикла;

КонецПроцедуры

Процедура Требовать(Условие, Контекст)

	Если НЕ Условие Тогда
		DR_MobileHttp.Отклонить(Контекст, 400, "invalid_request");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЛимит(Размер, Лимит, Контекст)

	Если Размер > Лимит Тогда
		DR_MobileHttp.Отклонить(Контекст, 413, "size_limit_exceeded");
	КонецЕсли;

КонецПроцедуры
