Функция Обработать(РезультатOCR, Диагностика = Неопределено) Экспорт

	DR_Validation.ПроверитьТипСтруктура(РезультатOCR, "РезультатOCR");

	Попытка

		Если РезультатOCR.Статус = DR_Settings.СтатусыРаспознавания().Ошибка Тогда
			Возврат СоздатьРезультатОшибки(РезультатOCR.Ошибка);
		КонецЕсли;

		Если РезультатOCR.ТипОтвета = DR_Settings.ТипыОтветовOCR().PaddleOCR Тогда
			Возврат РазобратьОтвет(РезультатOCR);
		ИначеЕсли РезультатOCR.ТипОтвета = DR_Settings.ТипыОтветовOCR().MistralOCR Тогда
			Возврат РазобратьОтвет(РезультатOCR);
		  КонецЕсли;

		Возврат СоздатьРезультатОшибки("Неизвестный тип OCR-провайдера.");

	Исключение

		Возврат СоздатьРезультатОшибки(ОписаниеОшибки());

	КонецПопытки;

КонецФункции 

Функция РазобратьОтвет(РезультатOCR)
	
	Если РезультатOCR.МассивДокументов = Неопределено ИЛИ 
		НЕ ТипЗнч(РезультатOCR.МассивДокументов) = Тип("Массив") Тогда
	   	Возврат СоздатьРезультатОшибки("Markdown отсутствует.");
   	КонецЕсли;
	
	Документ = DR_DocumentFactory.СоздатьСтруктуруДокумент();
	
	Для Каждого ДокументOCR ИЗ РезультатOCR.МассивДокументов Цикл
		Документ.МассивСтрок = ДокументOCR.СтрокиДокумента;

		Если ДокументOCR.ТаблицыТоваров = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		ДокументДляРазбора = ДокументOCR;
		Если РезультатOCR.ТипОтвета = DR_Settings.ТипыОтветовOCR().PaddleOCR Тогда
			ДокументДляРазбора = ПодготовитьТаблицыPaddleOCR(ДокументOCR);
		КонецЕсли;
		РазобратьДокументOCR(ДокументДляРазбора, Документ);

	КонецЦикла;

	Возврат СоздатьРезультатДокумента(Документ, РезультатOCR.JSONОтвет);

КонецФункции

Процедура РазобратьДокументOCR(ДокументOCR, Документ)
	
	//пока только Документ---
	Документ.ТипОбъекта = "Документ";
	//-----------------------
	
	ТаблицаТоваров = РазобратьТаблицыТоваров(ДокументOCR);
	ЗаполнитьТабличнуюЧасть(ТаблицаТоваров, Документ);
	
КонецПроцедуры 

Процедура ЗаполнитьТабличнуюЧасть(ТаблицаТоваров, Документ)
	
	Для Каждого СтрокаТоваров ИЗ ТаблицаТоваров Цикл
			
		НоваяСтрока = Документ.ТабличнаяЧасть.Добавить();
	    ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТоваров);
        Для Каждого ИмяЧисловойКолонки Из СтрРазделить("Количество,Цена,Сумма,СуммаНДС,СуммаБезНДС", ",") Цикл
            НоваяСтрока[ИмяЧисловойКолонки] = ПрочитатьЧислоOCR(НоваяСтрока[ИмяЧисловойКолонки]);
        КонецЦикла;

	КонецЦикла;
 

КонецПроцедуры 

Функция ПодготовитьТаблицыPaddleOCR(ДокументOCR)
	
	Таблицы = Новый Массив;
    Схема = Новый Массив;
    ИсходныеТаблицы = ДокументOCR.ТаблицыТоваров;
    ДваКоличества = Ложь;
    СхемаЧисел = Новый Массив;
    Для Каждого Таблица Из ИсходныеТаблицы Цикл
        ПодготовленнаяТаблица = Новый Массив;
        Для Каждого СтрокаТаблицы Из Таблица Цикл
            СхемаЗаголовка = СхемаПоЗаголовкам(СтрокаТаблицы);
            Если СхемаЗаголовка.Количество() > 0 Тогда
                Схема = СхемаЗаголовка;
                ДваКоличества = ЭтоДваКоличестваPaddleOCR(СтрокаТаблицы);
            ИначеЕсли ЭтоСлужебнаяСтрокаPaddleOCR(СтрокаТаблицы, Схема) Тогда
                Продолжить;
            КонецЕсли;
            ПодготовленнаяСтрока = Новый Массив;
            Для Каждого Ячейка Из СтрокаТаблицы Цикл ПодготовленнаяСтрока.Добавить(Ячейка); КонецЦикла;
            Если ДваКоличества Тогда
                Если СхемаЗаголовка.Количество() > 0 Тогда
                    ПодготовленнаяСтрока.Вставить(4, "Ед.");
                ИначеЕсли ЭтоРаздельныеДваКоличестваPaddleOCR(СтрокаТаблицы) И СтрокаТаблицы.Количество() = 7 Тогда
                    // Основной суммы в строке нет. Только пустая позиция схемы,
                    // никакое значение из вторичного количества/цены не копируется.
                    ПодготовленнаяСтрока.Добавить("");
                КонецЕсли;
            КонецЕсли;
            Если СхемаЗаголовка.Количество() > 0 Тогда
                СхемаЧисел = СхемаПоЗаголовкам(ПодготовленнаяСтрока);
            ИначеЕсли СхемаЧисел.Количество() > 0 Тогда
                Индексы = ФизическиеКолонкиСтроки(ПодготовленнаяСтрока, СхемаЧисел);
                Если Индексы <> Неопределено Тогда
                    Для ФизическийИндекс = 0 По Индексы.Количество() - 1 Цикл
                        Имя = СхемаЧисел[Индексы[ФизическийИндекс]].Имя;
                        Если Найти(",Цена,СуммаБезСкидки,Скидка,Сумма,СуммаНДС,", "," + Имя + ",") > 0 Тогда
                            ПодготовленнаяСтрока[ФизическийИндекс] = НормализоватьЧислоPaddleOCR(ПодготовленнаяСтрока[ФизическийИндекс]);
                        КонецЕсли;
                    КонецЦикла;
                КонецЕсли;
            КонецЕсли;
            ПодготовленнаяТаблица.Добавить(ПодготовленнаяСтрока);
        КонецЦикла;
        Таблицы.Добавить(ПодготовленнаяТаблица);
    КонецЦикла;
    Возврат Новый Структура("СтрокиДокумента,ТаблицыТоваров", ДокументOCR.СтрокиДокумента, Таблицы);   
	
КонецФункции

Функция НормализоватьЧислоPaddleOCR(Значение)
	
	// Только полная US-запись с группами по три цифры: 2,850.00.
    // Одна запятая и неверная группировка не переосмысливаются.
    Текст = СокрЛП(Значение);
    Если Лев(Текст, 1) = "+" Или Лев(Текст, 1) = "-" Тогда Текст = Сред(Текст, 2); КонецЕсли;
    Части = СтрРазделить(Текст, ".", Ложь);
    Если Части.Количество() <> 2 Тогда Возврат Значение; КонецЕсли;
    Если ПустаяСтрока(Части[1]) Тогда Возврат Значение; КонецЕсли;
    Группы = СтрРазделить(Части[0], ",", Ложь);
    Если Группы.Количество() < 2 Тогда Возврат Значение; КонецЕсли;
    Если СтрДлина(Группы[0]) < 1 Или СтрДлина(Группы[0]) > 3 Тогда Возврат Значение; КонецЕсли;
    Для Индекс = 1 По Группы.Количество() - 1 Цикл
        Если СтрДлина(Группы[Индекс]) <> 3 Тогда Возврат Значение; КонецЕсли;
    КонецЦикла;
    ВсеЦифры = СтрСоединить(Группы, "") + Части[1];
    Для Индекс = 1 По СтрДлина(ВсеЦифры) Цикл
        Если Найти("0123456789", Сред(ВсеЦифры, Индекс, 1)) = 0 Тогда Возврат Значение; КонецЕсли;
    КонецЦикла;
    Возврат СтрЗаменить(Значение, ",", "");   
	
КонецФункции

Функция ЭтоДваКоличестваPaddleOCR(Заголовки)
	
	Если Заголовки.Количество() <> 7 Тогда Возврат Ложь; КонецЕсли;
    Имена = Новый Массив;
    Для Каждого Заголовок Из Заголовки Цикл Имена.Добавить(ЛогическоеИмяКолонкиOCR(Заголовок)); КонецЦикла;
    Возврат СтрСоединить(Имена, ",") = "НомерСтроки,,Номенклатура,Количество,Количество,Цена,Сумма"
        И Найти(НормализоватьИмяКолонкиOCR(Заголовки[3]), "упаковок") > 0
        И Найти(НормализоватьИмяКолонкиOCR(Заголовки[4]), "едизм") > 0;  
		
КонецФункции

Функция ЭтоРаздельныеДваКоличестваPaddleOCR(Ячейки)
	
	Если Ячейки.Количество() <> 7 И Ячейки.Количество() <> 8 Тогда Возврат Ложь; КонецЕсли;
    Возврат ПрочитатьЧислоOCR(Ячейки[3]) <> Неопределено
        И ЭтоТекстоваяЕдиницаOCR(СтрЗаменить(Ячейки[4], " ", ""))
        И ПрочитатьЧислоOCR(ПолучитьЧисловуюЧасть(Ячейки[5])) <> Неопределено
        И (ПрочитатьЧислоOCR(Ячейки[6]) <> Неопределено Или ПустаяСтрока(Ячейки[6]));   
		
КонецФункции

Функция ЭтоСлужебнаяСтрокаPaddleOCR(СтрокаТаблицы, Схема)
	
	Если Схема.Количество() > 0 Тогда
        Если ЭтоСлужебнаяСтрокаТаблицы(СтрокаТаблицы, Схема) Тогда Возврат Истина; КонецЕсли;
        ИндексНомера = ИндексКолонкиСхемы(Схема, "НомерСтроки");
        Если ИндексНомера >= 0 И ИндексНомера < СтрокаТаблицы.Количество() Тогда
            Если ПрочитатьЧислоOCR(СтрокаТаблицы[ИндексНомера]) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
        КонецЕсли;
        ИндексКоличества = ИндексКолонкиСхемы(Схема, "Количество");
        ИндексЦены = ИндексКолонкиСхемы(Схема, "Цена");
        Если ИндексКоличества < СтрокаТаблицы.Количество() И ИндексЦены < СтрокаТаблицы.Количество() Тогда
            Если ПрочитатьЧислоOCR(ПолучитьЧисловуюЧасть(СтрокаТаблицы[ИндексКоличества])) <> Неопределено
                И ПрочитатьЧислоOCR(СтрокаТаблицы[ИндексЦены]) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
        КонецЕсли;
    КонецЕсли;
    Метка = "";
    Для Каждого Ячейка Из СтрокаТаблицы Цикл
        Если Не ПустаяСтрока(Ячейка) Тогда Метка = СокрЛП(Ячейка); Прервать; КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(Метка) Тогда Возврат Истина; КонецЕсли;
    Позиция = Найти(Метка, ":");
    Если Позиция = 0 Тогда Возврат Ложь; КонецЕсли;
    ИмяМетки = НормализоватьИмяКолонкиOCR(Лев(Метка, Позиция - 1));
    Если ИмяМетки <> "итого" И ИмяМетки <> "всего" И ИмяМетки <> "ндс" И ИмяМетки <> "втомчислендс" Тогда Возврат Ложь; КонецЕсли;
    Если ПрочитатьЧислоOCR(Сред(Метка, Позиция + 1)) = Неопределено Тогда Возврат Ложь; КонецЕсли;
    Для Каждого Ячейка Из СтрокаТаблицы Цикл
        Если Не ПустаяСтрока(Ячейка) И СокрЛП(Ячейка) <> Метка
            И ПрочитатьЧислоOCR(Ячейка) = Неопределено Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;   
	
КонецФункции

#Область Таблицы

Функция РазобратьТаблицыТоваров(ДокументOCR)

    Результат = Новый Массив;
    Если ДокументOCR.ТаблицыТоваров.Количество() = 0 Тогда
        Возврат Результат;
    КонецЕсли;
    СхемаКолонок = СоздатьСхемуКолонок(ДокументOCR);
    Если СхемаКолонок.Количество() = 0 Тогда
        ВызватьИсключение "Заголовок первой HTML-таблицы не распознан; товарные строки не разобраны.";
    КонецЕсли;
    ТекущаяСхема = СхемаКолонок;
    Для ИндексТаблицы = 0 По ДокументOCR.ТаблицыТоваров.Количество() - 1 Цикл
        ТаблицаТоваров = ДокументOCR.ТаблицыТоваров[ИндексТаблицы];
        ЕстьЗаголовок = НайтиЗаголовокТаблицы(ТаблицаТоваров) >= 0;
        ВариантСхемы = ОпределитьВариантСхемыТаблицы(ТаблицаТоваров, ТекущаяСхема, ЕстьЗаголовок);
        Для ИндексСтроки = 0 По ТаблицаТоваров.Количество() - 1 Цикл
            ИсходнаяСтрока = ТаблицаТоваров[ИндексСтроки];
            СхемаЗаголовка = СхемаПоЗаголовкам(ИсходнаяСтрока);
            Если СхемаЗаголовка.Количество() > 0 Тогда
                ТекущаяСхема = СхемаЗаголовка;
                Продолжить;
            КонецЕсли;
            Если ИндексТаблицы = 0 И ИндексСтроки < НайтиЗаголовокТаблицы(ТаблицаТоваров) Тогда
                Продолжить;
            КонецЕсли;
            Если ЭтоСлужебнаяСтрокаТаблицы(ИсходнаяСтрока, ТекущаяСхема) Тогда
                Продолжить;
            КонецЕсли;
            ВариантСхемы = ОпределитьВариантСхемыСтроки(ИсходнаяСтрока, ТекущаяСхема);
            Если ВариантСхемы = "НесовместимаяСхема" Тогда
                // Ошибка не должна молча давать смещённые товарные значения.
                ВызватьИсключение "Неподдерживаемая схема HTML-таблицы " + Строка(ИндексТаблицы + 1)
                    + ", строка " + Строка(ИндексСтроки + 1) + ".";
            КонецЕсли;
            Строка = РазобратьСтрокуПоСхеме(ИсходнаяСтрока, ТекущаяСхема, ВариантСхемы);
            Строка = ПривестиСтрокуКСхеме(Строка, ТекущаяСхема, СхемаКолонок);
            ИндексТовара = ИндексКолонкиСхемы(СхемаКолонок, "Номенклатура");
            Если Строка[ИндексТовара] = Неопределено Или ПустаяСтрока(Строка[ИндексТовара]) Тогда
                Продолжить;
            КонецЕсли;
            Результат.Добавить(Строка);
        КонецЦикла;
    КонецЦикла;
    Возврат СоздатьТаблицуТоваров(Результат, СхемаКолонок);

КонецФункции

Функция СоздатьТаблицуТоваров(МассивСтрокТоваров, СхемаКолонок)

    ТаблицаТоваров = Новый ТаблицаЗначений;
    Если МассивСтрокТоваров.Количество() = 0 Тогда
        Возврат ТаблицаТоваров;
    КонецЕсли;
    Для Каждого Колонка Из СхемаКолонок Цикл
        Если Колонка.Имя <> "" Тогда
            ТаблицаТоваров.Колонки.Добавить(Колонка.Имя, , Колонка.Имя);
        КонецЕсли;
    КонецЦикла;
    Для Каждого СтрокаТоваров Из МассивСтрокТоваров Цикл
        НоваяСтрока = ТаблицаТоваров.Добавить();
        Для ИндексКолонки = 0 По СхемаКолонок.Количество() - 1 Цикл
            ИмяКолонки = СхемаКолонок[ИндексКолонки].Имя;
            Если ИмяКолонки <> "" Тогда
                НоваяСтрока[ИмяКолонки] = СтрокаТоваров[ИндексКолонки];
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;

    Возврат ТаблицаТоваров;

КонецФункции

Функция РазобратьСтрокуПоСхеме(СтрокаТаблицы, СхемаКолонок, ВариантСхемы)

    Результат = Новый Массив;
    Для Каждого Колонка Из СхемаКолонок Цикл
        Результат.Добавить(Неопределено);
    КонецЦикла;
    Если ВариантСхемы = "НесовместимаяСхема" Тогда
        Возврат Результат;
    КонецЕсли;
    Индексы = ФизическиеКолонкиСтроки(СтрокаТаблицы, СхемаКолонок);
    Для ФизическийИндекс = 0 По Индексы.Количество() - 1 Цикл
        ИндексКолонки = Индексы[ФизическийИндекс];
        ИмяКолонки = СхемаКолонок[ИндексКолонки].Имя;
        Если ИмяКолонки = "" Тогда Продолжить; КонецЕсли;
        Значение = СокрЛП(СтрокаТаблицы[ФизическийИндекс]);
        Если ИмяКолонки = "Количество" Тогда
            Результат[ИндексКолонки] = ПрочитатьЧислоOCR(ПолучитьЧисловуюЧасть(Значение));
            Единица = ПолучитьСтроковуюЧасть(Значение);
            Если Не ПустаяСтрока(Единица) Тогда
                ИндексЕдиницы = ИндексКолонкиСхемы(СхемаКолонок, "ДобЕдИзм");
                Результат[ИндексЕдиницы] = Единица;
            КонецЕсли;
        ИначеЕсли ЭтоЧисловаяКолонкаOCR(ИмяКолонки) Тогда
            Результат[ИндексКолонки] = ПрочитатьЧислоOCR(Значение);
        ИначеЕсли ИмяКолонки = "ДобЕдИзм" И ПустаяСтрока(Значение)
            И Результат[ИндексКолонки] <> Неопределено Тогда
            // Пустая отдельная ячейка не стирает единицу из объединённого количества.
            Продолжить;
        Иначе
            Результат[ИндексКолонки] = Значение;
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;

КонецФункции

Функция СоздатьСхемуКолонок(ДокументOCR)

    СхемаКолонок = Новый Массив;
    Если ДокументOCR.ТаблицыТоваров.Количество() = 0 Тогда Возврат СхемаКолонок; КонецЕсли;
    ПерваяТаблица = ДокументOCR.ТаблицыТоваров[0];
    ИндексЗаголовка = НайтиЗаголовокТаблицы(ПерваяТаблица);
    Если ИндексЗаголовка < 0 Тогда Возврат СхемаКолонок; КонецЕсли;
    Заголовки = ПерваяТаблица[ИндексЗаголовка];
    СхемаКолонок = СхемаПоЗаголовкам(Заголовки);
    Возврат СхемаКолонок;

КонецФункции

Функция НормализоватьИмяКолонкиOCR(Знач Значение)

    Значение = НРег(СокрЛП(Значение));
    Для Каждого УдаляемыйСимвол Из СтрРазделить(" |.|-|(|)", "|", Ложь) Цикл
        Значение = СтрЗаменить(Значение, УдаляемыйСимвол, "");
    КонецЦикла;
    Значение = СтрЗаменить(Значение, Символы.ПС, "");
    Значение = СтрЗаменить(Значение, Символы.ВК, "");
    Значение = СтрЗаменить(Значение, Символы.Таб, "");
    Значение = СтрЗаменить(Значение, Символ(160), "");
    Возврат СтрЗаменить(Значение, Символ(8239), "");

КонецФункции

Функция ЛогическоеИмяКолонкиOCR(Значение)

    Имя = НормализоватьИмяКолонкиOCR(Значение);
    Если Имя = "№" Или Имя = "n" Или Имя = "номер" Или Имя = "номерстроки" Тогда Возврат "НомерСтроки"; КонецЕсли;
    Если Найти(Имя, "товар") > 0 Или Найти(Имя, "наименование") > 0 Или Имя = "номенклатура" Тогда Возврат "Номенклатура"; КонецЕсли;
    Если Найти(Имя, "колич") > 0 Или Имя = "колво" Тогда Возврат "Количество"; КонецЕсли;
    Если Имя = "еи" Или Имя = "ед" Или Имя = "едизм" Или Имя = "единицаизмерения" Тогда Возврат "ДобЕдИзм"; КонецЕсли;
    Если Имя = "цена" Или Имя = "ценазаединицу" Тогда Возврат "Цена"; КонецЕсли;
    Если Найти(Имя, "суммабезскидки") > 0 Тогда Возврат "СуммаБезСкидки"; КонецЕсли;
    Если Найти(Имя, "скидк") > 0 Или Найти(Имя, "наценк") > 0 Тогда Возврат "Скидка"; КонецЕсли;
    Если Имя = "сумма" Или Имя = "стоимость" Или Имя = "всего" Или Имя = "суммасндс" Тогда Возврат "Сумма"; КонецЕсли;
    Если Имя = "ндс" Или Имя = "суммандс" Тогда Возврат "СуммаНДС"; КонецЕсли;
    Возврат "";

КонецФункции

Функция СхемаПоЗаголовкам(Заголовки)

    Схема = Новый Массив;
    Количества = Новый Массив;
    Упаковки = Новый Массив;
    ЕдИзм = Новый Массив;
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
        Имя = ЛогическоеИмяКолонкиOCR(Заголовки[Индекс]);
        Колонка = Новый Структура("Имя,ИмяДополнительнойКолонки,Расширяемая,Виртуальная", Имя, "", Имя = "Количество", Ложь);
        Схема.Добавить(Колонка);
        Если Имя = "Количество" Тогда
            Количества.Добавить(Индекс);
            ИмяЗаголовка = НормализоватьИмяКолонкиOCR(Заголовки[Индекс]);
            Если Найти(ИмяЗаголовка, "упаковок") > 0 Тогда Упаковки.Добавить(Индекс); КонецЕсли;
            Если Найти(ИмяЗаголовка, "едизм") > 0 Тогда ЕдИзм.Добавить(Индекс); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Количества.Количество() = 2 Тогда
        Если Упаковки.Количество() = 1 И ЕдИзм.Количество() = 1 Тогда
            Схема[ЕдИзм[0]].Имя = "";
            Схема[ЕдИзм[0]].Расширяемая = Ложь;
        ИначеЕсли Количества[1] = Количества[0] + 1
            И СокрЛП(Заголовки[Количества[0]]) = СокрЛП(Заголовки[Количества[1]]) Тогда
            Схема[Количества[1]].Имя = "ДобЕдИзм";
            Схема[Количества[1]].Расширяемая = Ложь;
        КонецЕсли;
    КонецЕсли;
    Для Каждого ОбязательноеИмя Из СтрРазделить("Номенклатура,Количество,Цена", ",") Цикл
        Если ЧислоКолонокСхемы(Схема, ОбязательноеИмя) <> 1 Тогда Возврат Новый Массив; КонецЕсли;
    КонецЦикла;
    Если ЧислоКолонокСхемы(Схема, "Сумма") > 1 Тогда Возврат Новый Массив; КонецЕсли;
    Если ИндексКолонкиСхемы(Схема, "Сумма") < 0 И ЧислоКолонокСхемы(Схема, "СуммаБезСкидки") <> 1 Тогда Возврат Новый Массив; КонецЕсли;
    ИндексЕдиницы = ИндексКолонкиСхемы(Схема, "ДобЕдИзм");
    Если ИндексЕдиницы >= 0 Тогда
        Если ИндексЕдиницы <> ИндексКолонкиСхемы(Схема, "Количество") + 1 Тогда Возврат Новый Массив; КонецЕсли;
    Иначе
        // Отдельное место результата, а не дополнительная физическая ячейка.
        Схема.Добавить(Новый Структура("Имя,ИмяДополнительнойКолонки,Расширяемая,Виртуальная", "ДобЕдИзм", "", Ложь, Истина));
    КонецЕсли;
    Возврат Схема;

КонецФункции

Функция ЧислоКолонокСхемы(Схема, Имя)
	
	Результат = 0;
    Для Каждого Колонка Из Схема Цикл
        Если Колонка.Имя = Имя Тогда Результат = Результат + 1; КонецЕсли;
    КонецЦикла;
    Возврат Результат;  
	
КонецФункции

Функция ИндексКолонкиСхемы(Схема, Имя)
	
	Для Индекс = 0 По Схема.Количество() - 1 Цикл
        Если Схема[Индекс].Имя = Имя Тогда Возврат Индекс; КонецЕсли;
    КонецЦикла;
    Возврат -1;   
	
КонецФункции

Функция НайтиЗаголовокТаблицы(Таблица)
	
	Для Индекс = 0 По Таблица.Количество() - 1 Цикл
        Если СхемаПоЗаголовкам(Таблица[Индекс]).Количество() > 0 Тогда Возврат Индекс; КонецЕсли;
    КонецЦикла;
    Возврат -1;   
	
КонецФункции

Функция ФизическиеКолонкиСтроки(СтрокаТаблицы, Схема)

    Индексы = Новый Массив;
    Для Индекс = 0 По Схема.Количество() - 1 Цикл
        Если Не Схема[Индекс].Виртуальная Тогда Индексы.Добавить(Индекс); КонецЕсли;
    КонецЦикла;
    ИндексКоличества = ИндексКолонкиСхемы(Схема, "Количество");
    ФизКоличество = Индексы.Найти(ИндексКоличества);
    Если ФизКоличество >= СтрокаТаблицы.Количество() Тогда Возврат Неопределено; КонецЕсли;
    Значение = СокрЛП(СтрокаТаблицы[ФизКоличество]);
    Если Не ПустаяСтрока(Значение) И ПрочитатьЧислоOCR(ПолучитьЧисловуюЧасть(Значение)) = Неопределено Тогда Возврат Неопределено; КонецЕсли;
    Раздельное = Ложь;
    Если ПустаяСтрока(ПолучитьСтроковуюЧасть(Значение)) И ФизКоличество + 1 < СтрокаТаблицы.Количество() Тогда
        Раздельное = ЭтоТекстоваяЕдиницаOCR(СтрокаТаблицы[ФизКоличество + 1]);
    КонецЕсли;
    ИндексЕдиницы = ИндексКолонкиСхемы(Схема, "ДобЕдИзм");
    Если Раздельное И Схема[ИндексЕдиницы].Виртуальная Тогда
        Индексы.Вставить(ФизКоличество + 1, ИндексЕдиницы);
    ИначеЕсли Не Раздельное И Не Схема[ИндексЕдиницы].Виртуальная
        И СтрокаТаблицы.Количество() = Индексы.Количество() - 1 Тогда
        Индексы.Удалить(Индексы.Найти(ИндексЕдиницы));
    КонецЕсли;
    Если СтрокаТаблицы.Количество() <> Индексы.Количество() Тогда
        Имена = Новый Массив;
        Для Каждого Индекс Из Индексы Цикл Имена.Добавить(Схема[Индекс].Имя); КонецЦикла;
        Если Раздельное И СтрокаТаблицы.Количество() = 7
            И СтрСоединить(Имена, ",") = "НомерСтроки,Номенклатура,Количество,ДобЕдИзм,Цена,СуммаБезСкидки,Скидка,Сумма" Тогда
            Индексы.Удалить(6);
        Иначе
            Возврат Неопределено;
        КонецЕсли;
    КонецЕсли;
    Возврат Индексы;

КонецФункции

Функция ОпределитьВариантСхемыСтроки(СтрокаТаблицы, СхемаКолонок)
	
	Индексы = ФизическиеКолонкиСтроки(СтрокаТаблицы, СхемаКолонок);
    Если Индексы = Неопределено Тогда Возврат "НесовместимаяСхема"; КонецЕсли;
    ИндексЕдиницы = ИндексКолонкиСхемы(СхемаКолонок, "ДобЕдИзм");
    Если Индексы.Найти(ИндексЕдиницы) <> Неопределено Тогда Возврат "ЛогическаяСхема"; КонецЕсли;
    Возврат "ОбъединеннаяСхема";  
	
КонецФункции

Функция ПривестиСтрокуКСхеме(Строка, СхемаСтроки, СхемаРезультата)
	
	Результат = Новый Массив;
    Для Каждого Колонка Из СхемаРезультата Цикл
        Индекс = ИндексКолонкиСхемы(СхемаСтроки, Колонка.Имя);
        Если Колонка.Имя <> "" И Индекс >= 0 Тогда
            Результат.Добавить(Строка[Индекс]);
        Иначе
            Результат.Добавить(Неопределено);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;  
	
КонецФункции

Функция ПолучитьКоличествоФизическихКолонок(ТаблицаТоваров, ЕстьЗаголовок)
	
	ИндексСтроки = 0;
    Если ЕстьЗаголовок Тогда ИндексСтроки = НайтиЗаголовокТаблицы(ТаблицаТоваров) + 1; КонецЕсли;
    Если ИндексСтроки >= ТаблицаТоваров.Количество() Тогда Возврат 0; КонецЕсли;
    Возврат ТаблицаТоваров[ИндексСтроки].Количество();   
	
КонецФункции

Функция ОпределитьВариантСхемыТаблицы(ТаблицаТоваров, СхемаКолонок, ЕстьЗаголовок)

    ИндексСтроки = 0;
    Если ЕстьЗаголовок Тогда ИндексСтроки = НайтиЗаголовокТаблицы(ТаблицаТоваров) + 1; КонецЕсли;
    Если ИндексСтроки >= ТаблицаТоваров.Количество() Тогда Возврат "НесовместимаяСхема"; КонецЕсли;
    Возврат ОпределитьВариантСхемыСтроки(ТаблицаТоваров[ИндексСтроки], СхемаКолонок);

КонецФункции

Функция ЭтоТекстоваяЕдиницаOCR(Знач Значение)
	
	Значение = СокрЛП(Значение);
    Если Прав(Значение, 1) = "." Тогда Значение = Лев(Значение, СтрДлина(Значение) - 1); КонецЕсли;
    Если ПустаяСтрока(Значение) Тогда Возврат Ложь; КонецЕсли;
    Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя%/";
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Если Найти(Допустимые, Сред(Значение, Индекс, 1)) = 0 Тогда Возврат Ложь; КонецЕсли;
    КонецЦикла;
    Возврат Истина;  
	
КонецФункции

Функция ЭтоСлужебнаяСтрокаТаблицы(СтрокаТаблицы, Схема)
	
	ПервыйТекст = "";
    Для Каждого Ячейка Из СтрокаТаблицы Цикл
        Если Не ПустаяСтрока(Ячейка) Тогда ПервыйТекст = Ячейка; Прервать; КонецЕсли;
    КонецЦикла;
    Если ПустаяСтрока(ПервыйТекст) Тогда Возврат Истина; КонецЕсли;
    ИндексНомера = ИндексКолонкиСхемы(Схема, "НомерСтроки");
    Если ИндексНомера >= 0 И ИндексНомера < СтрокаТаблицы.Количество() Тогда
        Если ПрочитатьЧислоOCR(СтрокаТаблицы[ИндексНомера]) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
    КонецЕсли;
    ИндексКоличества = ИндексКолонкиСхемы(Схема, "Количество");
    ИндексЦены = ИндексКолонкиСхемы(Схема, "Цена");
    Если ИндексКоличества < СтрокаТаблицы.Количество() И ИндексЦены < СтрокаТаблицы.Количество() Тогда
        Если ПрочитатьЧислоOCR(ПолучитьЧисловуюЧасть(СтрокаТаблицы[ИндексКоличества])) <> Неопределено
            И ПрочитатьЧислоOCR(СтрокаТаблицы[ИндексЦены]) <> Неопределено Тогда Возврат Ложь; КонецЕсли;
    КонецЕсли;
    Метка = НормализоватьИмяКолонкиOCR(СтрЗаменить(ПервыйТекст, ":", ""));
    Если Метка = "итого" Или Метка = "всего" Или Метка = "итогокоплате" Или Метка = "всегокоплате" Тогда Возврат Истина; КонецЕсли;
    Если Лев(Метка, 9) = "втомчисле" Тогда Метка = Сред(Метка, 10); КонецЕсли;
    Если Лев(Метка, 3) = "втч" Тогда Метка = Сред(Метка, 4); КонецЕсли;
    Если Метка = "ндс" Тогда Возврат Истина; КонецЕсли;
    Если Лев(Метка, 3) = "ндс" И Прав(Метка, 1) = "%" Тогда
        Возврат ПрочитатьЧислоOCR(Сред(Метка, 4, СтрДлина(Метка) - 4)) <> Неопределено;
    КонецЕсли;
    Возврат Ложь; 
	
КонецФункции

Функция ЭтоЧисловаяКолонкаOCR(Имя) 
	
    Возврат Найти(",НомерСтроки,Количество,Цена,Сумма,СуммаНДС,СуммаБезСкидки,Скидка,", "," + Имя + ",") > 0; 
	
КонецФункции

Функция ПрочитатьЧислоOCR(Знач Значение)
	
	Если ТипЗнч(Значение) = Тип("Число") Тогда Возврат Значение; КонецЕсли;
    Если Значение = Неопределено Тогда Возврат Неопределено; КонецЕсли;
    Текст = СокрЛП(Строка(Значение));
    Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), Символ(160), ""), Символ(8239), "");
    Текст = СтрЗаменить(Текст, ",", ".");
    Разделителей = 0;
    Цифр = 0;
    Для Индекс = 1 По СтрДлина(Текст) Цикл
        Знак = Сред(Текст, Индекс, 1);
        Если Найти("0123456789", Знак) > 0 Тогда
            Цифр = Цифр + 1;
        ИначеЕсли Знак = "." Тогда
            Разделителей = Разделителей + 1;
        ИначеЕсли Не (Индекс = 1 И (Знак = "+" Или Знак = "-")) Тогда
            Возврат Неопределено;
        КонецЕсли;
    КонецЦикла;
    Если Цифр = 0 Или Разделителей > 1 Тогда Возврат Неопределено; КонецЕсли;
    Попытка
        Возврат Число(Текст);
    Исключение
        Возврат Неопределено;
	КонецПопытки;   
	
КонецФункции

#КонецОбласти


#Область Служебные 

Функция ЭтоТипДокумента(СтрокаMarkdown)

	Возврат
		Найти(НРег(СтрокаMarkdown), "поступление товаров") > 0 
		Или Найти(НРег(СтрокаMarkdown), "поступление тмз") > 0
		Или Найти(НРег(СтрокаMarkdown), "реализация товаров") > 0
		Или Найти(НРег(СтрокаMarkdown), "реализация тмз") > 0
		Или Найти(НРег(СтрокаMarkdown), "приходная накладная") > 0
		Или Найти(НРег(СтрокаMarkdown), "расходная накладная") > 0;

КонецФункции

Функция ЭтоРеквизит(СтрокаMarkdown)

	Возврат Найти(СтрокаMarkdown, ":") > 0;

КонецФункции

Процедура ОпределитьТипДокумента(Документ, СтрокаMarkdown)

	Строка = НРег(СтрокаMarkdown);
	
	Если Найти(Строка, "поступление") > 0 
		ИЛИ Найти(Строка, "приходная") Тогда
		Документ.ТипДокумента = "Поступление";
	ИначеЕсли Найти(Строка, "реализация") > 0 
		ИЛИ Найти(Строка, "расходная") 
		Тогда
		Документ.ТипДокумента = "Реализация";
	КонецЕсли;

	Документ.ТипОбъекта = "Документ";

КонецПроцедуры

Процедура ЗаполнитьДатуНомерДокумента(Документ, СтрокаMarkdown)
	
	СтрокаСДатой = ПривестиДату(СтрокаMarkdown);
    Документ.РеквизитыДокумента.ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаСДатой);
	Документ.РеквизитыДокумента.НомерДокумента = НайтиНомерДокумента(НРег(СтрокаMarkdown));
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитДокумента(Документ, СтрокаMarkdown)
	
	Позиция = Найти(СтрокаMarkdown, ":");

	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	ИмяРеквизита = НРег(СокрЛП(Лев(СтрокаMarkdown, Позиция - 1)));
	Значение = СокрЛП(Сред(СтрокаMarkdown, Позиция + 1));

	Соответствия = DR_DocumentFactory.СоответствиеРеквизитовДокумента();

	Если Соответствия.Получить(ИмяРеквизита) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Документ.ТипДокумента = "Поступление" И ИмяРеквизита = "покупатель" Тогда
		ИмяПоля = Соответствия.Получить("организация");
	ИначеЕсли Документ.ТипДокумента = "Поступление" И ИмяРеквизита = "поставщик" Тогда
		ИмяПоля = Соответствия.Получить("поставщик");	
	ИначеЕсли Документ.ТипДокумента = "Реализация" И ИмяРеквизита = "поставщик" Тогда
		ИмяПоля = Соответствия.Получить("организация");
	ИначеЕсли Документ.ТипДокумента = "Реализация" И ИмяРеквизита = "покупатель" Тогда
		ИмяПоля = Соответствия.Получить("покупатель");
	Иначе
		ИмяПоля = Соответствия.Получить(ИмяРеквизита);	
	КонецЕсли;
	
	Если ТипЗнч(Документ.РеквизитыДокумента[ИмяПоля]) = Тип("Число") Тогда
		Значение = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Значение);
	КонецЕсли;
	
	Документ.РеквизитыДокумента.Вставить(ИмяПоля, Значение);
	
КонецПроцедуры 

Функция НайтиСПозиции(Строка, ИскомаяСтрока, Позиция)

	Если Позиция > СтрДлина(Строка) Тогда
		Возврат 0;
	КонецЕсли;

	Фрагмент = Сред(Строка, Позиция);
	НайденнаяПозиция = Найти(Фрагмент, ИскомаяСтрока);

	Если НайденнаяПозиция = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Возврат Позиция + НайденнаяПозиция - 1;

КонецФункции

Функция ПривестиДату(Знач СтрокаСДатой)

	
	Месяца = Новый Массив;
	Месяца.Добавить("января"); 
	Месяца.Добавить("февраля");
    Месяца.Добавить("марта");
	Месяца.Добавить("апреля");
	Месяца.Добавить("мая");
	Месяца.Добавить("июня");
	Месяца.Добавить("июля");
	Месяца.Добавить("августа");
	Месяца.Добавить("сентября");
	Месяца.Добавить("октября");
	Месяца.Добавить("ноября");
	Месяца.Добавить("декабря");
   
	Для Каждого Месяц Из Месяца Цикл
    	Если СтрНайти(НРег(СтрокаСДатой), Месяц) > 0 Тогда
    		НомерМесяца = Формат(Месяца.Найти(Месяц) + 1, "ЧЦ=2; ЧВН=; ЧГ=0");
        	СтрокаСДатой = СтрЗаменить(НРег(СтрокаСДатой), " " + Месяц + " ", "." + Строка(НомерМесяца) + "."); 
    Прервать;
    	КонецЕсли;
    КонецЦикла;

	Символ = Найти(НРег(СтрокаСДатой),"от");
	СтрокаСДатой = (СокрЛП(Сред(СтрокаСДатой, Символ + 2, СтрДлина(СтрокаСДатой) - Символ)));
	
	Возврат СтрокаСДатой;
	
КонецФункции 

Функция НайтиНомерДокумента(Знач СтрокаСНомером)
	
	СимволыНомер = Найти(СтрокаСНомером, "№");
	СимволыОТ = Найти(СтрокаСНомером, "от");
	СтрокаДата = (СокрЛП(Сред(СтрокаСНомером, СимволыНомер + 1, СимволыОТ - СимволыНомер - 1)));
	
	Возврат СтрокаДата;
	
КонецФункции

Функция ПолучитьСтроковуюЧасть(Знач СтрокаЗначение)
	
	СтрокаЗначение = СокрЛП(СтрокаЗначение);
    Возврат СокрЛП(Сред(СтрокаЗначение, ДлинаЧисловогоПрефиксаOCR(СтрокаЗначение) + 1));   
	
КонецФункции

Функция ПолучитьЧисловуюЧасть(Знач СтрокаСЧислом)
	
	СтрокаСЧислом = СокрЛП(СтрокаСЧислом);
    Результат = Лев(СтрокаСЧислом, ДлинаЧисловогоПрефиксаOCR(СтрокаСЧислом));
    Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Результат, " ", ""), Символ(160), ""), Символ(8239), "");   
	
КонецФункции

Функция ДлинаЧисловогоПрефиксаOCR(Значение)
	
	Длина = 0;
    Для Индекс = 1 По СтрДлина(Значение) Цикл
        Знак = Сред(Значение, Индекс, 1);
        Код = КодСимвола(Знак);
        Если Найти("0123456789., ", Знак) > 0 Или Код = 160 Или Код = 8239
            Или (Индекс = 1 И (Знак = "+" Или Знак = "-")) Тогда
            Длина = Индекс;
        Иначе
            Прервать;
        КонецЕсли;
    КонецЦикла;
    Возврат Длина;  
	
КонецФункции


Функция ПроверитьПоследнийСимволВСтроке(Знач СтрокаЗначение)
	
	КодСимвола = КодСимвола(Прав(СокрЛП(СтрокаЗначение),1));

	Если КодСимвола < 48 ИЛИ КодСимвола > 57 Тогда
    	Возврат Истина
	КонецЕсли;
	Возврат Ложь; 
	
КонецФункции

Функция СоздатьРезультатДокумента(Документ, JSON)

	Результат = Новый Структура;

	Результат.Вставить("Document", Документ);
	Результат.Вставить("Markdown", "");
	Результат.Вставить("JSON", JSON);
	Результат.Вставить("Ошибка", "");

	Возврат Результат;

КонецФункции

Функция СоздатьРезультатОшибки(ТекстОшибки)

	Результат = Новый Структура;

	Результат.Вставить("Document", Неопределено);
	Результат.Вставить("Markdown", "");
	Результат.Вставить("JSON", "");
	Результат.Вставить("Ошибка", ТекстОшибки);

	Возврат Результат;

КонецФункции

