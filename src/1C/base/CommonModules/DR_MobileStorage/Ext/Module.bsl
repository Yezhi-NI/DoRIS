Функция Зарегистрировать(Документ, Контекст) Экспорт

	Владелец = Контекст.ИдентификаторПользователяИБ;

	Если НЕ DR_Validation.КорректныйUUID(Документ.document_id)
		ИЛИ НЕ DR_Validation.КорректныйUUID(Владелец) Тогда
		DR_MobileHttp.Отклонить(Контекст, 400, "invalid_request");
	КонецЕсли;
	Повтор = ПроверитьПовтор(Документ, Контекст);
	Если Повтор <> Неопределено Тогда
		Возврат Новый Структура("Код,Квитанция", 200, Повтор);
	КонецЕсли;
	Стадия = DR_MobileFiles.ПодготовитьФайловоеХранилище(Документ, Контекст);
	Попытка
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Ключ = Блокировка.Добавить("РегистрСведений.DR_ПринятыеМобильныеДокументы");
			Ключ.Режим = РежимБлокировкиДанных.Исключительный;
			Ключ.УстановитьЗначение("ИдентификаторПользователя", Владелец);
			Ключ.УстановитьЗначение("UUIDДокумента", Документ.document_id);
			Попытка
				Блокировка.Заблокировать();
			Исключение
				DR_MobileHttp.Отклонить(Контекст, 503, "temporarily_unavailable");
			КонецПопытки;
			ПроверитьДоступРегистрации(Контекст);
			Квитанция = ПроверитьПовтор(Документ, Контекст);
			Если Квитанция <> Неопределено Тогда
				Код = 200;
			Иначе
				Запись = РегистрыСведений.DR_ПринятыеМобильныеДокументы.СоздатьМенеджерЗаписи();
				Запись.ИдентификаторПользователя = Владелец;
				Запись.UUIDДокумента = Документ.document_id;
				Запись.ТипДокумента = Документ.manifest.document_type;
				Запись.КоличествоСтраниц = Документ.manifest.page_count;
				Запись.Манифест = Новый ХранилищеЗначения(Документ.manifest);

				Запись.КаталогОригиналов = DR_MobileFiles.ОпубликоватьОригиналы(Стадия, Контекст);
				Запись.UUIDПользователяИБ = Новый УникальныйИдентификатор(Владелец);
				Запись.Состояние = Перечисления.DR_СостоянияМобильныхДокументов.Принят;
				Запись.ИсточникПриема = ?(ИсточникПриема(Контекст) = "Папка",
					Перечисления.DR_ИсточникиПриемаМобильныхДокументов.Папка,
					Перечисления.DR_ИсточникиПриемаМобильныхДокументов.HTTP);
				ДатаПриема = ТекущаяДатаСеанса();
				ДатаПриемаUTC = ТекущаяУниверсальнаяДата();
				Запись.ДатаПриема = ДатаПриема;
				Запись.ДатаПриемаUTC = ДатаПриемаUTC;
				Запись.ИдентификаторКвитанции = НРег(Строка(Новый УникальныйИдентификатор));
				Запись.Записать();
				Квитанция = КвитанцияИзЗаписи(Запись, "accepted");
				Код = 201;
			КонецЕсли;
			DR_MobileHttp.ЭтапЗамера(Контекст, "commit");
			ЗафиксироватьТранзакцию();
		Исключение
			Попытка
				ОтменитьТранзакцию();
			Исключение

				Код = 500;
			КонецПопытки;
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		DR_MobileFiles.ОчиститьСобственныйВременныйКаталог(Стадия);
		ВызватьИсключение;
	КонецПопытки;
	DR_MobileFiles.ОчиститьСобственныйВременныйКаталог(Стадия);
	Возврат Новый Структура("Код,Квитанция", Код, Квитанция);

КонецФункции

Функция ИсточникПриема(Контекст)

	Источник = "HTTP";
	Если НЕ Контекст.Свойство("ИсточникПриема", Источник) Тогда
		Источник = "HTTP";
	КонецЕсли;
	Если Источник <> "HTTP" И Источник <> "Папка" Тогда
		DR_MobileHttp.Отклонить(Контекст, 400, "invalid_request");
	КонецЕсли;
	Возврат Источник;

КонецФункции

Процедура ПроверитьДоступРегистрации(Контекст)

	Если ИсточникПриема(Контекст) = "HTTP" Тогда
		DR_MobileHttp.ПроверитьДоступ(Контекст);
	Иначе

		Подтверждение = DR_MobileSettings.АвторизоватьФайловыйТокен(Контекст.ФайловыйТокен);
		Если Подтверждение.ИдентификаторПользователяИБ <> Контекст.ИдентификаторПользователяИБ Тогда
			DR_MobileHttp.Отклонить(Контекст, 403, "mobile_access_denied");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОригинал(ИдентификаторПользователяИБ, UUIDДокумента, ИмяФайла) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователяИБ, UUIDДокумента);
	Возврат ПрочитатьЗарегистрированныйОригинал(ИдентификаторПользователяИБ, UUIDДокумента, ИмяФайла);

КонецФункции

Функция ПрочитатьЗарегистрированныйОригинал(ИдентификаторПользователяИБ, UUIDДокумента, ИмяФайла, ПроверятьВладельца = Ложь)

	Если НЕ DR_Validation.КорректныйUUID(ИдентификаторПользователяИБ)
		ИЛИ НЕ DR_Validation.КорректныйUUID(UUIDДокумента) Тогда
		ВызватьИсключение "Недопустимый идентификатор документа.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ КаталогОригиналов, Манифест
        |ИЗ РегистрСведений.DR_ПринятыеМобильныеДокументы
        |ГДЕ ИдентификаторПользователя = &Владелец И UUIDДокумента = &UUID";
	Запрос.УстановитьПараметр("Владелец", ИдентификаторПользователяИБ);
	Запрос.УстановитьПараметр("UUID", UUIDДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "Документ не зарегистрирован.";
	КонецЕсли;
	Если ПустаяСтрока(Выборка.КаталогОригиналов) Тогда
		ВызватьИсключение "Оригиналы документа недоступны.";
	КонецЕсли;
	Манифест = Выборка.Манифест.Получить();
	Для Каждого Описание Из Манифест.files Цикл
		Если Описание.filename <> ИмяФайла Тогда
			Продолжить;
		КонецЕсли;
		ФайлДанных = Новый Файл(DR_MobileFiles.ПутьВнутри(Выборка.КаталогОригиналов, ИмяФайла));
		Если НЕ ФайлДанных.Существует() ИЛИ НЕ ФайлДанных.ЭтоФайл() Тогда
			ВызватьИсключение "Оригинал документа отсутствует в серверном хранилище.";
		КонецЕсли;
		Если ПроверятьВладельца Тогда
			ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователяИБ, UUIDДокумента);
		КонецЕсли;
		Возврат Новый ДвоичныеДанные(ФайлДанных.ПолноеИмя);
	КонецЦикла;
	ВызватьИсключение "Файл не принадлежит документу.";

КонецФункции

Функция ПроверитьПовтор(Документ, Контекст) Экспорт

	Квитанция = ПолучитьКвитанцию(Контекст, Документ.document_id);
	Если Квитанция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НЕ МанифестыРавны(Квитанция.manifest, Документ.manifest) Тогда
		DR_MobileHttp.Отклонить(Контекст, 409, "uuid_content_conflict");
	КонецЕсли;
	Квитанция.status = "duplicate";
	Возврат Квитанция;

КонецФункции

Функция ПолучитьКвитанцию(Контекст, Идентификатор) Экспорт

	Владелец = Контекст.ИдентификаторПользователяИБ;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ UUIDДокумента, ИдентификаторКвитанции, ДатаПриемаUTC, Манифест
        |ИЗ РегистрСведений.DR_ПринятыеМобильныеДокументы
        |ГДЕ ИдентификаторПользователя = &Владелец И UUIDДокумента = &UUID";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("UUID", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КвитанцияИзЗаписи(Выборка, "accepted");

КонецФункции

Функция КвитанцияИзЗаписи(Запись, Статус)

	Если НЕ ЗначениеЗаполнено(Запись.ДатаПриемаUTC) Тогда
		ВызватьИсключение "Reception UTC time is not set";
	КонецЕсли;
	ДатаСтрокой = Формат(Запись.ДатаПриемаUTC, "ДФ=yyyy-MM-dd") + "T"
		+ Формат(Запись.ДатаПриемаUTC, "ДФ=HH:mm:ss") + "Z";
	Возврат Новый Структура("accepted,document_id,status,transaction_id,received_at,manifest",
		Истина, Запись.UUIDДокумента, Статус, Запись.ИдентификаторКвитанции,
		ДатаСтрокой, МанифестДляОтвета(Запись.Манифест.Получить()));

КонецФункции

Функция МанифестыРавны(Первый, Второй) Экспорт

	Если Первый.document_type <> Второй.document_type
		ИЛИ Первый.page_count <> Второй.page_count
		ИЛИ Первый.files.Количество() <> Второй.files.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 0 По Первый.files.Количество() - 1 Цикл
		А = Первый.files[Индекс];
		Б = Второй.files[Индекс];
		Если А.filename <> Б.filename ИЛИ А.page_number <> Б.page_number
			ИЛИ А.size <> Б.size Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция МанифестДляОтвета(Манифест)

	Файлы = Новый Массив;
	Для Каждого Файл Из Манифест.files Цикл
		Файлы.Добавить(Новый Структура("filename,page_number,size",
			Файл.filename, Файл.page_number, Файл.size));
	КонецЦикла;
	Возврат Новый Структура("document_type,page_count,files",
		Манифест.document_type, Манифест.page_count, Файлы);

КонецФункции

#Область ИнтерактивнаяОбработка

Функция КонтекстОбработкиМобильныхДокументов() Экспорт

	Если НЕ ПравоДоступа("Использование", Метаданные.Обработки.DR_РаспознаваниеДокументов) Тогда
		ВызватьИсключение "Недостаточно прав для обработки мобильных документов.";
	КонецЕсли;
	Пользователь = Пользователи.ТекущийПользователь();
	ПользовательИБ = DR_MobileSettings.ПолучитьПользователяИБ(Пользователь);
	ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийИБ = Неопределено Тогда
		ВызватьИсключение "Не определён пользователь сеанса.";
	КонецЕсли;
	Если ПользовательИБ.УникальныйИдентификатор <> ТекущийИБ.УникальныйИдентификатор Тогда
		ВызватьИсключение "Неоднозначное соответствие пользователя сеанса.";
	КонецЕсли;
	Возврат Новый Структура("Пользователь,Владелец,Администратор", Пользователь,
		НРег(Строка(ТекущийИБ.УникальныйИдентификатор)), Ложь);

КонецФункции

Процедура ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента) Экспорт

	Контекст = КонтекстОбработкиМобильныхДокументов();
	Если НЕ DR_Validation.КорректныйUUID(ИдентификаторПользователя)
		ИЛИ НЕ DR_Validation.КорректныйUUID(UUIDДокумента) Тогда
		ВызватьИсключение "Некорректный ключ мобильного документа.";
	КонецЕсли;
	Если ИдентификаторПользователя <> Контекст.Владелец Тогда
		ВызватьИсключение "Нет доступа к мобильному документу другого пользователя.";
	КонецЕсли;

КонецПроцедуры

Функция ЗаписьМобильногоДокументаДляИзменения(ИдентификаторПользователя, UUIDДокумента)

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Блокировка = Новый БлокировкаДанных;
	Ключ = Блокировка.Добавить("РегистрСведений.DR_ПринятыеМобильныеДокументы");
	Ключ.Режим = РежимБлокировкиДанных.Исключительный;
	Ключ.УстановитьЗначение("ИдентификаторПользователя", ИдентификаторПользователя);
	Ключ.УстановитьЗначение("UUIDДокумента", UUIDДокумента);
	Блокировка.Заблокировать();
	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Возврат ПрочитатьЗаписьМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента);

КонецФункции

Функция ПрочитатьЗаписьМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента)

	Запись = РегистрыСведений.DR_ПринятыеМобильныеДокументы.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторПользователя = ИдентификаторПользователя;
	Запись.UUIDДокумента = UUIDДокумента;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда
		ВызватьИсключение "Мобильный документ отсутствует или недоступен.";
	КонецЕсли;
	Возврат Запись;

КонецФункции

Процедура СохранитьКонтрагентаМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента, Контрагент) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		ВызватьИсключение "Требуется ссылка на контрагента.";
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Справочник.Контрагенты ГДЕ Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", Контрагент);
		Если Запрос.Выполнить().Пустой() Тогда
			ВызватьИсключение "Контрагент недоступен.";
		КонецЕсли;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Запись = ЗаписьМобильногоДокументаДляИзменения(ИдентификаторПользователя, UUIDДокумента);
		Запись.Контрагент = Контрагент;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьДокументМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента, Документ1С) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	ПроверитьДоступностьПоступления(Документ1С);
	НачатьТранзакцию();
	Попытка
		Запись = ЗаписьМобильногоДокументаДляИзменения(ИдентификаторПользователя, UUIDДокумента);

		ПроверитьДоступностьПоступления(Документ1С);
		Запись.Документ1С = Документ1С;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ПроверитьДоступностьПоступления(Ссылка)

	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ВызватьИсключение "Требуется ссылка на поступление ТМЗ и услуг.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос("ВЫБРАТЬ Ссылка ИЗ Документ.ПоступлениеТоваровУслуг ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Поступление не записано или недоступно.";
	КонецЕсли;

КонецПроцедуры

Функция СвязанныйДокументМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Запись = ПрочитатьЗаписьМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента);
	ПроверитьДоступностьПоступления(Запись.Документ1С);
	Возврат Запись.Документ1С;

КонецФункции

Функция ОписаниеПервогоОригиналаДляOCR(Манифест)

	Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
		ВызватьИсключение "Манифест оригиналов недоступен.";
	КонецЕсли;
	Если ТипЗнч(Манифест.files) <> Тип("Массив") Тогда
		ВызватьИсключение "Некорректный список оригиналов.";
	КонецЕсли;
	Количество = Манифест.files.Количество();
	Если Манифест.document_type = "image" Тогда
		Если Количество < 1 ИЛИ Количество > 2 Тогда
			ВызватьИсключение "Для OCR требуется одно или два изображения.";
		КонецЕсли;
	ИначеЕсли Манифест.document_type = "pdf" Тогда
		Если Количество <> 1 Тогда
			ВызватьИсключение "Для PDF требуется один оригинал.";
		КонецЕсли;
	Иначе
		ВызватьИсключение "Тип оригинала не поддерживается.";
	КонецЕсли;
	Имя = Манифест.files[0].filename;
	Части = СтрРазделить(Имя, ".");
	Расширение = НРег(Части[Части.Количество() - 1]);
	Если (Манифест.document_type = "image" И Расширение <> "jpg" И Расширение <> "jpeg" И Расширение <> "png")
		ИЛИ (Манифест.document_type = "pdf" И Расширение <> "pdf") Тогда
		ВызватьИсключение "Неподдерживаемое расширение оригинала.";
	КонецЕсли;
	Возврат Новый Структура("ИмяФайла,ТипФайла", Имя, Расширение);

КонецФункции

Функция ПолучитьОригиналДляРаспознавания(ИдентификаторПользователя, UUIDДокумента) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Запись = ПрочитатьЗаписьМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента);
	Описание = ОписаниеПервогоОригиналаДляOCR(Запись.Манифест.Получить());
	Описание.Вставить("ДвоичныеДанные", ПрочитатьЗарегистрированныйОригинал(
		ИдентификаторПользователя, UUIDДокумента, Описание.ИмяФайла, Истина));
	Возврат Описание;

КонецФункции

Функция НачатьРаспознаваниеМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента, ПодтвержденПовтор) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение "Распознавание нельзя начинать внутри другой транзакции.";
	КонецЕсли;
	DR_Validation.ПроверитьТипБулево(ПодтвержденПовтор, "ПодтвержденПовтор");
	Ключ = РегистрыСведений.DR_ПринятыеМобильныеДокументы.СоздатьКлючЗаписи(
		Новый Структура("ИдентификаторПользователя,UUIDДокумента", ИдентификаторПользователя, UUIDДокумента));
	ЗаблокироватьДанныеДляРедактирования(Ключ);
	Попытка
		НачатьТранзакцию();
		Попытка
			Запись = ЗаписьМобильногоДокументаДляИзменения(ИдентификаторПользователя, UUIDДокумента);
			ПредыдущееСостояние = Запись.Состояние;
			НуженПовтор = ПредыдущееСостояние = Перечисления.DR_СостоянияМобильныхДокументов.Распознается И НЕ ПодтвержденПовтор;
			Если НЕ НуженПовтор Тогда
				Запись.Состояние = Перечисления.DR_СостоянияМобильныхДокументов.Распознается;
				Запись.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	Исключение
		РазблокироватьДанныеДляРедактирования(Ключ);
		ВызватьИсключение;
	КонецПопытки;
	Если НуженПовтор Тогда
		РазблокироватьДанныеДляРедактирования(Ключ);
	КонецЕсли;
	Возврат Новый Структура("НуженПовтор,КлючРедактирования,ПредыдущееСостояние", НуженПовтор, Ключ, ПредыдущееСостояние);

КонецФункции

Процедура ЗавершитьРаспознаваниеМобильногоДокумента(ИдентификаторПользователя, UUIDДокумента, Состояние) Экспорт

	ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
	Если ТипЗнч(Состояние) <> Тип("ПеречислениеСсылка.DR_СостоянияМобильныхДокументов") Тогда
		ВызватьИсключение "Некорректное состояние распознавания.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Запись = ЗаписьМобильногоДокументаДляИзменения(ИдентификаторПользователя, UUIDДокумента);
		Если Запись.Состояние <> Перечисления.DR_СостоянияМобильныхДокументов.Распознается Тогда
			ВызватьИсключение "Состояние документа изменено другим действием.";
		КонецЕсли;
		Запись.Состояние = Состояние;
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
