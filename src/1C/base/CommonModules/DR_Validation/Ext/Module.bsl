Процедура ПроверитьТипСтрока(Значение, ИмяПараметра) Экспорт

    ПроверитьТип(Значение, Тип("Строка"), ИмяПараметра);

КонецПроцедуры

Процедура ПроверитьЗаполненнуюСтроку(Значение, ИмяПараметра) Экспорт
	
	ПроверитьТипСтрока(Значение, ИмяПараметра);
    ПроверитьЗаполнено(СокрЛП(Значение), ИмяПараметра);  
	
КонецПроцедуры

Процедура ПроверитьСвойствоСтруктуры(Значение, ИмяСвойства, ИмяПараметра) Экспорт
	
	ПроверитьТипСтруктура(Значение, ИмяПараметра);
    Если НЕ Значение.Свойство(ИмяСвойства) Тогда
        ВызватьИсключение "Отсутствует обязательное свойство структуры.";
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПроверитьПоложительноеЧисло(Значение, ИмяПараметра) Экспорт
	
	ПроверитьТипЧисло(Значение, ИмяПараметра);
    Если Значение <= 0 Тогда
        ВызватьИсключение "Ожидалось положительное число.";
	КонецЕсли; 
	
КонецПроцедуры

Функция КорректныйUUID(Значение) Экспорт
	
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Ложь;
    КонецЕсли;
    Если СтрДлина(Значение) <> 36
        ИЛИ Значение = "00000000-0000-0000-0000-000000000000" Тогда
        Возврат Ложь;
    КонецЕсли;
    Для Позиция = 1 По 36 Цикл
        Символ = Сред(Значение, Позиция, 1);
        Если Позиция = 9 ИЛИ Позиция = 14 ИЛИ Позиция = 19 ИЛИ Позиция = 24 Тогда
            Если Символ <> "-" Тогда Возврат Ложь; КонецЕсли;
        ИначеЕсли СтрНайти("0123456789abcdef", Символ) = 0 Тогда
            Возврат Ложь;
        КонецЕсли;
    КонецЦикла;
    Возврат Истина; 
	
КонецФункции

Процедура ПроверитьТипСтруктура(Значение, ИмяПараметра) Экспорт

    ПроверитьТип( Значение, Тип("Структура"), ИмяПараметра);

КонецПроцедуры

Процедура ПроверитьТипМассив(Значение, ИмяПараметра) Экспорт

    ПроверитьТип( Значение, Тип("Массив"), ИмяПараметра);

КонецПроцедуры

Процедура ПроверитьТипБулево(Значение, ИмяПараметра) Экспорт

    ПроверитьТип( Значение, Тип("Булево"), ИмяПараметра);

КонецПроцедуры

Процедура ПроверитьТипЧисло(Значение, ИмяПараметра) Экспорт

    Если Не ТипЗнч(Значение) = Тип("Число") Тогда

        ВызватьИсключение( СтрШаблон("Параметр '%1' должен иметь тип Число.", ИмяПараметра));

    КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЗаполнено(Значение, ИмяПараметра) Экспорт

    Если Не ЗначениеЗаполнено(Значение) Тогда

        ВызватьИсключение(СтрШаблон("Параметр '%1' не заполнен.", ИмяПараметра));

    КонецЕсли;

КонецПроцедуры

Процедура ВызватьИсключениеОшибки(ОписаниеОшибки) Экспорт

    ВызватьИсключение ОписаниеОшибки;

КонецПроцедуры

Процедура ПроверитьТип(Значение, ОжидаемыйТип, ИмяПараметра)

    Если ТипЗнч(Значение) <> ОжидаемыйТип Тогда

        ВызватьИсключение( СтрШаблон( "Параметр '%1' имеет неверный тип.", ИмяПараметра));

    КонецЕсли;

КонецПроцедуры   

