Процедура ПодготовитьОригиналы(Документ, Контекст) Экспорт

	Оригиналы = Новый Массив;
	Для Каждого Часть Из Документ.ЧастиФайлов Цикл

		Если Часть.Размер <= 0 Тогда
			DR_MobileHttp.Отклонить(Контекст, 400, "invalid_request");
		КонецЕсли;
		Если Часть.Размер > 20971520 Тогда
			DR_MobileHttp.Отклонить(Контекст, 413, "size_limit_exceeded");
		КонецЕсли;
		Оригиналы.Добавить(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
			Документ.Буфер.Прочитать(Часть.Начало, Часть.Размер)));
	КонецЦикла;
	Документ.Оригиналы = Оригиналы;
	Документ.Буфер = Неопределено;
	Документ.ЧастиФайлов = Неопределено;

КонецПроцедуры

Функция ПроверитьСерверныйКаталог(Знач Путь) Экспорт

	ПроверитьАбсолютныйСерверныйПуть(Путь);
	Каталог = Новый Файл(Путь);
	Если НЕ Каталог.Существует() ИЛИ НЕ Каталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Каталог недоступен серверу 1С.";
	КонецЕсли;
	Возврат Каталог.ПолноеИмя;

КонецФункции

Процедура ПроверитьАбсолютныйСерверныйПуть(Знач Путь)

	Если ТипЗнч(Путь) <> Тип("Строка") ИЛИ ПустаяСтрока(Путь) Тогда
		ВызватьИсключение "Серверный каталог не задан.";
	КонецЕсли;
	ПутьUNC = Лев(Путь, 2) = "\\" ИЛИ Лев(Путь, 2) = "//";
	ПутьСДиском = СтрДлина(Путь) >= 3 И Сред(Путь, 2, 1) = ":"
		И (Сред(Путь, 3, 1) = "\" ИЛИ Сред(Путь, 3, 1) = "/")
		И СтрНайти("abcdefghijklmnopqrstuvwxyz", НРег(Лев(Путь, 1))) > 0;
	ПутьUnix = Лев(Путь, 1) = "/" И НЕ ПутьUNC;
	Если НЕ ПутьUNC И НЕ ПутьСДиском И НЕ ПутьUnix Тогда
		ВызватьИсключение "Требуется абсолютный серверный путь.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Путь) Цикл
		СимволПути = Сред(Путь, Индекс, 1);
		Если КодСимвола(СимволПути) < 32 ИЛИ КодСимвола(СимволПути) = 127
			ИЛИ СтрНайти("*?""<>|", СимволПути) > 0
			ИЛИ (СимволПути = ":" И НЕ (ПутьСДиском И Индекс = 2)) Тогда
			ВызватьИсключение "Недопустимый серверный путь.";
		КонецЕсли;
	КонецЦикла;
	Части = СтрРазделить(СтрЗаменить(Путь, "\", "/"), "/", Ложь);
	Если ПутьUNC И Части.Количество() < 2 Тогда
		ВызватьИсключение "В UNC-пути требуется сервер и общий ресурс.";
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если Часть = "." ИЛИ Часть = ".."
			ИЛИ (НЕ ПутьUnix И (Прав(Часть, 1) = "." ИЛИ Прав(Часть, 1) = " ")) Тогда
			ВызватьИсключение "Недопустимый компонент серверного пути.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПутьВнутри(Знач Каталог, Знач Имя) Экспорт

	Если ТипЗнч(Имя) <> Тип("Строка") ИЛИ ПустаяСтрока(Имя) ИЛИ Имя = "." ИЛИ Имя = ".." Тогда
		ВызватьИсключение "Недопустимое имя файла.";
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Имя) Цикл
		Если СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.", Сред(Имя, Индекс, 1)) = 0 Тогда
			ВызватьИсключение "Недопустимое имя файла.";
		КонецЕсли;
	КонецЦикла;
	ПроверитьАбсолютныйСерверныйПуть(Каталог);
	ФайлКаталога = Новый Файл(Каталог);
	Каталог = ФайлКаталога.ПолноеИмя;
	Разделитель = ?(Лев(Каталог, 1) = "/" И Лев(Каталог, 2) <> "//", "/", "\");
	Если Разделитель = "\" И СтрНайти(Каталог, "/") > 0 Тогда
		Каталог = СтрЗаменить(Каталог, "/", "\");
	КонецЕсли;
	Если Разделитель = "\" И Прав(Имя, 1) = "." Тогда
		ВызватьИсключение "Недопустимое имя файла.";
	КонецЕсли;
	Возврат Каталог + ?(Прав(Каталог, 1) = Разделитель, "", Разделитель) + Имя;

КонецФункции

Функция ПолучитьПутьСлужебногоКаталога(Знач Корень, Знач Имя) Экспорт

	Если НРег(Имя) = "documents" Тогда
		КаноническоеИмя = "Documents";
	ИначеЕсли НРег(Имя) = "incoming" Тогда
		КаноническоеИмя = "Incoming";
	Иначе
		ВызватьИсключение "Неизвестный служебный каталог DoRIS.";
	КонецЕсли;
	Корень = ПроверитьСерверныйКаталог(Корень);
	НайденныйКаталог = Неопределено;
	Для Каждого НайденныйОбъект Из НайтиФайлы(Корень, "*", Ложь) Цикл
		Если НРег(НайденныйОбъект.Имя) <> НРег(КаноническоеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Если НайденныйКаталог <> Неопределено Тогда
			ВызватьИсключение "Найдены служебные каталоги DoRIS, отличающиеся только регистром. Разрешите конфликт вручную.";
		КонецЕсли;
		Если НЕ НайденныйОбъект.ЭтоКаталог() Тогда
			ВызватьИсключение "Имя служебного каталога DoRIS занято обычным файлом.";
		КонецЕсли;
		НайденныйКаталог = НайденныйОбъект;
	КонецЦикла;
	Если НайденныйКаталог <> Неопределено Тогда
		Возврат ПроверитьСерверныйКаталог(НайденныйКаталог.ПолноеИмя);
	КонецЕсли;
	Возврат ПутьВнутри(Корень, КаноническоеИмя);

КонецФункции

Функция ПодготовитьКаталогиОбмена(Знач Корень) Экспорт

	Корень = ПроверитьСерверныйКаталог(Корень);
	Если СтрДлина(Корень) > 250 Тогда
		ВызватьИсключение "Длина пути хранилища не должна превышать 250 символов.";
	КонецЕсли;

	Каталоги = Новый Массив;
	Каталоги.Добавить(ПолучитьПутьСлужебногоКаталога(Корень, "Documents"));
	КаталогВходящих = ПолучитьПутьСлужебногоКаталога(Корень, "Incoming");
	Каталоги.Добавить(КаталогВходящих);
	DR_MobileFolderImport.ПроверитьРазделениеКаталогов(КаталогВходящих);
	Для Каждого ПутьКаталога Из Каталоги Цикл
		СоздатьКаталог(ПутьКаталога);
		ПроверитьСерверныйКаталог(ПутьКаталога);
	КонецЦикла;
	Возврат Корень;

КонецФункции

Функция КаталогиПересекаются(Знач Первый, Знач Второй) Экспорт

	ПроверитьАбсолютныйСерверныйПуть(Первый);
	ФайлПервого = Новый Файл(Первый);
	Первый = ФайлПервого.ПолноеИмя;
	ПроверитьАбсолютныйСерверныйПуть(Второй);
	ФайлВторого = Новый Файл(Второй);
	Второй = ФайлВторого.ПолноеИмя;
	Разделитель = ?(Лев(Первый, 1) = "/" И Лев(Первый, 2) <> "//", "/", "\");
	Если Разделитель = "\" Тогда
		Первый = НРег(СтрЗаменить(Первый, "/", "\"));
		Второй = НРег(СтрЗаменить(Второй, "/", "\"));
	КонецЕсли;
	Если Прав(Первый, 1) <> Разделитель Тогда
		Первый = Первый + Разделитель;
	КонецЕсли;
	Если Прав(Второй, 1) <> Разделитель Тогда
		Второй = Второй + Разделитель;
	КонецЕсли;
	Возврат Лев(Первый, СтрДлина(Второй)) = Второй ИЛИ Лев(Второй, СтрДлина(Первый)) = Первый;

КонецФункции

Процедура ПроверитьДлинуПутиДокумента(Знач UUIDДокумента, Контекст) Экспорт

	Если НЕ DR_Validation.КорректныйUUID(UUIDДокумента)
		ИЛИ НЕ DR_Validation.КорректныйUUID(Контекст.ИдентификаторПользователяИБ) Тогда
		ВызватьИсключение "Недопустимый UUID документа или владельца.";
	КонецЕсли;
	Корень = ПроверитьСерверныйКаталог(DR_MobileSettings.ПолучитьПутьХранилища(Контекст.Пользователь));
	КаталогДокументов = ПолучитьПутьСлужебногоКаталога(Корень, "Documents");
	КаталогВладельца = ПутьВнутри(КаталогДокументов, Контекст.ИдентификаторПользователяИБ);
	ПроверитьДлинуКаталогаОригиналов(ПутьВнутри(КаталогВладельца, UUIDДокумента), Контекст);

КонецПроцедуры

Процедура ПроверитьДлинуКаталогаОригиналов(Знач Путь, Контекст)

	Если СтрДлина(Путь) > 255 Тогда
		Сообщение = "Длина полного пути каталога оригиналов превышает 255 символов. Укажите более короткую папку DoRIS.";
		Контекст.Вставить("ПричинаОшибкиИмпорта", Сообщение);
		ВызватьИсключение Сообщение;
	КонецЕсли;

КонецПроцедуры

Функция ПодготовитьФайловоеХранилище(Документ, Контекст) Экспорт

	Корень = ПроверитьСерверныйКаталог(DR_MobileSettings.ПолучитьПутьХранилища(Контекст.Пользователь));
	Если НЕ DR_Validation.КорректныйUUID(Документ.document_id)
		ИЛИ НЕ DR_Validation.КорректныйUUID(Контекст.ИдентификаторПользователяИБ) Тогда
		ВызватьИсключение "Недопустимый идентификатор хранилища.";
	КонецЕсли;
	КаталогДокументов = ПолучитьПутьСлужебногоКаталога(Корень, "Documents");
	Владелец = ПутьВнутри(КаталогДокументов, Контекст.ИдентификаторПользователяИБ);
	КаталогДокумента = ПутьВнутри(Владелец, Документ.document_id);
	ПроверитьДлинуКаталогаОригиналов(КаталогДокумента, Контекст);
	СоздатьКаталог(КаталогДокументов);
	СоздатьКаталог(Владелец);
	Операция = НРег(Строка(Новый УникальныйИдентификатор));
	Временный = ПутьВнутри(Владелец, ".pending-" + Операция);
	ФайлВременногоКаталога = Новый Файл(Временный);
	Если ФайлВременногоКаталога.Существует() Тогда
		ВызватьИсключение "Каталог операции уже существует.";
	КонецЕсли;
	Стадия = Новый Структура("ВременныйКаталог,КаталогДокумента,Операция,Владелец,document_id,Манифест",
		Временный, КаталогДокумента, Операция,
		Контекст.ИдентификаторПользователяИБ, Документ.document_id, Документ.manifest);
	СоздатьКаталог(Временный);
	Попытка
		ЗаписатьМаркерОперации(Стадия, Ложь);
		ИзФайлов = Документ.Свойство("ИсточникиФайлов");
		Если Документ.manifest.files.Количество() < 1 ИЛИ Документ.manifest.files.Количество() > 100 Тогда
			ВызватьИсключение "Недопустимое количество файлов.";
		КонецЕсли;
		Источники = ?(ИзФайлов, Документ.ИсточникиФайлов, Документ.Оригиналы);
		Если Источники.Количество() <> Документ.manifest.files.Количество() Тогда
			ВызватьИсключение "Не совпадает количество оригиналов.";
		КонецЕсли;
		Всего = 0;
		Для Индекс = 0 По Документ.manifest.files.Количество() - 1 Цикл
			ФайлМанифеста = Документ.manifest.files[Индекс];
			Если ФайлМанифеста.size <= 0 ИЛИ ФайлМанифеста.size > 20971520 Тогда
				ВызватьИсключение "Превышен размер оригинала.";
			КонецЕсли;
			Всего = Всего + ФайлМанифеста.size;
			Если Всего > 52428800 Тогда
				ВызватьИсключение "Превышен размер документа.";
			КонецЕсли;
			Назначение = ПутьВнутри(Временный, ФайлМанифеста.filename);
			Если ИзФайлов Тогда
				КопироватьФайл(Источники[Индекс], Назначение);
			Иначе
				Источники[Индекс].Записать(Назначение);
			КонецЕсли;
		КонецЦикла;
		ПроверитьСохраненныеФайлы(Временный, Документ.manifest);
		ЗаписатьМаркерОперации(Стадия, Истина);
		Возврат Стадия;
	Исключение
		ОчиститьСобственныйВременныйКаталог(Стадия);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Процедура ЗаписатьМаркерОперации(Стадия, Подготовлен, Каталог = Неопределено)

	Если Каталог = Неопределено Тогда
		Каталог = Стадия.ВременныйКаталог;
	КонецЕсли;
	Данные = Новый Структура("format,operation_id,owner_id,document_id,prepared,manifest",
		"DoRIS.ServerStorage", Стадия.Операция, Стадия.Владелец,
		Стадия.document_id, Подготовлен, Стадия.Манифест);
	JSON = Новый ЗаписьJSON;
	JSON.УстановитьСтроку();
	ЗаписатьJSON(JSON, Данные);
	ПолучитьДвоичныеДанныеИзСтроки(JSON.Закрыть(), КодировкаТекста.UTF8, Ложь).Записать(
		ПутьВнутри(Каталог, "doris-operation.json"));

КонецПроцедуры

Процедура ПроверитьСохраненныеФайлы(Каталог, Манифест)

	Элементы = НайтиФайлы(Каталог, "*", Ложь);
	Если Элементы.Количество() <> Манифест.files.Количество() + 1 Тогда
		ВызватьИсключение "Неполный или конфликтный каталог оригиналов.";
	КонецЕсли;
	Для Каждого Описание Из Манифест.files Цикл
		ФайлДанных = Новый Файл(ПутьВнутри(Каталог, Описание.filename));
		Если НЕ ФайлДанных.Существует() ИЛИ НЕ ФайлДанных.ЭтоФайл()
			ИЛИ ФайлДанных.Размер() <> Описание.size Тогда
			ВызватьИсключение "Оригинал отсутствует или записан не полностью.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ОпубликоватьОригиналы(Стадия, Контекст) Экспорт

	Каталог = Стадия.КаталогДокумента;
	ПроверитьДлинуКаталогаОригиналов(Каталог, Контекст);
	ФайлКаталога = Новый Файл(Каталог);
	Если ФайлКаталога.Существует() Тогда
		Если НЕ ФайлКаталога.ЭтоКаталог() Тогда
			ВызватьИсключение "Конфликт каталога документа.";
		КонецЕсли;
		Маркер = Новый Файл(ПутьВнутри(Каталог, "doris-operation.json"));
		Если НЕ Маркер.Существует() ИЛИ НЕ Маркер.ЭтоФайл() ИЛИ Маркер.Размер() < 1 ИЛИ Маркер.Размер() > 32768 Тогда
			ВызватьИсключение "Чужой или незавершённый каталог документа.";
		КонецЕсли;
		Данные = DR_MobileMultipart.ПрочитатьСтрогийJSON(Новый ДвоичныеДанные(Маркер.ПолноеИмя), Контекст);
		Если Данные.format <> "DoRIS.ServerStorage" ИЛИ ТипЗнч(Данные.prepared) <> Тип("Булево")
			ИЛИ НЕ DR_Validation.КорректныйUUID(Данные.operation_id)
			ИЛИ Данные.owner_id <> Стадия.Владелец ИЛИ Данные.document_id <> Стадия.document_id Тогда
			ВызватьИсключение "Нельзя подтвердить принадлежность каталога.";
		КонецЕсли;
		Если НЕ DR_MobileStorage.МанифестыРавны(Данные.manifest, Стадия.Манифест) Тогда
			DR_MobileHttp.Отклонить(Контекст, 409, "uuid_content_conflict");
		КонецЕсли;
		ПроверитьЧастичныйКаталог(Каталог, Стадия.Манифест);
		Если Данные.prepared И НайтиФайлы(Каталог, "*", Ложь).Количество() = Стадия.Манифест.files.Количество() + 1 Тогда
			ПроверитьСохраненныеФайлы(Каталог, Стадия.Манифест);
			Возврат Каталог;
		КонецЕсли;
	Иначе
		СоздатьКаталог(Каталог);
	КонецЕсли;

	ЗаписатьМаркерОперации(Стадия, Ложь, Каталог);
	Для Каждого Описание Из Стадия.Манифест.files Цикл
		Назначение = ПутьВнутри(Каталог, Описание.filename);
		ФайлНазначения = Новый Файл(Назначение);
		Если ФайлНазначения.Существует() Тогда

			Продолжить;
		КонецЕсли;
		ПереместитьФайл(ПутьВнутри(Стадия.ВременныйКаталог, Описание.filename), Назначение);
	КонецЦикла;
	ПроверитьСохраненныеФайлы(Каталог, Стадия.Манифест);
	ЗаписатьМаркерОперации(Стадия, Истина, Каталог);
	Возврат Каталог;

КонецФункции

Процедура ПроверитьЧастичныйКаталог(Каталог, Манифест)

	Имена = Новый Соответствие;
	Имена.Вставить("doris-operation.json", -1);
	Для Каждого Описание Из Манифест.files Цикл
		Имена.Вставить(Описание.filename, Описание.size);
	КонецЦикла;
	Для Каждого Элемент Из НайтиФайлы(Каталог, "*", Ложь) Цикл
		Размер = Имена.Получить(Элемент.Имя);
		Если Размер = Неопределено ИЛИ НЕ Элемент.ЭтоФайл() Тогда
			ВызватьИсключение "Чужие файлы в каталоге.";
		КонецЕсли;
		Если Размер >= 0 И Элемент.Размер() <> Размер Тогда
			ВызватьИсключение "Неполный оригинал в каталоге.";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьСобственныйВременныйКаталог(Стадия) Экспорт

	Попытка
		ФайлВременногоКаталога = Новый Файл(Стадия.ВременныйКаталог);
		Если НЕ ФайлВременногоКаталога.Существует() Тогда
			Возврат;
		КонецЕсли;
		Если НЕ DR_Validation.КорректныйUUID(Стадия.Операция)
			ИЛИ ФайлВременногоКаталога.Имя <> ".pending-" + Стадия.Операция Тогда
			Возврат;
		КонецЕсли;
		Имена = Новый Соответствие;
		Имена.Вставить("doris-operation.json", Истина);
		Для Каждого Описание Из Стадия.Манифест.files Цикл
			Имена.Вставить(Описание.filename, Истина);
		КонецЦикла;
		Файлы = НайтиФайлы(Стадия.ВременныйКаталог, "*", Ложь);
		Для Каждого ФайлДанных Из Файлы Цикл
			Если НЕ ФайлДанных.ЭтоФайл() ИЛИ Имена.Получить(ФайлДанных.Имя) = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ФайлДанных Из Файлы Цикл
			УдалитьФайлы(ФайлДанных.ПолноеИмя);
		КонецЦикла;
		Если НайтиФайлы(Стадия.ВременныйКаталог, "*", Ложь).Количество() = 0 Тогда
			УдалитьФайлы(Стадия.ВременныйКаталог);
		КонецЕсли;
	Исключение

		Возврат;
	КонецПопытки;

КонецПроцедуры
