#Область ПрограммныйИнтерфейс

Функция ВыполнитьРаспознавание(Настройки, СтруктураФайла) Экспорт

	Попытка
		Подключение = ПолучитьПараметрыПодключения(Настройки);
		Если ЗначениеЗаполнено(Подключение.Ошибка) Тогда
			Возврат СоздатьРезультат(Подключение.Ошибка);
		КонецЕсли;

		Формат = ПолучитьФорматФайла(СтруктураФайла.ТипФайла);
		Если Формат = Неопределено Тогда
			Возврат СоздатьРезультат("Локальный PaddleOCR поддерживает только JPEG, PNG и PDF.");
		КонецЕсли;

		ДанныеФайла = ПолучитьИзВременногоХранилища(СтруктураФайла.АдресФайла);
		Если ДанныеФайла = Неопределено Тогда
			Возврат СоздатьРезультат("Не удалось получить оригинал из временного хранилища.");
		КонецЕсли;
		Если ДанныеФайла.Размер() = 0 ИЛИ ДанныеФайла.Размер() > 31457280 Тогда
			Возврат СоздатьРезультат("Файл для локального PaddleOCR должен быть непустым и не превышать 30 МиБ.");
		КонецЕсли;

		Запрос = СоздатьЗапрос(ДанныеФайла, Формат);

		Попытка

			Соединение = Новый HTTPСоединение(Подключение.Сервер, Подключение.Порт,
				, , Новый ИнтернетПрокси(Ложь), Подключение.Таймаут);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Исключение
			Возврат СоздатьРезультат(СтрШаблон(
				"Локальный PaddleOCR недоступен или истекло время ожидания (%1 с). Проверьте ручной запуск сервиса и его адрес. Автоматический повтор не выполнялся.",
				Подключение.Таймаут));
		КонецПопытки;

		Если Ответ.КодСостояния <> 200 Тогда
			Возврат СоздатьРезультат(СообщениеHTTPОшибки(Ответ.КодСостояния));
		КонецЕсли;

		Возврат РазобратьОтвет(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Исключение

		Возврат СоздатьРезультат("Не удалось обработать документ в адаптере локального PaddleOCR.");
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область Подключение

Функция ПолучитьПараметрыПодключения(Настройки)

	Параметры = Новый Структура("Сервер,Порт,Таймаут,Ошибка", "127.0.0.1", 8765, 180, "");
	Сервер = "";
	Порт = 0;
	Таймаут = 0;
	Настройки.Свойство("Сервер", Сервер);
	Настройки.Свойство("Порт", Порт);
	Настройки.Свойство("ТаймаутHTTP", Таймаут);

	Если ЗначениеЗаполнено(Сервер) Тогда
		Адрес = СокрЛП(Сервер);
		Если СтрНачинаетсяС(НРег(Адрес), "http://") Тогда
			Адрес = Сред(Адрес, 8);
		ИначеЕсли СтрНайти(Адрес, "://") > 0 Тогда
			Параметры.Ошибка = "Для локального PaddleOCR поддерживается только HTTP без TLS.";
			Возврат Параметры;
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(Адрес, "/") Тогда
			Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
		КонецЕсли;
		Если ПустаяСтрока(Адрес) Тогда
			Параметры.Ошибка = "Не указан адрес OCR-сервера.";
			Возврат Параметры;
		КонецЕсли;
		Для Каждого ЗапрещенныйСимвол Из СтрРазделить("/,\,?,#,@, ," + Символы.Таб + "," + Символы.ВК + "," + Символы.ПС, ",", Истина) Цикл
			Если СтрНайти(Адрес, ЗапрещенныйСимвол) > 0 Тогда
				Параметры.Ошибка = "Укажите имя или IP-адрес OCR-сервера без пути, параметров и учётных данных.";
				Возврат Параметры;
			КонецЕсли;
		КонецЦикла;
		ПортИзАдреса = "";
		ПортУказанВАдресе = Ложь;
		Если СтрНачинаетсяС(Адрес, "[") Тогда
			КонецСкобки = СтрНайти(Адрес, "]");
			Если КонецСкобки < 3 Тогда
				Параметры.Ошибка = "Некорректный IPv6-адрес OCR-сервера.";
				Возврат Параметры;
			КонецЕсли;
			Параметры.Сервер = Сред(Адрес, 2, КонецСкобки - 2);
			ОстатокАдреса = Сред(Адрес, КонецСкобки + 1);
			Если НЕ ПустаяСтрока(ОстатокАдреса) Тогда
				Если НЕ СтрНачинаетсяС(ОстатокАдреса, ":") Тогда
					Параметры.Ошибка = "Некорректный адрес OCR-сервера после закрывающей скобки.";
					Возврат Параметры;
				КонецЕсли;
				ПортИзАдреса = Сред(ОстатокАдреса, 2);
				ПортУказанВАдресе = Истина;
			КонецЕсли;
		Иначе
			ЧастиАдреса = СтрРазделить(Адрес, ":", Истина);
			Если ЧастиАдреса.Количество() > 2 Тогда
				Параметры.Ошибка = "Укажите IPv6-адрес OCR-сервера в квадратных скобках.";
				Возврат Параметры;
			КонецЕсли;
			Параметры.Сервер = ЧастиАдреса[0];
			Если ЧастиАдреса.Количество() = 2 Тогда
				ПортИзАдреса = ЧастиАдреса[1];
				ПортУказанВАдресе = Истина;
			КонецЕсли;
		КонецЕсли;
		Если ПустаяСтрока(Параметры.Сервер) ИЛИ СтрНайти(Параметры.Сервер, "[") > 0
			ИЛИ СтрНайти(Параметры.Сервер, "]") > 0 Тогда
			Параметры.Ошибка = "Не указан корректный адрес OCR-сервера.";
			Возврат Параметры;
		КонецЕсли;
		Если ПортУказанВАдресе Тогда
			Если СтрДлина(ПортИзАдреса) = 0 ИЛИ СтрДлина(ПортИзАдреса) > 5 Тогда
				Параметры.Ошибка = "Некорректный порт локального PaddleOCR.";
				Возврат Параметры;
			КонецЕсли;
			Для Позиция = 1 По СтрДлина(ПортИзАдреса) Цикл
				Если СтрНайти("0123456789", Сред(ПортИзАдреса, Позиция, 1)) = 0 Тогда
					Параметры.Ошибка = "Некорректный порт локального PaddleOCR.";
					Возврат Параметры;
				КонецЕсли;
			КонецЦикла;
			Попытка
				Параметры.Порт = Число(ПортИзАдреса);
			Исключение
				Параметры.Ошибка = "Некорректный порт локального PaddleOCR.";
				Возврат Параметры;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Порт) Тогда
		Параметры.Порт = Порт;
	КонецЕсли;
	Если ЗначениеЗаполнено(Таймаут) Тогда
		Параметры.Таймаут = Таймаут;
	КонецЕсли;
	Если Параметры.Порт < 1 ИЛИ Параметры.Порт > 65535 ИЛИ Параметры.Порт <> Цел(Параметры.Порт) Тогда
		Параметры.Ошибка = "Некорректный порт локального PaddleOCR.";
	ИначеЕсли Параметры.Таймаут <= 0 Тогда
		Параметры.Ошибка = "Таймаут локального PaddleOCR должен быть больше нуля.";
	КонецЕсли;
	Возврат Параметры;

КонецФункции

Функция ПолучитьФорматФайла(Знач ТипФайла)

	ТипФайла = НРег(СокрЛП(ТипФайла));
	Если ТипФайла = "jpg" ИЛИ ТипФайла = "jpeg" ИЛИ ТипФайла = "image/jpeg" Тогда
		Возврат Новый Структура("Расширение,MIME", "jpg", "image/jpeg");
	ИначеЕсли ТипФайла = "png" ИЛИ ТипФайла = "image/png" Тогда
		Возврат Новый Структура("Расширение,MIME", "png", "image/png");
	ИначеЕсли ТипФайла = "pdf" ИЛИ ТипФайла = "application/pdf" Тогда
		Возврат Новый Структура("Расширение,MIME", "pdf", "application/pdf");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция СоздатьЗапрос(ДанныеФайла, Формат)

	Граница = "DoRIS" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Перенос = Символы.ВК + Символы.ПС;
	Начало = "--" + Граница + Перенос
		+ "Content-Disposition: form-data; name=""mode""" + Перенос + Перенос
		+ "structure" + Перенос
		+ "--" + Граница + Перенос
		+ "Content-Disposition: form-data; name=""file""; filename=""document." + Формат.Расширение + """" + Перенос
		+ "Content-Type: " + Формат.MIME + Перенос + Перенос;
	Конец = Перенос + "--" + Граница + "--" + Перенос;

	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Запись.Записать(ПолучитьДвоичныеДанныеИзСтроки(Начало, КодировкаТекста.UTF8, Ложь));
	Запись.Записать(ДанныеФайла);
	Запись.Записать(ПолучитьДвоичныеДанныеИзСтроки(Конец, КодировкаТекста.UTF8, Ложь));
	Запись.Закрыть();
	Тело = Поток.ЗакрытьИПолучитьДвоичныеДанные();

	Запрос = Новый HTTPЗапрос("/ocr");
	Запрос.Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Запрос.УстановитьТелоИзДвоичныхДанных(Тело);
	Возврат Запрос;

КонецФункции

Функция СообщениеHTTPОшибки(КодСостояния)

	Если КодСостояния = 400 Тогда
		Возврат "Локальный PaddleOCR отклонил запрос: проверьте файл, размер и отсутствие защиты PDF (HTTP 400).";
	ИначеЕсли КодСостояния = 415 Тогда
		Возврат "Локальный PaddleOCR не поддерживает формат файла (HTTP 415).";
	ИначеЕсли КодСостояния = 500 Тогда
		Возврат "Ошибка распознавания документа в локальном PaddleOCR (HTTP 500).";
	ИначеЕсли КодСостояния = 503 Тогда
		Возврат "Движок локального PaddleOCR не готов. Проверьте загрузку моделей (HTTP 503).";
	КонецЕсли;
	Возврат СтрШаблон("Локальный PaddleOCR вернул неожиданный HTTP-статус %1.", КодСостояния);

КонецФункции

#КонецОбласти

#Область ОтветПровайдера

Функция РазобратьОтвет(ТелоОтвета)

	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(ТелоОтвета);
		Ответ = ПрочитатьJSON(Чтение);
	Исключение
		Чтение.Закрыть();
		Возврат СоздатьРезультат("Локальный PaddleOCR вернул некорректный JSON.");
	КонецПопытки;
	Чтение.Закрыть();

	Если ТипЗнч(Ответ) <> Тип("Структура") Тогда
		Возврат СоздатьРезультат("Локальный PaddleOCR вернул некорректную структуру JSON.");
	КонецЕсли;
	Успех = Неопределено;
	Если НЕ Ответ.Свойство("success", Успех) ИЛИ ТипЗнч(Успех) <> Тип("Булево") Тогда
		Возврат СоздатьРезультат("В ответе локального PaddleOCR отсутствует корректный признак success.");
	КонецЕсли;
	Если НЕ Успех Тогда

		Возврат СоздатьРезультат("Локальный PaddleOCR сообщил об ошибке распознавания (success=false).");
	КонецЕсли;
	Markdown = Неопределено;
	Если НЕ Ответ.Свойство("markdown", Markdown) ИЛИ ТипЗнч(Markdown) <> Тип("Строка") Тогда
		Возврат СоздатьРезультат("В ответе локального PaddleOCR отсутствует Markdown.");
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Markdown)) Тогда
		Возврат СоздатьРезультат("Локальный PaddleOCR вернул пустой результат распознавания.");
	КонецЕсли;

	Попытка
		МассивДокументов = ПодготовитьДокументы(Markdown);
	Исключение
		Возврат СоздатьРезультат("Не удалось разобрать HTML-таблицы локального PaddleOCR.");
	КонецПопытки;

	Возврат СоздатьРезультат("", ТелоОтвета, МассивДокументов, Markdown);

КонецФункции

Функция СоздатьРезультат(ТекстОшибки, JSONОтвет = "", МассивДокументов = Неопределено, Markdown = "")

	Результат = Новый Структура;
	Результат.Вставить("JobID", "");

	Результат.Вставить("ТипОтвета", DR_Settings.ТипыОтветовOCR().PaddleOCR);
	Результат.Вставить("JSONОтвет", JSONОтвет);
	Результат.Вставить("МассивДокументов", МассивДокументов);
	Результат.Вставить("Статус", ?(ЗначениеЗаполнено(ТекстОшибки),
		DR_Settings.СтатусыРаспознавания().Ошибка, DR_Settings.СтатусыРаспознавания().Успешно));
	Результат.Вставить("Ошибка", ТекстОшибки);
	Результат.Вставить("Markdown", Markdown);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ТаблицыPaddle

Функция ПодготовитьДокументы(Markdown)

	СтрокиДокумента = Новый Массив;
	ТаблицыТоваров = Новый Массив;
	НижнийРегистр = НРег(Markdown);
	Позиция = 1;
	Пока Позиция <= СтрДлина(Markdown) Цикл
		НачалоТаблицы = СтрНайти(НижнийРегистр, "<table", НаправлениеПоиска.СНачала, Позиция);
		Если НачалоТаблицы = 0 Тогда
			ДобавитьСтрокиДокумента(Сред(Markdown, Позиция), СтрокиДокумента);
			Прервать;
		КонецЕсли;
		ДобавитьСтрокиДокумента(Сред(Markdown, Позиция, НачалоТаблицы - Позиция), СтрокиДокумента);
		КонецТаблицы = СтрНайти(НижнийРегистр, "</table>", НаправлениеПоиска.СНачала, НачалоТаблицы);
		Если КонецТаблицы = 0 Тогда
			ВызватьИсключение "Незавершённая HTML-таблица.";
		КонецЕсли;
		ТекстТаблицы = Сред(Markdown, НачалоТаблицы, КонецТаблицы + 8 - НачалоТаблицы);
		ТаблицыТоваров.Добавить(ПрочитатьТаблицуHTML(ТекстТаблицы));
		Позиция = КонецТаблицы + 8;
	КонецЦикла;
	Документ = Новый Структура("СтрокиДокумента,ТаблицыТоваров", СтрокиДокумента, ТаблицыТоваров);
	МассивДокументы = Новый Массив;

	МассивДокументы.Добавить(Документ);
	Возврат МассивДокументы;

КонецФункции

Процедура ДобавитьСтрокиДокумента(Текст, СтрокиДокумента)

	Для Каждого СтрокаТекста Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если НЕ ПустаяСтрока(СокрЛП(СтрокаТекста)) Тогда
			СтрокиДокумента.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьТаблицуHTML(ТекстТаблицы)

	Чтение = Новый ЧтениеHTML;
	Чтение.УстановитьСтроку(ТекстТаблицы, "UTF-8");
	Попытка
		Построитель = Новый ПостроительDOM;
		ДокументHTML = Построитель.Прочитать(Чтение);
	Исключение
		Чтение.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	Чтение.Закрыть();
	Таблица = Новый Массив;
	Для Каждого СтрокаHTML Из ДокументHTML.ПолучитьЭлементыПоИмени("tr") Цикл
		Ячейки = Новый Массив;
		Для Каждого Узел Из СтрокаHTML.ДочерниеУзлы Цикл
			ИмяУзла = НРег(Узел.ИмяУзла);
			Если ИмяУзла = "td" ИЛИ ИмяУзла = "th" Тогда
				Ячейки.Добавить(ТекстУзлаHTML(Узел));
			КонецЕсли;
		КонецЦикла;
		Если Ячейки.Количество() > 0 Тогда
			Таблица.Добавить(Ячейки);
		КонецЕсли;
	КонецЦикла;
	Если Таблица.Количество() = 0 Тогда
		ВызватьИсключение "HTML-таблица не содержит строк.";
	КонецЕсли;
	Возврат Таблица;

КонецФункции

Функция ТекстУзлаHTML(Узел)

	Если Узел.ИмяУзла = "#text" Тогда
		Возврат Узел.ЗначениеУзла;
	КонецЕсли;
	Если НРег(Узел.ИмяУзла) = "br" Тогда
		Возврат " ";
	КонецЕсли;
	Текст = "";
	Для Каждого ДочернийУзел Из Узел.ДочерниеУзлы Цикл
		Текст = Текст + ТекстУзлаHTML(ДочернийУзел);
	КонецЦикла;
	Возврат Текст;

КонецФункции

#КонецОбласти
