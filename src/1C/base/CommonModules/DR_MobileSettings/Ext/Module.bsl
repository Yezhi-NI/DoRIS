	Путь = DR_MobileFiles.ПроверитьСерверныйКаталог(Путь);
	Если СтрДлина(Путь) > 250 Тогда
		ВызватьИсключение "Длина пути хранилища не должна превышать 250 символов.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.DR_НастройкиМобильныхДокументов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Пользователь", Пользователь);
		Блокировка.Заблокировать();
		ПрочитатьНастройкиПользователя(Пользователь);
		Запись = РегистрыСведений.DR_НастройкиМобильныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.ПутьКПапке = Путь;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьНаличиеФайловогоТокена(Пользователь) Экспорт

	ПроверитьПользователя(Пользователь);
	Настройки = ПрочитатьНастройкиПользователя(Пользователь);
	Возврат Настройки <> Неопределено И ЗначениеЗаполнено(Настройки.ФайловыйТокен);

КонецФункции

Функция ПолучитьФайловыйТокенДляПередачи(Пользователь) Экспорт

	ПроверитьПользователя(Пользователь);
	Настройки = ПрочитатьНастройкиПользователя(Пользователь);
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Настройки.ФайловыйТокен;

КонецФункции

Процедура УправлятьФайловымТокеном(Пользователь, Действие) Экспорт

	ПроверитьПользователя(Пользователь);
	Если Действие <> "Создать" И Действие <> "Перевыпустить" И Действие <> "Отозвать" Тогда
		ВызватьИсключение "Неизвестная команда файлового токена.";
	КонецЕсли;
	Если Действие <> "Отозвать" Тогда
		ПолучитьПользователяИБ(Пользователь);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.DR_НастройкиМобильныхДокументов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Настройки = ПрочитатьНастройкиПользователя(Пользователь);
		Если Настройки = Неопределено Тогда
			ВызватьИсключение "Сначала сохраните разрешение мобильного обмена.";
		КонецЕсли;
		Если Действие = "Создать" И ЗначениеЗаполнено(Настройки.ФайловыйТокен) Тогда
			ВызватьИсключение "Файловый токен уже создан. Используйте перевыпуск.";
		КонецЕсли;
		НовыйТокен = "";
		Если Действие <> "Отозвать" Тогда

			НовыйТокен = СгенерироватьУникальныйТокен(Настройки.ФайловыйТокен);
		КонецЕсли;
		Запись = РегистрыСведений.DR_НастройкиМобильныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.ТокенФайловогоОбмена = НовыйТокен;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция АвторизоватьФайловыйТокен(Токен) Экспорт

	Если НЕ КорректныйТокенМобильногоДоступа(Токен) Тогда
		ВызватьИсключение "Недействительный файловый токен.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2 Пользователь, ИдентификаторПользователя, ТокенМобильногоДоступа
        |ИЗ РегистрСведений.DR_НастройкиМобильныхДокументов
        |ГДЕ ТокенФайловогоОбмена = &Токен ИЛИ ТокенМобильногоДоступа = &Токен";
	Запрос.УстановитьПараметр("Токен", Токен);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		ВызватьИсключение "Недействительный файловый токен.";
	КонецЕсли;
	Пользователь = Выборка.Пользователь;
	Если Выборка.ИдентификаторПользователя <> "" ИЛИ Выборка.ТокенМобильногоДоступа = Токен
		ИЛИ Выборка.Следующий() Тогда
		ВызватьИсключение "Недействительный файловый токен.";
	КонецЕсли;
	ПроверитьПользователя(Пользователь);
	Настройки = ПрочитатьНастройкиПользователя(Пользователь);
	Если Настройки = Неопределено ИЛИ Настройки.ФайловыйТокен <> Токен ИЛИ НЕ Настройки.Разрешено Тогда
		ВызватьИсключение "Файловый обмен не разрешён.";
	КонецЕсли;
	ПользовательИБ = ПолучитьПользователяИБ(Пользователь);

	Возврат Новый Структура("Пользователь,ИдентификаторПользователяИБ,ИсточникПриема,ФайловыйТокен",
		Пользователь, НРег(Строка(ПользовательИБ.УникальныйИдентификатор)), "Папка", Токен);

КонецФункции

#КонецОбласти

#Область СлужебныеФункции

Процедура ИзменитьТокен(Пользователь, НовыйТокен, Генерировать = Ложь, ТолькоЕслиОтсутствует = Ложь)

	НачатьТранзакцию();
	Попытка

		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.DR_НастройкиМобильныхДокументов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Настройки = ПрочитатьНастройкиПользователя(Пользователь);
		Если Генерировать Тогда
			Если Настройки = Неопределено Тогда
				ВызватьИсключение "Сначала сохраните разрешение мобильного обмена для пользователя.";
			КонецЕсли;
			Если ТолькоЕслиОтсутствует И ЗначениеЗаполнено(Настройки.Токен) Тогда
				ВызватьИсключение "Токен уже создан. Используйте команду перевыпуска с подтверждением.";
			КонецЕсли;
			НовыйТокен = СгенерироватьУникальныйТокен(Настройки.Токен);
		КонецЕсли;
		Если НовыйТокен <> "" Тогда
			Если Настройки <> Неопределено И Настройки.Токен = НовыйТокен Тогда
				ВызватьИсключение "При перевыпуске требуется новый токен.";
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1 Настройки.Пользователь
                |ИЗ РегистрСведений.DR_НастройкиМобильныхДокументов КАК Настройки
                |ГДЕ Настройки.ТокенМобильногоДоступа = &Токен ИЛИ Настройки.ТокенФайловогоОбмена = &Токен";
			Запрос.УстановитьПараметр("Токен", НовыйТокен);
			Если НЕ Запрос.Выполнить().Пустой() Тогда
				ВызватьИсключение "Токен уже используется. Сгенерируйте другой токен.";
			КонецЕсли;
		КонецЕсли;
		Запись = РегистрыСведений.DR_НастройкиМобильныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.ТокенМобильногоДоступа = НовыйТокен;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция СгенерироватьУникальныйТокен(ТекущийТокен, ИсключенныйТокен = "")

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Настройки.Пользователь
        |ИЗ РегистрСведений.DR_НастройкиМобильныхДокументов КАК Настройки
        |ГДЕ Настройки.ТокенМобильногоДоступа = &Токен ИЛИ Настройки.ТокенФайловогоОбмена = &Токен";
	НомерПопытки = 0;
	Пока НомерПопытки < 10 Цикл
		НомерПопытки = НомерПопытки + 1;
		Токен = НовыйТокенUUID();
		Если НЕ КорректныйТокенМобильногоДоступа(Токен)
			ИЛИ Токен = ТекущийТокен ИЛИ Токен = ИсключенныйТокен Тогда
			Продолжить;
		КонецЕсли;
		Запрос.УстановитьПараметр("Токен", Токен);

		Если Запрос.Выполнить().Пустой() Тогда
			Возврат Токен;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Не удалось создать уникальный токен. Повторите операцию позднее.";

КонецФункции

Функция НовыйТокенUUID()

	Возврат НРег(Строка(Новый УникальныйИдентификатор()));

КонецФункции

Процедура ПроверитьАдресПубликации(Адрес)

	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		ВызватьИсключение "Адрес публикации должен быть строкой.";
	КонецЕсли;

	Если СтрДлина(Адрес) > 255 Тогда
		ВызватьИсключение "Длина адреса публикации не должна превышать 255 символов.";
	КонецЕсли;
	Если Лев(Адрес, 8) <> "https://" И Лев(Адрес, 7) <> "http://" Тогда
		ВызватьИсключение "Адрес публикации должен начинаться с http:// или https://.";
	КонецЕсли;

	Если Лев(Адрес, 8) = "https://" Тогда
		Остаток = Сред(Адрес, 9);
	Иначе
		Остаток = Сред(Адрес, 8);
	КонецЕсли;
	Разделитель = СтрНайти(Остаток, "/");
	Если Разделитель <= 1 ИЛИ Прав(Адрес, 1) = "/"
		ИЛИ СтрНайти(НРег(Адрес) + "/", "/hs/") > 0 Тогда
		ВызватьИсключение "Укажите базовый адрес публикации без суффикса сервиса и завершающего слеша.";
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Адрес) Цикл
		СимволАдреса = Сред(Адрес, Позиция, 1);
		Если КодСимвола(Адрес, Позиция) <= 32 ИЛИ КодСимвола(Адрес, Позиция) = 127
			ИЛИ СтрНайти("@?#\""%", СимволАдреса) > 0 Тогда
			ВызватьИсключение "Некорректный адрес публикации.";
		КонецЕсли;
	КонецЦикла;
	Узел = Лев(Остаток, Разделитель - 1);
	ЧастиУзла = СтрРазделить(Узел, ":", Истина);
	Если ЧастиУзла.Количество() > 2 Тогда
		ВызватьИсключение "Некорректный узел публикации. Используйте DNS-имя или IPv4.";
	КонецЕсли;
	ИмяУзла = ЧастиУзла[0];
	Если ПустаяСтрока(ИмяУзла) ИЛИ СтрДлина(ИмяУзла) > 253 Тогда
		ВызватьИсключение "Некорректное имя узла публикации.";
	КонецЕсли;
	Для Каждого Метка Из СтрРазделить(НРег(ИмяУзла), ".", Истина) Цикл
		Если ПустаяСтрока(Метка) ИЛИ СтрДлина(Метка) > 63
			ИЛИ Лев(Метка, 1) = "-" ИЛИ Прав(Метка, 1) = "-" Тогда
			ВызватьИсключение "Некорректное имя узла публикации.";
		КонецЕсли;
		Для Позиция = 1 По СтрДлина(Метка) Цикл
			Если СтрНайти("abcdefghijklmnopqrstuvwxyz0123456789-", Сред(Метка, Позиция, 1)) = 0 Тогда
				ВызватьИсключение "Используйте DNS-имя узла в ASCII (для международного имени - punycode).";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ЧастиУзла.Количество() = 2 Тогда
		Порт = ЧастиУзла[1];
		Если ПустаяСтрока(Порт) ИЛИ СтрДлина(Порт) > 5 Тогда
			ВызватьИсключение "Некорректный порт публикации.";
		КонецЕсли;
		Для Позиция = 1 По СтрДлина(Порт) Цикл
			Если СтрНайти("0123456789", Сред(Порт, Позиция, 1)) = 0 Тогда
				ВызватьИсключение "Некорректный порт публикации.";
			КонецЕсли;
		КонецЦикла;
		Если Число(Порт) < 1 ИЛИ Число(Порт) > 65535 Тогда
			ВызватьИсключение "Некорректный порт публикации.";
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(Остаток, "//") > 0 ИЛИ СтрНайти(Остаток + "/", "/../") > 0
		ИЛИ СтрНайти(Остаток + "/", "/./") > 0 Тогда
		ВызватьИсключение "Некорректный путь публикации.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПользователя(Пользователь)

	Если ТипЗнч(Пользователь) <> Тип("СправочникСсылка.Пользователи") Тогда
		ВызватьИсключение "Параметр Пользователь должен быть ссылкой справочника Пользователи.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение "Не выбран пользователь.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ Пользователи.Ссылка
        |ИЗ Справочник.Пользователи КАК Пользователи
        |ГДЕ Пользователи.Ссылка = &Пользователь
        |   И НЕ Пользователи.ПометкаУдаления";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Если Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение "Пользователь не найден, недоступен или помечен на удаление.";
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьРазрешениеПользователя(Пользователь)

	Настройки = ПрочитатьНастройкиПользователя(Пользователь);
	Возврат Настройки <> Неопределено И Настройки.Разрешено;

КонецФункции

Функция ПрочитатьНастройкиПользователя(Пользователь)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
        |   Настройки.ИдентификаторПользователя КАК СтарыйКлюч,
        |   Настройки.РазрешенМобильныйОбмен КАК РазрешенМобильныйОбмен,
        |   Настройки.ТокенМобильногоДоступа КАК Токен,
        |   Настройки.ТокенФайловогоОбмена КАК ФайловыйТокен,
        |   Настройки.ПутьКПапке КАК ПутьКПапке
        |ИЗ РегистрСведений.DR_НастройкиМобильныхДокументов КАК Настройки
        |ГДЕ Настройки.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Выборка.СтарыйКлюч <> "" Тогда
		ВызватьИсключение "Нарушен ключ настройки мобильного доступа. Требуется проверка администратором.";
	КонецЕсли;
	Разрешено = Выборка.РазрешенМобильныйОбмен;
	Токен = Выборка.Токен;
	ФайловыйТокен = Выборка.ФайловыйТокен;
	ПутьКПапке = Выборка.ПутьКПапке;
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Обнаружено несколько настроек мобильного доступа одного пользователя.";
	КонецЕсли;
	Возврат Новый Структура("Разрешено,Токен,ФайловыйТокен,ПутьКПапке", Разрешено, Токен, ФайловыйТокен, ПутьКПапке);

КонецФункции

#КонецОбласти
