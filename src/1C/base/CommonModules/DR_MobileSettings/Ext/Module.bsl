	Возврат Настройки;

КонецФункции

Процедура СгенерироватьПаруТокенов(Пользователь, РазрешенаЗамена = Ложь) Экспорт

	ПроверитьПользователя(Пользователь);
	ПолучитьПользователяИБ(Пользователь);
	DR_Validation.ПроверитьТипБулево(РазрешенаЗамена, "РазрешенаЗамена");
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.DR_НастройкиМобильныхДокументов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		Настройки = ПрочитатьНастройкиПользователя(Пользователь);
		СтарыйСетевой = "";
		СтарыйФайловый = "";
		Если Настройки <> Неопределено Тогда
			СтарыйСетевой = Настройки.Токен;
			СтарыйФайловый = Настройки.ФайловыйТокен;
		КонецЕсли;
		Если НЕ РазрешенаЗамена И (ЗначениеЗаполнено(СтарыйСетевой) ИЛИ ЗначениеЗаполнено(СтарыйФайловый)) Тогда
			ВызватьИсключение "Токены уже существуют. Подтвердите замену пары.";
		КонецЕсли;

		НовыйСетевой = СгенерироватьУникальныйТокен(СтарыйСетевой);
		НовыйФайловый = СгенерироватьУникальныйТокен(СтарыйФайловый, НовыйСетевой);
		Запись = РегистрыСведений.DR_НастройкиМобильныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.ТокенМобильногоДоступа = НовыйСетевой;
		Запись.ТокенФайловогоОбмена = НовыйФайловый;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьНастройкиОбмена(Пользователь, Разрешить, Адрес, Путь) Экспорт

	ПроверитьПользователя(Пользователь);
	DR_Validation.ПроверитьТипБулево(Разрешить, "Разрешить");
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		ВызватьИсключение "Адрес публикации должен быть строкой.";
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Если НЕ ПустаяСтрока(Адрес) Тогда
		ПроверитьАдресПубликации(Адрес);
	КонецЕсли;
	Путь = DR_MobileFiles.ПодготовитьКаталогиОбмена(Путь);
	Если СтрДлина(Путь) > 250 Тогда
		ВызватьИсключение "Длина пути хранилища не должна превышать 250 символов.";
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.DR_НастройкиМобильныхДокументов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		DR_MobileFolderImport.ПроверитьРазделениеКаталогов(DR_MobileFiles.ПутьВнутри(Путь, "Incoming"));
		ПрочитатьНастройкиПользователя(Пользователь);
		Запись = РегистрыСведений.DR_НастройкиМобильныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.Прочитать();
		Запись.ИдентификаторПользователя = "";
		Запись.Пользователь = Пользователь;
		Запись.РазрешенМобильныйОбмен = Разрешить;
		Запись.ПутьКПапке = Путь;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
		Константы.DR_АдресПубликацииМобильногоОбмена.Установить(Адрес);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьПутьХранилища(Пользователь) Экспорт

	ПроверитьПользователя(Пользователь);
	Настройки = ПрочитатьНастройкиПользователя(Пользователь);
	Если Настройки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Настройки.ПутьКПапке;

КонецФункции

Процедура СохранитьПутьХранилища(Пользователь, Путь) Экспорт

