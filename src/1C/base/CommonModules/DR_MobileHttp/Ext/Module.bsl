Функция ОбработатьPOST(Запрос) Экспорт

	Возврат Обработать(Запрос, Истина);

КонецФункции

Функция ОбработатьGET(Запрос) Экспорт

	Возврат Обработать(Запрос, Ложь);

КонецФункции

Функция ОбработатьИнформациюGET(Запрос) Экспорт

	Контекст = Новый Структура("document_id,Код,КодОшибки,request_id",
		Неопределено, 500, "internal_error", НРег(Строка(Новый УникальныйИдентификатор)));
	Попытка
		ПроверитьДиагностическийGET(Запрос, Контекст);
		Возврат ОтветJSON(200, ИнформацияОСервере(), Контекст.request_id);
	Исключение
		Возврат СформироватьОтветОшибки(Контекст);
	КонецПопытки;

КонецФункции

Функция ОбработатьПроверкуПользователяGET(Запрос) Экспорт

	Контекст = Новый Структура("document_id,Код,КодОшибки,request_id",
		Неопределено, 500, "internal_error", НРег(Строка(Новый УникальныйИдентификатор)));
	Попытка
		ПроверитьДиагностическийGET(Запрос, Контекст);
		ПользовательИБ = АвторизоватьЗапрос(Запрос, Контекст);
		Тело = Новый Структура("authorized,username", Истина, ПользовательИБ.Имя);
		Возврат ОтветJSON(200, Тело, Контекст.request_id);
	Исключение
		Возврат СформироватьОтветОшибки(Контекст);
	КонецПопытки;

КонецФункции

Функция ИнформацияОСервере()

	Возврат Новый Структура("application,server_version,protocol_version,min_supported_protocol",
		"DoRIS", "0.2 beta", 2, 2);

КонецФункции

Процедура ПроверитьДиагностическийGET(Запрос, Контекст)

	Если Запрос.HTTPМетод <> "GET" ИЛИ Запрос.ПараметрыЗапроса.Количество() <> 0
		ИЛИ Заголовок(Запрос, "transfer-encoding") <> ""
		ИЛИ (Заголовок(Запрос, "content-length") <> ""
		И Заголовок(Запрос, "content-length") <> "0") Тогда
		Отклонить(Контекст, 400, "invalid_request");
	КонецЕсли;

КонецПроцедуры

Функция Обработать(Запрос, ЭтоPOST)

	Контекст = Новый Структура("document_id,Код,КодОшибки,request_id",
		Неопределено, 500, "internal_error", НРег(Строка(Новый УникальныйИдентификатор)));
	НачатьЗамеры(Контекст, ЭтоPOST);
	Попытка
		Если Запрос.HTTPМетод <> ?(ЭтоPOST, "POST", "GET") Тогда
			Отклонить(Контекст, 400, "invalid_request");
		КонецЕсли;
		ЭтапЗамера(Контекст, "authorization");
		АвторизоватьЗапрос(Запрос, Контекст);
		ЭтапЗамера(Контекст, "multipart");
		Если Запрос.ПараметрыЗапроса.Количество() <> 0 Тогда
			Отклонить(Контекст, 400, "invalid_request");
		КонецЕсли;
		Если НРег(СокрЛП(Заголовок(Запрос, "accept"))) <> "application/json" Тогда
			Отклонить(Контекст, 400, "invalid_request");
		КонецЕсли;
		Если ЭтоPOST Тогда
			Документ = DR_MobileMultipart.ПрочитатьЗапрос(Запрос, Контекст);
			ЭтапЗамера(Контекст, "uuid_lookup");
			Квитанция = DR_MobileStorage.ПроверитьПовтор(Документ, Контекст);
			Если Квитанция <> Неопределено Тогда
				ЭтапЗамера(Контекст, "response");
				Возврат ЗавершитьЗамеры(ОтветJSON(200, Квитанция, Контекст.request_id), Контекст);
			КонецЕсли;
			ЭтапЗамера(Контекст, "binary_preparation");
			DR_MobileFiles.ПодготовитьОригиналы(Документ, Контекст);
			ЭтапЗамера(Контекст, "storage");
			Результат = DR_MobileStorage.Зарегистрировать(Документ, Контекст);
			ЭтапЗамера(Контекст, "response");
			Ответ = ОтветJSON(Результат.Код, Результат.Квитанция, Контекст.request_id);
			Если Результат.Код = 201 Тогда

				Ответ.Заголовки.Вставить("Location", "documents/" + Документ.document_id);
			КонецЕсли;
			Возврат ЗавершитьЗамеры(Ответ, Контекст);
		Иначе
			Идентификатор = Запрос.ПараметрыURL.Получить("uuid");
			Если НЕ DR_Validation.КорректныйUUID(Идентификатор) Тогда
				Отклонить(Контекст, 400, "invalid_request");
			КонецЕсли;
			Контекст.document_id = Идентификатор;
			Если Заголовок(Запрос, "transfer-encoding") <> ""
				ИЛИ (Заголовок(Запрос, "content-length") <> ""
				И Заголовок(Запрос, "content-length") <> "0") Тогда
				Отклонить(Контекст, 400, "invalid_request");
			КонецЕсли;
			Квитанция = DR_MobileStorage.ПолучитьКвитанцию(Контекст, Идентификатор);
			Если Квитанция = Неопределено Тогда
				Отклонить(Контекст, 404, "document_not_found");
			КонецЕсли;
			Возврат ОтветJSON(200, Квитанция, Контекст.request_id);
		КонецЕсли;
	Исключение
		ЭтапЗамера(Контекст, "response");
		Возврат ЗавершитьЗамеры(СформироватьОтветОшибки(Контекст), Контекст);
	КонецПопытки;

КонецФункции

Функция АвторизоватьЗапрос(Запрос, Контекст)

	Токен = Заголовок(Запрос, "x-doris-token");
	Если Токен = "" Тогда
		Отклонить(Контекст, 401, "authentication_required");
	КонецЕсли;
	Если НЕ DR_MobileSettings.КорректныйТокенМобильногоДоступа(Токен) Тогда
		Отклонить(Контекст, 401, "invalid_token");
	КонецЕсли;
	Пользователь = DR_MobileSettings.НайтиПользователяПоТокену(Токен);
	Токен = Неопределено;
	Если Пользователь = Неопределено Тогда
		Отклонить(Контекст, 401, "invalid_token");
	КонецЕсли;
	Контекст.Вставить("Пользователь", Пользователь);
	Попытка
		ПользовательИБ = DR_MobileSettings.ПолучитьПользователяИБ(Пользователь);
	Исключение
		Отклонить(Контекст, 401, "invalid_token");
	КонецПопытки;
	Контекст.Вставить("ИдентификаторПользователяИБ", НРег(Строка(ПользовательИБ.УникальныйИдентификатор)));
	ПроверитьДоступ(Контекст);
	Возврат ПользовательИБ;

КонецФункции

Функция СформироватьОтветОшибки(Контекст)

	ЗаписатьДиагностику(Контекст);
	Статус = "rejected";
	Если Контекст.Код = 404 Тогда
		Статус = "not_found";
	ИначеЕсли Контекст.Код = 409 Тогда
		Статус = "conflict";
	ИначеЕсли Контекст.Код >= 500 Тогда
		Статус = "error";
	КонецЕсли;
	Тело = Новый Структура("accepted,document_id,status,error,request_id",
		Ложь, Контекст.document_id, Статус,
		Новый Структура("code,message", Контекст.КодОшибки, СообщениеОшибки(Контекст.КодОшибки)),
		Контекст.request_id);
	Ответ = ОтветJSON(Контекст.Код, Тело, Контекст.request_id);
	Если Контекст.Код = 503 ИЛИ Контекст.Код = 429 Тогда
		Ответ.Заголовки.Вставить("Retry-After", "3");
	КонецЕсли;
	Возврат Ответ;

КонецФункции

Процедура ЗаписатьДиагностику(Контекст)

	Попытка
		ЗаписьЖурналаРегистрации("DoRIS.MobileHTTP", УровеньЖурналаРегистрации.Ошибка,,,
			"request_id=" + Контекст.request_id + "; code=" + Контекст.КодОшибки);
	Исключение

		Возврат;
	КонецПопытки;

КонецПроцедуры

Процедура ПроверитьДоступ(Контекст) Экспорт

	Попытка
		Разрешено = DR_MobileSettings.РазрешенМобильныйДоступПользователю(Контекст.Пользователь);
	Исключение
		Отклонить(Контекст, 403, "mobile_access_denied");
	КонецПопытки;
	Если НЕ Разрешено Тогда
		Отклонить(Контекст, 403, "mobile_access_denied");
	КонецЕсли;
	Попытка
		ПользовательИБ = DR_MobileSettings.ПолучитьПользователяИБ(Контекст.Пользователь);
		Если НРег(Строка(ПользовательИБ.УникальныйИдентификатор)) <> Контекст.ИдентификаторПользователяИБ Тогда
			Отклонить(Контекст, 401, "invalid_token");
		КонецЕсли;
	Исключение
		Отклонить(Контекст, 401, "invalid_token");
	КонецПопытки;
	Попытка
		ЕстьСеанс = DR_MobileSettings.ЕстьИнтерактивныйСеанс(ПользовательИБ.УникальныйИдентификатор);
	Исключение
		Отклонить(Контекст, 503, "session_check_unavailable");
	КонецПопытки;
	Если НЕ ЕстьСеанс Тогда
		Отклонить(Контекст, 403, "user_session_required");
	КонецЕсли;

КонецПроцедуры

Процедура Отклонить(Контекст, Код, КодОшибки) Экспорт

	Контекст.Код = Код;
	Контекст.КодОшибки = КодОшибки;
	ВызватьИсключение "DoRIS mobile request rejected";

КонецПроцедуры

Функция Заголовок(Запрос, Имя) Экспорт

	Значение = "";
	Найден = Ложь;
	Для Каждого Пара Из Запрос.Заголовки Цикл
		Если НРег(Пара.Ключ) = Имя Тогда
			Если Найден Тогда
				Возврат "!duplicate!";
			КонецЕсли;
			Значение = Пара.Значение;
			Найден = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;

КонецФункции

Функция ОтветJSON(Код, Тело, ИдентификаторЗапроса)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);
	Текст = Запись.Закрыть();
	Если ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Размер() > 65536 Тогда
		ВызватьИсключение "Receipt exceeds response limit";
	КонецЕсли;
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("X-Request-Id", ИдентификаторЗапроса);
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;

КонецФункции

Функция СообщениеОшибки(Код)

	Если Код = "authentication_required" Тогда
		Возврат "Требуется токен мобильного доступа.";
	ИначеЕсли Код = "invalid_token" Тогда
		Возврат "Недействительный токен мобильного доступа.";
	ИначеЕсли Код = "user_session_required" Тогда
		Возврат "Откройте интерактивный сеанс 1С.";
	ИначеЕсли Код = "session_check_unavailable" Тогда
		Возврат "Проверка сеансов временно недоступна.";
	ИначеЕсли Код = "mobile_access_denied" Тогда
		Возврат "Мобильный доступ запрещён.";
	ИначеЕсли Код = "invalid_request" Тогда
		Возврат "Некорректная структура запроса.";
	ИначеЕсли Код = "document_not_found" Тогда
		Возврат "Документ не найден.";
	ИначеЕсли Код = "uuid_content_conflict" Тогда
		Возврат "UUID уже использован для другого содержимого.";
	ИначеЕсли Код = "content_length_required" Тогда
		Возврат "Требуется Content-Length.";
	ИначеЕсли Код = "size_limit_exceeded" Тогда
		Возврат "Превышен допустимый размер документа.";
	ИначеЕсли Код = "unsupported_media_type" Тогда
		Возврат "Формат не поддерживается.";
	ИначеЕсли Код = "invalid_file" Тогда
		Возврат "Файл не прошёл проверку.";
	ИначеЕсли Код = "temporarily_unavailable" Тогда
		Возврат "Операция временно недоступна.";
	ИначеЕсли Код = "rate_limited" Тогда
		Возврат "Превышена частота запросов.";
	КонецЕсли;
	Возврат "Не удалось завершить операцию.";

КонецФункции

Функция ДиагностикаВремениВключена()

	Возврат Ложь;

КонецФункции

Процедура НачатьЗамеры(Контекст, ЭтоPOST)

	Если НЕ ЭтоPOST ИЛИ НЕ ДиагностикаВремениВключена() Тогда
		Возврат;
	КонецЕсли;
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Контекст.Вставить("Замеры", Новый Структура("Начало,Метка,Этап,Этапы,СкачокЧасов",
		Сейчас, Сейчас, "overhead", Новый Соответствие, Ложь));

КонецПроцедуры

Процедура ЭтапЗамера(Контекст, Имя) Экспорт

	Если НЕ Контекст.Свойство("Замеры") Тогда
		Возврат;
	КонецЕсли;
	Замеры = Контекст.Замеры;
	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Длительность = Сейчас - Замеры.Метка;
	Если Длительность < 0 Тогда
		Замеры.СкачокЧасов = Истина;
	КонецЕсли;
	Накоплено = Замеры.Этапы.Получить(Замеры.Этап);
	Если Накоплено = Неопределено Тогда
		Накоплено = 0;
	КонецЕсли;
	Замеры.Этапы.Вставить(Замеры.Этап, Накоплено + Длительность);
	Замеры.Метка = Сейчас;
	Замеры.Этап = Имя;

КонецПроцедуры

Функция ЗавершитьЗамеры(Ответ, Контекст)

	Если НЕ Контекст.Свойство("Замеры") Тогда
		Возврат Ответ;
	КонецЕсли;
	ЭтапЗамера(Контекст, "finished");
	Замеры = Контекст.Замеры;

	Текст = "request_id=" + Контекст.request_id + "; clock=utc_wall_ms; total_ms="
		+ Формат(Замеры.Метка - Замеры.Начало, "ЧГ=0; ЧДЦ=0")
		+ "; clock_adjusted=" + ?(Замеры.СкачокЧасов, "true", "false");
	Для Каждого Этап Из Замеры.Этапы Цикл
		Текст = Текст + "; " + Этап.Ключ + "_ms=" + Формат(Этап.Значение, "ЧГ=0; ЧДЦ=0");
	КонецЦикла;
	Попытка
		ЗаписьЖурналаРегистрации("DoRIS.MobileHTTP.Timing", УровеньЖурналаРегистрации.Информация,,, Текст);
	Исключение

		Возврат Ответ;
	КонецПопытки;
	Возврат Ответ;

КонецФункции
