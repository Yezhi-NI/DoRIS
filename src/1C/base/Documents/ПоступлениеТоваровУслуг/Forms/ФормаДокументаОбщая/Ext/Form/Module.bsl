&После("ПриСозданииНаСервере")
&НаСервере
Процедура DR_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Команда = Команды.Добавить("DR_ЗаполнитьDoRIS");
	Команда.Заголовок = "Заполнить DoRIS";
	Команда.Действие  = "DR_КомандаЗаполнитьDoRIS";
	Команда.Картинка = БиблиотекаКартинок.DR_ОбщаяКартинка64;
	Команда.Подсказка = "Заполнить DoRIS";

	ЭлементОриентир = Элементы.Найти("ТоварыЗаполнить");
	РодительскаяГруппа = Элементы.Товары.КоманднаяПанель;
	НоваяКнопка = ЭтаФорма.Элементы.Вставить("DR_ЗаполнитьDoRIS", Тип("КнопкаФормы"), РодительскаяГруппа, ЭлементОриентир);
	НоваяКнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;

	НоваяКнопка.Отображение = ОтображениеКнопки.Картинка;
	НоваяКнопка.ИмяКоманды = "DR_ЗаполнитьDoRIS";

КонецПроцедуры

&НаКлиенте
Процедура DR_КомандаЗаполнитьDoRIS(Команда)

	Если Параметры.Ключ.Пустая() Тогда
		ТекстСообщения = "Перед заполнением необходимо записать объект.";
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текстсообщения);
		Возврат;
	КонецЕсли;

	ФормаОбработки = ПолучитьФорму("Обработка.DR_РаспознаваниеДокументов.Форма.Форма",,);

	Если ФормаОбработки.Открыта() Тогда
		ФормаОбработки.Закрыть();
	КонецЕсли;

	ПараметрыНовойФормы =  Новый Структура;
	ПараметрыНовойФормы.Вставить("ОбъектЗаполнения", Объект.Ссылка);
	ПараметрыНовойФормы.Вставить("ТипОбъекта", "Поступление");
	ОписаниеОповещения = Новый ОписаниеОповещения("DR_ПослеЗакрытияФормыDR", ЭтаФорма);
	ОткрытьФорму("Обработка.DR_РаспознаваниеДокументов.Форма.Форма", ПараметрыНовойФормы,,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура DR_ПослеЗакрытияФормыDR(РезультатФормы, ДополнительныеПараметры) Экспорт

	ЭтотОбъект.Прочитать();
	ЗаполнитьДобавленныеКолонкиТаблиц();
	ОбновитьИтоги(ЭтаФорма);

КонецПроцедуры
