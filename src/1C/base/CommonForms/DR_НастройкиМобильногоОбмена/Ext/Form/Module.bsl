#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресПубликации = DR_MobileSettings.ПолучитьАдресПубликации();
	ЗагрузитьПользователяНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПользовательПриИзменении(Элемент)

	СкрытьПоляНаКлиенте();
	СетевойТокен = "";
	ФайловыйТокен = "";
	ПутьХранилища = "";
	РазрешенОбмен = Ложь;
	РезультатИмпорта = "";
	ЗагрузитьПользователяНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура НастройкиПриИзменении(Элемент)

	СкрытьПоляНаКлиенте();
	СкрытьСекретыНаСервере();

КонецПроцедуры

#КонецОбласти

#Область КомандыФормы

&НаКлиенте
Процедура СгенерироватьТокены(Команда)

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		ПоказатьПредупреждение(, "Выберите пользователя.");
		Возврат;
	КонецЕсли;
	СкрытьПоляНаКлиенте();
	СкрытьСекретыНаСервере();
	Если ЕстьТокеныНаСервере() Тогда
		ПодтвердитьДействие("Сгенерировать", "Заменить оба токена? Устройства потребуется настроить заново; пакеты со старым файловым токеном перестанут приниматься.");
	Иначе
		ВыполнитьДействиеНаСервере(Пользователь, "Сгенерировать", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСетевойТокен(Команда)

	ПодтвердитьДействие("ОчиститьСетевой", "Очистить только сетевой токен? Прежний сетевой токен перестанет работать.");

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьФайловыйТокен(Команда)

	ПодтвердитьДействие("ОчиститьФайловый", "Очистить только файловый токен? Пакеты с прежним файловым токеном перестанут приниматься.");

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьДействие(Действие, Вопрос)

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	СкрытьПоляНаКлиенте();
	СкрытьСекретыНаСервере();
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтверждения", ЭтотОбъект,
		Новый Структура("Пользователь,Действие", Пользователь, Действие)),
		Вопрос, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтверждения(Результат, Параметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Если Пользователь <> Параметры.Пользователь Тогда
		ПоказатьПредупреждение(, "Выбран другой пользователь. Повторите команду.");
		Возврат;
	КонецЕсли;
	ВыполнитьДействиеНаСервере(Параметры.Пользователь, Параметры.Действие, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСетевойТокен(Команда)

	Элементы.СетевойТокен.РежимПароля = НЕ Элементы.СетевойТокен.РежимПароля;
	Элементы.ПоказатьСетевойТокен.Заголовок = ?(Элементы.СетевойТокен.РежимПароля, "Показать", "Скрыть");

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФайловыйТокен(Команда)

	Элементы.ФайловыйТокен.РежимПароля = НЕ Элементы.ФайловыйТокен.РежимПароля;
	Элементы.ПоказатьФайловыйТокен.Заголовок = ?(Элементы.ФайловыйТокен.РежимПароля, "Показать", "Скрыть");

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)

	СкрытьПоляНаКлиенте();
	СохранитьНаСервере();
	//Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьQR(Команда)

	СкрытьПоляНаКлиенте();
	Если НЕ СформироватьQRНаСервере() Тогда
		ПоказатьПредупреждение(, "Формирование изображения QR-кода пока недоступно.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИмпортироватьФайлы(Команда)

	СкрытьПоляНаКлиенте();
	ИмпортироватьФайлыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоляНаКлиенте()

	Элементы.СетевойТокен.РежимПароля = Истина;
	Элементы.ФайловыйТокен.РежимПароля = Истина;
	Элементы.ПоказатьСетевойТокен.Заголовок = "Показать";
	Элементы.ПоказатьФайловыйТокен.Заголовок = "Показать";
	Элементы.АдресQR.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПутьХранилищаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка) 
	
	ЗаполнитьКаталог();
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьКаталог()
	
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога; 
	ДиалогОткрытия = Новый ДиалогВыбораФайла(Режим); 
	ДиалогОткрытия.Каталог = ""; 
	ДиалогОткрытия.МножественныйВыбор = Ложь; 
	ДиалогОткрытия.Заголовок = "Выберите каталог"; 

	Если ДиалогОткрытия.Выбрать() Тогда 
		ПутьХранилища = ДиалогОткрытия.Каталог; 
	КонецЕсли; 
	
КонецПроцедуры


#КонецОбласти

#Область СерверныеОперации

&НаСервере
Функция ЕстьТокеныНаСервере()

	Настройки = DR_MobileSettings.ПолучитьНастройкиАдминистрирования(Пользователь);
	Возврат ЗначениеЗаполнено(Настройки.Токен) ИЛИ ЗначениеЗаполнено(Настройки.ФайловыйТокен);

КонецФункции

&НаСервере
Процедура ВыполнитьДействиеНаСервере(ВыбранныйПользователь, Действие, Подтверждено)

	Если Пользователь <> ВыбранныйПользователь Тогда
		ВызватьИсключение "Выбран другой пользователь.";
	КонецЕсли;
	СкрытьСекретыНаСервере();
	Если Действие = "Сгенерировать" Тогда
		DR_MobileSettings.СгенерироватьПаруТокенов(ВыбранныйПользователь, Подтверждено);
	ИначеЕсли Действие = "ОчиститьСетевой" И Подтверждено Тогда
		DR_MobileSettings.ОтозватьТокенМобильногоДоступа(ВыбранныйПользователь);
	ИначеЕсли Действие = "ОчиститьФайловый" И Подтверждено Тогда
		DR_MobileSettings.УправлятьФайловымТокеном(ВыбранныйПользователь, "Отозвать");
	Иначе
		ВызватьИсключение "Действие не подтверждено или неизвестно.";
	КонецЕсли;

	ОбновитьТокеныНаСервере();

КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере()

	СкрытьСекретыНаСервере();
	DR_MobileSettings.СохранитьНастройкиОбмена(Пользователь, РазрешенОбмен, АдресПубликации, ПутьХранилища);
	АдресПубликации = DR_MobileSettings.ПолучитьАдресПубликации();
	ЗагрузитьПользователяНаСервере();

КонецПроцедуры

&НаСервере
Функция СформироватьQRНаСервере()

	СкрытьСекретыНаСервере();
	Если НЕ НастройкиСохраненыНаСервере() Тогда
		ВызватьИсключение "Сначала сохраните настройки выбранного пользователя.";
	КонецЕсли;
	ДанныеQR = DR_MobileSettings.ПолучитьИзображениеНастроекQR(Пользователь, АдресПубликации);
	Если ДанныеQR = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	АдресQR = ПоместитьВоВременноеХранилище(ДанныеQR, УникальныйИдентификатор);
	Элементы.АдресQR.Видимость = Истина;
	Возврат Истина;

КонецФункции

&НаСервере
Процедура ИмпортироватьФайлыНаСервере()

	СкрытьСекретыНаСервере();
	Если НЕ НастройкиСохраненыНаСервере() Тогда
		РезультатИмпорта = "Сначала сохраните настройки и папку DoRIS выбранного пользователя.";
		Возврат;
	КонецЕсли;
	Попытка
		Итог = DR_MobileFolderImport.Импортировать(Пользователь);
		РезультатИмпорта = "Обработано: " + Формат(Итог.Обработано, "ЧГ=0")
			+ "; принято: " + Формат(Итог.Принято, "ЧГ=0")
			+ "; повторов: " + Формат(Итог.Повторов, "ЧГ=0")
			+ "; ошибок: " + Формат(Итог.Ошибок, "ЧГ=0")
			+ "; очищено пакетов: " + Формат(Итог.УдаленоПакетов, "ЧГ=0")
			+ "; осталось после приёма: " + Формат(Итог.ОсталосьПослеПриема, "ЧГ=0") + Символы.ПС + Итог.Сообщения;
	Исключение
		РезультатИмпорта = "Импорт не начат. Проверьте папку Incoming на сервере, права и отсутствие пересечения с Documents.";
	КонецПопытки;

КонецПроцедуры

&НаСервере
Функция НастройкиСохраненыНаСервере()

	Настройки = DR_MobileSettings.ПолучитьНастройкиАдминистрирования(Пользователь);
	Возврат Настройки.ПутьКПапке = ПутьХранилища И Настройки.Разрешено = РазрешенОбмен
		И АдресПубликации = DR_MobileSettings.ПолучитьАдресПубликации();

КонецФункции

&НаСервере
Процедура ЗагрузитьПользователяНаСервере()

	СкрытьСекретыНаСервере();
	СетевойТокен = "";
	ФайловыйТокен = "";
	ПутьХранилища = "";
	РазрешенОбмен = Ложь;
	РезультатИмпорта = "";
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Настройки = DR_MobileSettings.ПолучитьНастройкиАдминистрирования(Пользователь);
		РазрешенОбмен = Настройки.Разрешено;
		ПутьХранилища = Настройки.ПутьКПапке;
		СетевойТокен = Настройки.Токен;
		ФайловыйТокен = Настройки.ФайловыйТокен;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьТокеныНаСервере()

	СкрытьСекретыНаСервере();
	Настройки = DR_MobileSettings.ПолучитьНастройкиАдминистрирования(Пользователь);
	СетевойТокен = Настройки.Токен;
	ФайловыйТокен = Настройки.ФайловыйТокен;

КонецПроцедуры

&НаСервере
Процедура СкрытьСекретыНаСервере()

	Если ЭтоАдресВременногоХранилища(АдресQR) Тогда
		УдалитьИзВременногоХранилища(АдресQR);
	КонецЕсли;
	АдресQR = "";
	Элементы.АдресQR.Видимость = Ложь;
	Элементы.СетевойТокен.РежимПароля = Истина;
	Элементы.ФайловыйТокен.РежимПароля = Истина;
	Элементы.ПоказатьСетевойТокен.Заголовок = "Показать";
	Элементы.ПоказатьФайловыйТокен.Заголовок = "Показать";

КонецПроцедуры

#КонецОбласти
