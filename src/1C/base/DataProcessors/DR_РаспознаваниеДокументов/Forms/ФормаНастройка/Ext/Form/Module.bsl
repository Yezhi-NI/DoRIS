&НаСервере
Процедура DR_ПрочитатьНаСервере()

	Если ЗначениеЗаполнено(Провайдер) Тогда
		
	    ПолучитьНастройкиПровайдераПоУмолчанию();
	
		Выборка = РегистрыСведений.DR_НастройкиАдаптера.Выбрать(Новый Структура("Провайдер", Провайдер));
		Если Выборка.Следующий() Тогда
			Запись = Выборка.ПолучитьМенеджерЗаписи();
			Запись.Прочитать();
			Если Выборка.Следующий() Тогда
				ВызватьИсключение "В настройках OCR найдено несколько записей провайдера. Требуется ручное устранение дубликатов.";
			КонецЕсли;
			Если ЗначениеЗаполнено(Запись.АдресСервиса) Тогда
				АдресСервиса = Запись.АдресСервиса;
			КонецЕсли;
			Если Запись.Порт > 0 Тогда
				Порт = Запись.Порт;
			КонецЕсли;
			Если Запись.Таймаут > 0 Тогда
				Таймаут = Запись.Таймаут;
			КонецЕсли;
			Если ЗначениеЗаполнено(Запись.АдресРесурса) Тогда
				АдресРесурса = Запись.АдресРесурса;
			КонецЕсли;
            Если ЗначениеЗаполнено(Запись.ApiKey) Тогда
				ApiKey = Запись.ApiKey;
			КонецЕсли;
			Если ЗначениеЗаполнено(Запись.Промпт) Тогда
				Промпт = Запись.Промпт;
			КонецЕсли;	
		КонецЕсли;
		Возврат;
		
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//ЗаполнитьТипыАдаптеровНаСервере();
	Провайдер = Константы.DR_АктивныйАдаптер.Получить();
	DR_ПрочитатьНаСервере();
	ПоказатьТабличныйДокумент = Константы.DR_ПоказатьТабличныйДокумент.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПровайдерПриИзменении(Элемент)
	
	АдресСервиса = "";
	АдресРесурса = "";
	Порт 		 = ""; 
	Таймаут 	 = "";
	ApiKey 		 = "";
	
	DR_ПрочитатьНаСервере();
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Если НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Возврат;
	КонецЕсли;
	
	ЛокальныйПровайдер = (Провайдер = "LocalPaddleOCR");
	Элементы.ApiKey.Видимость = НЕ ЛокальныйПровайдер;
	Элементы.АдресСервиса.ТолькоПросмотр = НЕ ЛокальныйПровайдер; 
	Элементы.АдресРесурса.ТолькоПросмотр = НЕ ЛокальныйПровайдер;
	Элементы.Порт.ТолькоПросмотр = НЕ ЛокальныйПровайдер;	
	
	Элементы.ГруппаПропмт.Видимость = (Провайдер = "MistralOCR");
	ТекстОписание = ПолучитьТекстИзМакета("ТекПараметр" + Провайдер);
	Элементы.MistralPrompt.Видимость = Ложь; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.MistralPrompt.Заголовок = ПолучитьТекстИзМакета("MistralPrompt");
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры  

&НаСервере
Функция ПолучитьТекстИзМакета(ТекПараметр)
	
	Макет = Обработки.DR_РаспознаваниеДокументов.ПолучитьМакет("МакетТекст");
	Если НЕ Макет.Области.Найти(ТекПараметр) = Неопределено Тогда
		Возврат Макет.Области[ТекПараметр].Текст;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПримерПромпта(Команда)
	Элементы.MistralPrompt.Видимость = НЕ Элементы.MistralPrompt.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура ТекстОписаниеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СсылкаНаРесурс = "";
	СтандартнаяОбработка = Ложь;
	ДанныеСобытия.Свойство("href", СсылкаНаРесурс);
	Если Не ЗначениеЗаполнено(СсылкаНаРесурс) Тогда
            Возврат;
	КонецЕсли; 
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(СсылкаНаРесурс);	
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкиПровайдераПоУмолчанию()
	
	Если ЗначениеЗаполнено(Провайдер) Тогда	
		Если Провайдер = "MistralOCR" Тогда
			АдресСервиса = "api.mistral.ai";
			АдресРесурса = "/v1/ocr";
			Порт 		 = 0; 
		ИначеЕсли Провайдер = "PaddleOCR" Тогда
			АдресСервиса = "paddleocr.aistudio-app.com";
			АдресРесурса = "/api/v2/ocr/jobs";
			Порт 		 = 0; 
		ИначеЕсли Провайдер = "LocalPaddleOCR" Тогда
			АдресСервиса = "127.0.0.1";
			АдресРесурса = "/ocr";
			Порт = 8765;
			Таймаут = 180;
			ApiKey = "";
			Промпт = "";
		Конецесли;
	КонецЕсли;
	
КонецПроцедуры

