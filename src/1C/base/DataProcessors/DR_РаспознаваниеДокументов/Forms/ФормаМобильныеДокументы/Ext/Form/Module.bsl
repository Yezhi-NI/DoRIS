&НаСервереБезКонтекста
Функция ИмпортироватьНаСервере(ПользовательИсточника)

	КонтекстДоступа();
	Если НЕ ЗначениеЗаполнено(ПользовательИсточника) Тогда
		ВызватьИсключение "Для импорта выберите пользователя в отборе: его сохранённая папка задаёт источник Incoming.";
	КонецЕсли;
	Попытка
		Итог = DR_MobileFolderImport.Импортировать(ПользовательИсточника);
	Исключение
		Возврат "Импорт не начат. Проверьте сохранённую папку Incoming на сервере, права и отсутствие пересечения с Documents.";
	КонецПопытки;
	Текст = ?(Итог.Принято = 0, "Новых документов нет. ", "")
		+ "Обработано: " + Формат(Итог.Обработано, "ЧГ=0")
		+ "; принято: " + Формат(Итог.Принято, "ЧГ=0")
		+ "; повторов: " + Формат(Итог.Повторов, "ЧГ=0")
		+ "; ошибок: " + Формат(Итог.Ошибок, "ЧГ=0")
		+ "; очищено пакетов: " + Формат(Итог.УдаленоПакетов, "ЧГ=0")
		+ "; осталось после приёма: " + Формат(Итог.ОсталосьПослеПриема, "ЧГ=0");
	Возврат Текст + Символы.ПС + Итог.Сообщения;

