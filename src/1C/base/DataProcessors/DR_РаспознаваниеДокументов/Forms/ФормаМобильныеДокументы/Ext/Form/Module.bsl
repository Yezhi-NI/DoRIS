&НаКлиенте
Перем ФормаСозданияПоступления;

&НаКлиенте
Перем КонтекстСозданияПоступления;

#Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Контекст = КонтекстДоступа();
	Элементы.ОтборПользователь.Доступность = Истина;
	Элементы.Импорт.Доступность = Истина;
	Элементы.Распознать.Доступность = Ложь;
	Элементы.ЗаполнитьДокумент.Доступность = Ложь;
	ОтборПользователь = Контекст.Пользователь;
	ПоУбыванию = Ложь;
	ПолеСортировки = "";
	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Процедура Импорт(Команда)

	РезультатИмпорта = ИмпортироватьНаСервере(ОтборПользователь);
	ОбновитьНаСервере();
	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Асинх Процедура Распознать(Команда)

	Если РаспознаваниеВыполняется Тогда
		Возврат;
	КонецЕсли;
	ВыбраннаяСтрока = ЕдинственнаяВыбраннаяСтрока();
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Владелец = ВыбраннаяСтрока.ИдентификаторПользователя;
	UUIDМобильногоДокумента = ВыбраннаяСтрока.UUIDДокумента;
	УстановитьВыполнениеРаспознавания(Истина);
	Ответ = Неопределено;
	Попытка
		Ответ = РаспознатьНаСервере(Владелец, UUIDМобильногоДокумента, Ложь);
		Если Ответ.Статус = "confirmation" Тогда
			Решение = Ждать ВопросАсинх("Документ остался в состоянии «Распознается». Повторить вручную? Действующая обработка другого сеанса не будет прервана.", РежимДиалогаВопрос.ДаНет);
			Если Решение = КодВозвратаДиалога.Да Тогда
				Ответ = РаспознатьНаСервере(Владелец, UUIDМобильногоДокумента, Истина);
			КонецЕсли;
		КонецЕсли;
		Если Ответ.Статус <> "confirmation" Тогда
			СтатусОперации = Ответ.Сообщение;
			Если НЕ ПустаяСтрока(Ответ.Сообщение) Тогда
				Сообщить(Ответ.Сообщение);
			КонецЕсли;
		Иначе
			СтатусОперации = "Повторное распознавание отменено.";
		КонецЕсли;
	Исключение
		СтатусОперации = ОписаниеОшибки();
		Сообщить(СтатусОперации);
	КонецПопытки;

	Попытка
		ОбновитьНаСервере();
	Исключение
		Сообщить("Не удалось обновить список: " + ОписаниеОшибки());
	КонецПопытки;
	УстановитьВыполнениеРаспознавания(Ложь);
	Если Ответ <> Неопределено Тогда
		Если Ответ.Статус = "success" Тогда
			Попытка
				Ответ.ТабДокумент.Показать();
			Исключение
				Сообщить("Распознавание завершено, но результат не удалось открыть: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)

	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура СортироватьСписокПоКолонке(Команда)

	Если РаспознаваниеВыполняется Тогда Возврат; КонецЕсли;
	Колонка = Элементы.Список.ТекущийЭлемент;
	Если Колонка = Неопределено Тогда Возврат; КонецЕсли;
	СоответствияКолонок = Новый Соответствие;
	СоответствияКолонок.Вставить("СписокВыбор", "Выбор");
	СоответствияКолонок.Вставить("СписокФайл", "Файл");
	СоответствияКолонок.Вставить("СписокДатаПриема", "ДатаПриема");
	СоответствияКолонок.Вставить("СписокСостояние", "Состояние");
	СоответствияКолонок.Вставить("СписокКонтрагент", "Контрагент");
	СоответствияКолонок.Вставить("СписокДокумент1С", "Документ1С");
	СоответствияКолонок.Вставить("СписокВладелец", "Владелец");
	ИмяКолонки = СоответствияКолонок.Получить(Колонка.Имя);
	Если ИмяКолонки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	НовоеНаправление = ?(ПолеСортировки = ИмяКолонки, Не ПоУбыванию, Ложь);
	// Сортируется существующая коллекция: отборы, отметки и значения строк сохраняются.
	Список.Сортировать(ИмяКолонки + ?(НовоеНаправление, " Убыв", " Возр"));
	ПолеСортировки = ИмяКолонки;
	ПоУбыванию = НовоеНаправление;

КонецПроцедуры

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Процедура СписокВыборПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущаяСтрока.Выбор Тогда
		Для Каждого СтрокаСписка Из Список Цикл
			Если СтрокаСписка.UUIDДокумента <> ТекущаяСтрока.UUIDДокумента
				ИЛИ СтрокаСписка.ИдентификаторПользователя <> ТекущаяСтрока.ИдентификаторПользователя Тогда
				СтрокаСписка.Выбор = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Функция ЕдинственнаяВыбраннаяСтрока()

	Выбранная = Неопределено;
	Для Каждого СтрокаСписка Из Список Цикл
		Если НЕ СтрокаСписка.Выбор Тогда
			Продолжить;
		КонецЕсли;
		Если Выбранная <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Выбранная = СтрокаСписка;
	КонецЦикла;
	Возврат Выбранная;

КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьРаспознавания()

	МожноВыполнить = НЕ РаспознаваниеВыполняется И ЕдинственнаяВыбраннаяСтрока() <> Неопределено;
	Просмотр = РежимOCR = "Просмотр результата распознавания";
	Элементы.Распознать.Доступность = МожноВыполнить И Просмотр;
	Элементы.ЗаполнитьДокумент.Доступность = МожноВыполнить И НЕ Просмотр;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыполнениеРаспознавания(Выполняется)

	РаспознаваниеВыполняется = Выполняется;
	Элементы.ПанельДействий.Доступность = НЕ Выполняется;
	Элементы.Список.Доступность = НЕ Выполняется;
	Элементы.ОтборИСортировка.Доступность = НЕ Выполняется;
	Если Выполняется Тогда
		СтатусОперации = "Распознавание выполняется. Дождитесь ответа сервера.";
	КонецЕсли;
	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Процедура СписокКонтрагентПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СохранитьКонтрагентаСтроки(ТекущаяСтрока);

КонецПроцедуры

&НаКлиенте
Процедура СохранитьКонтрагентаСтроки(СтрокаСписка)

	Попытка
		СохранитьКонтрагентаНаСервере(СтрокаСписка.ИдентификаторПользователя,
			СтрокаСписка.UUIDДокумента, СтрокаСписка.Контрагент);
	Исключение
		Сообщить("Контрагент не сохранён. Проверьте права доступа и актуальность строки; список будет обновлён.");
		ОбновитьНаСервере();
	КонецПопытки;
	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Процедура СписокДокумент1СПриИзменении(Элемент)

	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		СохранитьДокументНаСервере(ТекущаяСтрока.ИдентификаторПользователя,
			ТекущаяСтрока.UUIDДокумента, ТекущаяСтрока.Документ1С);
	Исключение
		Сообщить("Связь с документом не сохранена: " + ОписаниеОшибки());
		ОбновитьНаСервере();
	КонецПопытки;
	ОбновитьДоступностьРаспознавания();

КонецПроцедуры

&НаКлиенте
Процедура СписокДокумент1СОткрытие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Ссылка = СвязанныйДокументНаСервере(ТекущаяСтрока.ИдентификаторПользователя, ТекущаяСтрока.UUIDДокумента);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОткрытьЗначение(Ссылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокумента

&НаКлиенте
Процедура ЗаполнитьДокумент(Команда)

	Если РаспознаваниеВыполняется Тогда
		Возврат;
	КонецЕсли;
	СтрокаДокумента = ЕдинственнаяВыбраннаяСтрока();
	Если СтрокаДокумента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст = Новый Структура("Владелец,UUIDДокумента,Документ1С,ВерсияДанных",
		СтрокаДокумента.ИдентификаторПользователя, СтрокаДокумента.UUIDДокумента, Неопределено, "");
	УстановитьВыполнениеРаспознавания(Истина);
	Попытка
		Подготовка = ПодготовитьЗаполнениеНаСервере(Контекст.Владелец, Контекст.UUIDДокумента);
		Если НЕ ЗначениеЗаполнено(Подготовка.Документ1С) Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияСозданияПоступления", ЭтотОбъект, Контекст),
				"Документ 1С не выбран. Создать новое поступление товаров и услуг?", РежимДиалогаВопрос.ДаНет,
				, КодВозвратаДиалога.Нет);
		Иначе
			ПодтвердитьЗаполнение(Контекст, Подготовка);
		КонецЕсли;
	Исключение
		ЗавершитьЗаполнениеНаКлиенте(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияСозданияПоступления(Результат, Контекст) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЗавершитьЗаполнениеНаКлиенте("Создание документа отменено.");
		Возврат;
	КонецЕсли;
	Попытка
		Подготовка = ПодготовитьЗаполнениеНаСервере(Контекст.Владелец, Контекст.UUIDДокумента);
		Если ЗначениеЗаполнено(Подготовка.Документ1С) Тогда
			ВызватьИсключение "Связь с поступлением изменена. Повторите команду для актуального документа.";
		КонецЕсли;
		КонтекстСозданияПоступления = Контекст;
		КонтекстСозданияПоступления.Вставить("СозданныйДокумент", Неопределено);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияСозданияПоступления", ЭтотОбъект);
		ФормаСозданияПоступления = ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.Форма.ФормаДокументаОбщая",
			, ЭтотОбъект, Строка(Новый УникальныйИдентификатор), , , Оповещение,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Исключение
		КонтекстСозданияПоступления = Неопределено;
		ФормаСозданияПоступления = Неопределено;
		ЗавершитьЗаполнениеНаКлиенте(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия <> "Запись_ПоступлениеТоваровУслуг"
		ИЛИ КонтекстСозданияПоступления = Неопределено ИЛИ ФормаСозданияПоступления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Источник) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если ФормаСозданияПоступления.Объект.Ссылка = Источник Тогда
			КонтекстСозданияПоступления.СозданныйДокумент = Источник;
		КонецЕсли;
	Исключение
		СтатусОперации = "Не удалось получить ссылку записанного поступления. Выберите его в колонке «Документ».";
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияСозданияПоступления(Результат, ДополнительныеПараметры) Экспорт

	Контекст = КонтекстСозданияПоступления;
	КонтекстСозданияПоступления = Неопределено;
	ФормаСозданияПоступления = Неопределено;
	Если Контекст = Неопределено Тогда
		ЗавершитьЗаполнениеНаКлиенте("Создание документа отменено.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Контекст.СозданныйДокумент) Тогда
		ЗавершитьЗаполнениеНаКлиенте("Документ не записан или его ссылка не получена. Распознавание не запускалось.");
		Возврат;
	КонецЕсли;
	Попытка
		Подготовка = СохранитьСозданноеПоступлениеНаСервере(Контекст.Владелец,
			Контекст.UUIDДокумента, Контекст.СозданныйДокумент);
		ПодтвердитьЗаполнение(Контекст, Подготовка);
	Исключение
		ЗавершитьЗаполнениеНаКлиенте(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьЗаполнение(Контекст, Подготовка)

	Контекст.Документ1С = Подготовка.Документ1С;
	Контекст.ВерсияДанных = Подготовка.ВерсияДанных;
	Если Подготовка.ЕстьТовары Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияОчисткиПоступления", ЭтотОбъект, Контекст),
			"Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет,
			, КодВозвратаДиалога.Нет);
	Иначе
		ВыполнитьЗаполнениеНаКлиенте(Контекст, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияОчисткиПоступления(Результат, Контекст) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЗавершитьЗаполнениеНаКлиенте("Заполнение отменено. Распознавание не запускалось.");
		Возврат;
	КонецЕсли;
	ВыполнитьЗаполнениеНаКлиенте(Контекст, Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнениеНаКлиенте(Контекст, ПодтвержденПовтор)

	Попытка
		Ответ = ЗаполнитьДокументНаСервере(Контекст.Владелец, Контекст.UUIDДокумента,
			Контекст.Документ1С, Контекст.ВерсияДанных, ПодтвержденПовтор);
		Если Ответ.Статус = "confirmation" Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПослеПодтвержденияПовтораЗаполнения", ЭтотОбъект, Контекст),
				"Документ остался в состоянии «Распознается». Повторить вручную? Действующая обработка другого сеанса не будет прервана.",
				РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
		ЗавершитьЗаполнениеНаКлиенте(Ответ.Сообщение);
	Исключение
		ЗавершитьЗаполнениеНаКлиенте(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеПодтвержденияПовтораЗаполнения(Результат, Контекст) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЗавершитьЗаполнениеНаКлиенте("Повторное распознавание отменено.");
		Возврат;
	КонецЕсли;
	ВыполнитьЗаполнениеНаКлиенте(Контекст, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьЗаполнениеНаКлиенте(Сообщение)

	СтатусОперации = Сообщение;
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		Сообщить(Сообщение);
	КонецЕсли;
	Попытка
		ОбновитьНаСервере();
	Исключение
		Сообщить("Не удалось обновить список. Проверьте состояние поступления перед повтором: " + ОписаниеОшибки());
	КонецПопытки;
	УстановитьВыполнениеРаспознавания(Ложь);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьЗаполнениеНаСервере(Знач ИдентификаторПользователя, Знач UUIDДокумента)

	ПроверитьКлючСтроки(ИдентификаторПользователя, UUIDДокумента);
	Если Константы.DR_ПоказатьТабличныйДокумент.Получить() Тогда
		ВызватьИсключение "Включён просмотр результата. Для заполнения измените общую настройку DoRIS.";
	КонецЕсли;
	СсылкаПоступления = DR_MobileStorage.СвязанныйДокументМобильногоДокумента(
		ИдентификаторПользователя, UUIDДокумента);
	Если НЕ ЗначениеЗаполнено(СсылкаПоступления) Тогда
		Возврат Новый Структура("Документ1С,ЕстьТовары,ВерсияДанных", СсылкаПоступления, Ложь, "");
	КонецЕсли;
	Возврат ПроверитьПоступлениеДляЗаполнения(СсылкаПоступления);

КонецФункции

&НаСервереБезКонтекста
Функция ПроверитьПоступлениеДляЗаполнения(Знач СсылкаПоступления)

	Если ТипЗнч(СсылкаПоступления) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
		ВызватьИсключение "Требуется ссылка на поступление товаров и услуг.";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СсылкаПоступления) Тогда
		ВызватьИсключение "Документ 1С не выбран.";
	КонецЕсли;
	Если НЕ ПравоДоступа("Изменение", Метаданные.Документы.ПоступлениеТоваровУслуг) Тогда
		ВызватьИсключение "Недостаточно прав на изменение поступления.";
	КонецЕсли;
	ЗапросПоступления = Новый Запрос(
		"ВЫБРАТЬ ПометкаУдаления, ВерсияДанных ИЗ Документ.ПоступлениеТоваровУслуг ГДЕ Ссылка = &Ссылка");
	ЗапросПоступления.УстановитьПараметр("Ссылка", СсылкаПоступления);
	ВыборкаПоступления = ЗапросПоступления.Выполнить().Выбрать();
	Если НЕ ВыборкаПоступления.Следующий() Тогда
		ВызватьИсключение "Поступление удалено или недоступно.";
	КонецЕсли;
	Если ВыборкаПоступления.ПометкаУдаления Тогда
		ВызватьИсключение "Поступление помечено на удаление.";
	КонецЕсли;
	ОбъектПоступления = СсылкаПоступления.ПолучитьОбъект();
	Возврат Новый Структура("Документ1С,ЕстьТовары,ВерсияДанных", СсылкаПоступления,
		ОбъектПоступления.Товары.Количество() > 0, ЗначениеВСтрокуВнутр(ВыборкаПоступления.ВерсияДанных));

КонецФункции

&НаСервереБезКонтекста
Функция СохранитьСозданноеПоступлениеНаСервере(Знач ИдентификаторПользователя, Знач UUIDДокумента, Знач СсылкаПоступления)

	ПроверитьКлючСтроки(ИдентификаторПользователя, UUIDДокумента);
	ПроверитьПоступлениеДляЗаполнения(СсылкаПоступления);
	НачатьТранзакцию();
	Попытка
		БлокировкаСвязи = Новый БлокировкаДанных;
		ЭлементБлокировки = БлокировкаСвязи.Добавить("РегистрСведений.DR_ПринятыеМобильныеДокументы");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ИдентификаторПользователя", ИдентификаторПользователя);
		ЭлементБлокировки.УстановитьЗначение("UUIDДокумента", UUIDДокумента);
		БлокировкаСвязи.Заблокировать();
		Подготовка = ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);
		Если ЗначениеЗаполнено(Подготовка.Документ1С) Тогда
			ВызватьИсключение "Связь с поступлением уже изменена. Созданный документ автоматически не подставлен.";
		КонецЕсли;
		DR_MobileStorage.СохранитьДокументМобильногоДокумента(
			ИдентификаторПользователя, UUIDДокумента, СсылкаПоступления);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);

КонецФункции

&НаСервере
Функция ЗаполнитьДокументНаСервере(Знач ИдентификаторПользователя, Знач UUIDДокумента,
	Знач СсылкаПоступления, Знач ВерсияПоступления, Знач ПодтвержденПовтор)

	Ответ = Новый Структура("Статус,Сообщение", "error", "");
	Старт = Неопределено;
	ЦельЗаблокирована = Ложь;
	ДокументЗаполнен = Ложь;
	ФиксацияНачата = Ложь;
	АдресФайла = "";
	АдресРезультата = "";
	Попытка
		Если ТранзакцияАктивна() Тогда
			ВызватьИсключение "Заполнение нельзя запускать внутри внешней транзакции.";
		КонецЕсли;
		Подготовка = ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);
		Если Подготовка.Документ1С <> СсылкаПоступления Тогда
			ВызватьИсключение "Связь с поступлением изменена. Повторите команду.";
		КонецЕсли;
		ЗаблокироватьДанныеДляРедактирования(СсылкаПоступления);
		ЦельЗаблокирована = Истина;
		Подготовка = ПроверитьПоступлениеДляЗаполнения(СсылкаПоступления);
		Если Подготовка.ВерсияДанных <> ВерсияПоступления Тогда
			ВызватьИсключение "Поступление изменено после подтверждения. Повторите команду и проверьте табличную часть.";
		КонецЕсли;
		Старт = DR_MobileStorage.НачатьРаспознаваниеМобильногоДокумента(
			ИдентификаторПользователя, UUIDДокумента, ПодтвержденПовтор);
		Если Старт.НуженПовтор Тогда
			Ответ.Статус = "confirmation";
		Иначе
			Оригинал = DR_MobileStorage.ПолучитьОригиналДляРаспознавания(ИдентификаторПользователя, UUIDДокумента);
			Подготовка = ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);
			Если Подготовка.Документ1С <> СсылкаПоступления ИЛИ Подготовка.ВерсияДанных <> ВерсияПоступления Тогда
				ВызватьИсключение "Документ для заполнения изменён. Распознавание не запускалось.";
			КонецЕсли;
			АдресФайла = ПоместитьВоВременноеХранилище(Оригинал.ДвоичныеДанные, УникальныйИдентификатор);
			ФайлРаспознавания = Новый Структура("АдресФайла,ТипФайла", АдресФайла, Оригинал.ТипФайла);
			СтруктураРаспознавания = Новый Структура("ФайлРаспознавания,ОбъектЗаполнения",
				ФайлРаспознавания, Неопределено);
			МассивФайлов = Новый Массив;
			МассивФайлов.Добавить(СтруктураРаспознавания);
			АдресРезультата = DR_RecognitionService.РаспознатьМассивФайлов(МассивФайлов, Истина);
			ПодготовленныйРезультат = ПолучитьПодготовленныйРезультатOCR(АдресРезультата);
			НачатьТранзакцию();
			Попытка
				Подготовка = ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);
				Если Подготовка.Документ1С <> СсылкаПоступления ИЛИ Подготовка.ВерсияДанных <> ВерсияПоступления Тогда
					ВызватьИсключение "Поступление или связь изменены во время OCR. Повторите операцию и подтвердите очистку заново.";
				КонецЕсли;
				РезультатЗаполнения = DR_DocumentFactory.СоздатьДокумент(
					ПодготовленныйРезультат, СсылкаПоступления, Истина);
				ПроверитьОшибкуЗаполнения(РезультатЗаполнения);
				Итог = ПроверитьПоступлениеДляЗаполнения(СсылкаПоступления);
				Если НЕ Итог.ЕстьТовары ИЛИ Итог.ВерсияДанных = ВерсияПоступления Тогда
					ВызватьИсключение "Заполнение не подтверждено: поступление не записано или не содержит товаров.";
				КонецЕсли;
				ФиксацияНачата = Истина;
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ВызватьИсключение;
			КонецПопытки;
			ДокументЗаполнен = Истина;
			Попытка
				Подготовка = ПодготовитьЗаполнениеНаСервере(ИдентификаторПользователя, UUIDДокумента);
				Если Подготовка.Документ1С <> СсылкаПоступления Тогда
					ВызватьИсключение "Сохранённая связь с поступлением изменилась.";
				КонецЕсли;
				DR_MobileStorage.ЗавершитьРаспознаваниеМобильногоДокумента(
					ИдентификаторПользователя, UUIDДокумента, Перечисления.DR_СостоянияМобильныхДокументов.Распознан);
				Ответ.Статус = "success";
				Ответ.Сообщение = "Документ заполнен и записан. Его можно открыть в колонке «Документ».";
			Исключение
				Ответ.Статус = "state_error";
				Ответ.Сообщение = "Поступление уже заполнено и записано, но состояние мобильного документа не обновлено: "
					+ ОписаниеОшибки() + Символы.ПС + "Проверьте поступление перед повторным запуском OCR.";
			КонецПопытки;
		КонецЕсли;
	Исключение
		Ответ.Сообщение = ОписаниеОшибки();
		Если ФиксацияНачата И НЕ ДокументЗаполнен Тогда
			Ответ.Сообщение = "Не удалось подтвердить фиксацию поступления. Проверьте документ вручную перед повтором: " + Ответ.Сообщение;
		КонецЕсли;
		Если Старт <> Неопределено Тогда
			Если НЕ Старт.НуженПовтор И НЕ ДокументЗаполнен Тогда
				Попытка
					DR_MobileStorage.ЗавершитьРаспознаваниеМобильногоДокумента(
						ИдентификаторПользователя, UUIDДокумента, Перечисления.DR_СостоянияМобильныхДокументов.ОшибкаРаспознавания);
				Исключение
					Ответ.Сообщение = Ответ.Сообщение + Символы.ПС + "Не удалось записать состояние ошибки: " + ОписаниеОшибки();
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	КонецПопытки;
	ОчиститьВременныеДанныеOCR(АдресФайла, Ответ);
	ОчиститьВременныеДанныеOCR(АдресРезультата, Ответ);
	Если Старт <> Неопределено Тогда
		Если НЕ Старт.НуженПовтор Тогда
			Попытка
				РазблокироватьДанныеДляРедактирования(Старт.КлючРедактирования);
			Исключение
				Ответ.Сообщение = Ответ.Сообщение + Символы.ПС + "Не удалось явно снять блокировку мобильного документа.";
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Если ЦельЗаблокирована Тогда
		Попытка
			РазблокироватьДанныеДляРедактирования(СсылкаПоступления);
		Исключение
			Ответ.Сообщение = Ответ.Сообщение + Символы.ПС + "Не удалось явно снять блокировку поступления.";
		КонецПопытки;
	КонецЕсли;
	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПодготовленныйРезультатOCR(Знач АдресРезультата)

	Если НЕ ЭтоАдресВременногоХранилища(АдресРезультата) Тогда
		ВызватьИсключение "Сервис OCR не вернул адрес результата.";
	КонецЕсли;
	Результаты = ПолучитьИзВременногоХранилища(АдресРезультата);
	Если ТипЗнч(Результаты) <> Тип("Массив") Тогда
		ВызватьИсключение "Сервис OCR не вернул массив результатов.";
	КонецЕсли;
	Если Результаты.Количество() <> 1 Тогда
		ВызватьИсключение "Ожидался один результат заполнения.";
	КонецЕсли;
	Результат = Результаты[0];
	ПроверитьОшибкуЗаполнения(Результат);
	ПодготовленныйДокумент = Неопределено;
	Если НЕ Результат.Свойство("Document", ПодготовленныйДокумент) Тогда
		ВызватьИсключение "Сервис OCR не вернул подготовленный Document.";
	КонецЕсли;
	Если ТипЗнч(ПодготовленныйДокумент) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорректный тип подготовленного Document.";
	КонецЕсли;
	ТипОбъекта = Неопределено;
	Если НЕ ПодготовленныйДокумент.Свойство("ТипОбъекта", ТипОбъекта) Тогда
		ВызватьИсключение "В подготовленном Document отсутствует ТипОбъекта.";
	КонецЕсли;
	Если ТипОбъекта <> "Документ" Тогда
		ВызватьИсключение "Результат OCR не предназначен для заполнения документа.";
	КонецЕсли;
	ТаблицаТоваров = Неопределено;
	Если НЕ ПодготовленныйДокумент.Свойство("ТабличнаяЧасть", ТаблицаТоваров) Тогда
		ВызватьИсключение "В подготовленном Document отсутствует таблица товаров.";
	КонецЕсли;
	Если ТипЗнч(ТаблицаТоваров) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Некорректный тип таблицы товаров OCR.";
	КонецЕсли;
	Если ТаблицаТоваров.Количество() = 0 Тогда
		ВызватьИсключение "Распознанная таблица товаров пуста. Поступление не изменено.";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьОшибкуЗаполнения(Знач Результат)

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		ВызватьИсключение "Некорректный результат заполнения.";
	КонецЕсли;
	ОшибкаЗаполнения = Неопределено;
	Если НЕ Результат.Свойство("Ошибка", ОшибкаЗаполнения) Тогда
		ВызватьИсключение "Отсутствует признак ошибки заполнения.";
	КонецЕсли;
	Если ТипЗнч(ОшибкаЗаполнения) <> Тип("Строка") Тогда
		ВызватьИсключение "Сервис не подтвердил результат заполнения.";
	КонецЕсли;
	Если ЗначениеЗаполнено(ОшибкаЗаполнения) Тогда
		ВызватьИсключение ОшибкаЗаполнения;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Распознавание

&НаСервере
Функция РаспознатьНаСервере(ИдентификаторПользователя, UUIDДокумента, ПодтвержденПовтор)

	ПроверитьКлючСтроки(ИдентификаторПользователя, UUIDДокумента);
	Если НЕ Константы.DR_ПоказатьТабличныйДокумент.Получить() Тогда
		Возврат Новый Структура("Статус,Сообщение,ТабДокумент", "notice",
			"Заполнение документов будет доступно после реализации следующего этапа.", Неопределено);
	КонецЕсли;
	Старт = DR_MobileStorage.НачатьРаспознаваниеМобильногоДокумента(
		ИдентификаторПользователя, UUIDДокумента, ПодтвержденПовтор);
	Если Старт.НуженПовтор Тогда
		Возврат Новый Структура("Статус,Сообщение,ТабДокумент", "confirmation", "", Неопределено);
	КонецЕсли;
	АдресФайла = "";
	АдресРезультата = "";
	Ответ = Новый Структура("Статус,Сообщение,ТабДокумент", "error", "", Неопределено);
	Попытка
		Оригинал = DR_MobileStorage.ПолучитьОригиналДляРаспознавания(ИдентификаторПользователя, UUIDДокумента);

		Если НЕ Константы.DR_ПоказатьТабличныйДокумент.Получить() Тогда
			DR_MobileStorage.ЗавершитьРаспознаваниеМобильногоДокумента(
				ИдентификаторПользователя, UUIDДокумента, Старт.ПредыдущееСостояние);
			Ответ.Статус = "notice";
			Ответ.Сообщение = "Заполнение документов будет доступно после реализации следующего этапа.";
		Иначе
			АдресФайла = ПоместитьВоВременноеХранилище(Оригинал.ДвоичныеДанные, УникальныйИдентификатор);
			ФайлРаспознавания = Новый Структура("АдресФайла,ТипФайла", АдресФайла, Оригинал.ТипФайла);
			СтруктураРаспознавания = Новый Структура("ФайлРаспознавания,ОбъектЗаполнения", ФайлРаспознавания, Неопределено);
			МассивФайлов = Новый Массив;
			МассивФайлов.Добавить(СтруктураРаспознавания);
			DR_MobileStorage.ПроверитьДоступКМобильномуДокументу(ИдентификаторПользователя, UUIDДокумента);
			АдресРезультата = DR_RecognitionService.РаспознатьМассивФайлов(МассивФайлов);
			Результаты = ПолучитьИзВременногоХранилища(АдресРезультата);
			Если ТипЗнч(Результаты) <> Тип("Массив") Тогда
				ВызватьИсключение "Сервис OCR не вернул массив результатов.";
			КонецЕсли;
			Если Результаты.Количество() <> 1 Тогда
				ВызватьИсключение "Ожидался один результат OCR.";
			КонецЕсли;
			Результат = Результаты[0];
			Если ТипЗнч(Результат) <> Тип("Структура") Тогда
				ВызватьИсключение "Некорректный результат OCR.";
			КонецЕсли;
			ОшибкаOCR = "";
			Если НЕ Результат.Свойство("Ошибка", ОшибкаOCR) Тогда
				ВызватьИсключение "Результат OCR не содержит признака ошибки.";
			КонецЕсли;
			Если ЗначениеЗаполнено(ОшибкаOCR) Тогда
				ВызватьИсключение Строка(ОшибкаOCR);
			КонецЕсли;
			ТабДокумент = Неопределено;
			Если НЕ Результат.Свойство("ТабДокумент", ТабДокумент) Тогда
				ВызватьИсключение "Сервис OCR не вернул печатную форму.";
			КонецЕсли;
			Если ТипЗнч(ТабДокумент) <> Тип("ТабличныйДокумент") Тогда
				ВызватьИсключение "Не удалось сформировать результат по существующему макету МакетТаблица.";
			КонецЕсли;
			DR_MobileStorage.ЗавершитьРаспознаваниеМобильногоДокумента(
				ИдентификаторПользователя, UUIDДокумента, Перечисления.DR_СостоянияМобильныхДокументов.Распознан);
			Ответ.Статус = "success";
			Ответ.Сообщение = "Распознавание завершено.";
			Ответ.ТабДокумент = ТабДокумент;
		КонецЕсли;
	Исключение

		Причина = ОписаниеОшибки();
		Попытка
			DR_MobileStorage.ЗавершитьРаспознаваниеМобильногоДокумента(
				ИдентификаторПользователя, UUIDДокумента, Перечисления.DR_СостоянияМобильныхДокументов.ОшибкаРаспознавания);
		Исключение
			Причина = Причина + Символы.ПС + "Не удалось записать состояние ошибки: " + ОписаниеОшибки();
		КонецПопытки;
		Ответ.Сообщение = Причина;
	КонецПопытки;

	ОчиститьВременныеДанныеOCR(АдресФайла, Ответ);
	ОчиститьВременныеДанныеOCR(АдресРезультата, Ответ);
	Попытка
		РазблокироватьДанныеДляРедактирования(Старт.КлючРедактирования);
	Исключение
		Ответ.Сообщение = Ответ.Сообщение + Символы.ПС + "Не удалось явно снять блокировку распознавания: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Ответ;

КонецФункции

&НаСервереБезКонтекста
Процедура ОчиститьВременныеДанныеOCR(Адрес, Ответ)

	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УдалитьИзВременногоХранилища(Адрес);
	Исключение
		Ответ.Сообщение = Ответ.Сообщение + Символы.ПС + "Предупреждение: не завершена очистка временного хранилища OCR.";
	КонецПопытки;

КонецПроцедуры

