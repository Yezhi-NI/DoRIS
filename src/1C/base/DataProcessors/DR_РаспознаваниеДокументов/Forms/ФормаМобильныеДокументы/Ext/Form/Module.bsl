&НаСервере
Процедура ОбновитьНаСервере()

	Контекст = КонтекстДоступа();

	ВладелецОтбора = "";
	Если ЗначениеЗаполнено(ОтборПользователь) Тогда
		ПользовательОтбораИБ = DR_MobileSettings.ПолучитьПользователяИБ(ОтборПользователь);
		ВладелецОтбора = НРег(Строка(ПользовательОтбораИБ.УникальныйИдентификатор));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаС) И ЗначениеЗаполнено(ДатаПо) И ДатаС > ДатаПо Тогда
		ВызватьИсключение "Начало периода позже окончания.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ИдентификаторПользователя, UUIDДокумента, Манифест,
        |ДатаПриема, Состояние, Контрагент, Документ1С
        |ИЗ РегистрСведений.DR_ПринятыеМобильныеДокументы
        |ГДЕ ИдентификаторПользователя = &Владелец
        |И (НЕ &ЕстьПользователь ИЛИ ИдентификаторПользователя = &ВладелецОтбора)
        |И (НЕ &ЕстьКонтрагент ИЛИ Контрагент = &Контрагент)
        |И (НЕ &ЕстьСостояние ИЛИ Состояние = &Состояние)
        |И (НЕ &ЕстьНачало ИЛИ ДатаПриема >= &ДатаС)
        |И (НЕ &ЕстьОкончание ИЛИ ДатаПриема <= &ДатаПо)
        |УПОРЯДОЧИТЬ ПО ДатаПриема УБЫВ, ИдентификаторПользователя, UUIDДокумента";
	Запрос.УстановитьПараметр("Владелец", Контекст.Владелец);
	Запрос.УстановитьПараметр("ЕстьПользователь", ЗначениеЗаполнено(ОтборПользователь));
	Запрос.УстановитьПараметр("ВладелецОтбора", ВладелецОтбора);
	Запрос.УстановитьПараметр("ЕстьКонтрагент", ЗначениеЗаполнено(ОтборКонтрагент));
	Запрос.УстановитьПараметр("Контрагент", ОтборКонтрагент);
	Запрос.УстановитьПараметр("ЕстьСостояние", ЗначениеЗаполнено(ОтборСостояние));
	Запрос.УстановитьПараметр("Состояние", ОтборСостояние);
	Запрос.УстановитьПараметр("ЕстьНачало", ЗначениеЗаполнено(ДатаС));
	Запрос.УстановитьПараметр("ДатаС", НачалоДня(ДатаС));
	Запрос.УстановитьПараметр("ЕстьОкончание", ЗначениеЗаполнено(ДатаПо));
	Запрос.УстановитьПараметр("ДатаПо", КонецДня(ДатаПо));

	Таблица = РеквизитФормыВЗначение("Список");
	Таблица.Очистить();
	Владельцы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаСписка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, Выборка, "ИдентификаторПользователя,UUIDДокумента,ДатаПриема,Состояние,Контрагент,Документ1С");
		СтрокаСписка.Выбор = Ложь;
		СтрокаСписка.Файл = ИмяОсновногоФайла(Выборка.Манифест, Выборка.UUIDДокумента);
		Если НЕ DR_Validation.КорректныйUUID(Выборка.ИдентификаторПользователя) Тогда

			Продолжить;
		КонецЕсли;
		Владелец = Владельцы.Получить(Выборка.ИдентификаторПользователя);
		Если Владелец = Неопределено Тогда
			Владелец = Пользователи.НайтиПоИдентификатору(Новый УникальныйИдентификатор(Выборка.ИдентификаторПользователя));
			Если ТипЗнч(Владелец) <> Тип("СправочникСсылка.Пользователи") Тогда
				Владелец = Справочники.Пользователи.ПустаяСсылка();
			КонецЕсли;
			Владельцы.Вставить(Выборка.ИдентификаторПользователя, Владелец);
		КонецЕсли;
		СтрокаСписка.Владелец = Владелец;
	КонецЦикла;

	Если Не ПустаяСтрока(ПолеСортировки) Тогда
		Если Найти(",Выбор,Файл,ДатаПриема,Состояние,Контрагент,Документ1С,Владелец,", "," + ПолеСортировки + ",") = 0 Тогда
			ВызватьИсключение "Неизвестное поле сортировки.";
		КонецЕсли;
		Таблица.Сортировать(ПолеСортировки + ?(ПоУбыванию, " Убыв", " Возр"));
	КонецЕсли;
	ЗначениеВРеквизитФормы(Таблица, "Список");
	ПросмотрРезультата = Константы.DR_ПоказатьТабличныйДокумент.Получить();
	РежимOCR = ?(ПросмотрРезультата, "Просмотр результата распознавания", "Заполнение документа 1С");
	СостояниеСписка = ?(Таблица.Количество() = 0, "Документы по выбранным условиям отсутствуют.",
		"Документов: " + Формат(Таблица.Количество(), "ЧГ=0"));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяОсновногоФайла(ХранилищеМанифеста, UUIDДокумента)

	Попытка
		Манифест = ХранилищеМанифеста.Получить();
		Если ТипЗнч(Манифест) <> Тип("Структура") Тогда
			Возврат UUIDДокумента;
		КонецЕсли;
		Если Манифест.files.Количество() = 0 Тогда
			Возврат UUIDДокумента;
		КонецЕсли;

		Имя = Манифест.files[0].filename;
		Если ТипЗнч(Имя) = Тип("Строка") И СтрДлина(Имя) <= 255
			И НЕ ПустаяСтрока(Имя) И СтрНайти(Имя, "/") = 0 И СтрНайти(Имя, "\") = 0 Тогда
			Для Индекс = 1 По СтрДлина(Имя) Цикл
				Если КодСимвола(Имя, Индекс) < 32 ИЛИ КодСимвола(Имя, Индекс) = 127 Тогда
					Возврат UUIDДокумента;
				КонецЕсли;
			КонецЦикла;
			Возврат Имя;
		КонецЕсли;
	Исключение

		Возврат UUIDДокумента;
	КонецПопытки;
	Возврат UUIDДокумента;

КонецФункции

