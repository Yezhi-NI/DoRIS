#КонецОбласти

#Область СозданиеЗаполнение

//определение документа или срправочника для создания 
Функция СоздатьДокумент(Документ, ОбъектЗаполнения) Экспорт
	
	//пропускаем проверку типов и заполнение 
	
	//определяем тип объекта и тип документа
	Если Документ.Document.ТипОбъекта = "Документ" Тогда 
		Результат = ЗаполнитьДокумент(Документ.Document, ОбъектЗаполнения);
	КонецЕсли;		
	
	Документ.Ошибка = Результат;
	Возврат Документ;
	
КонецФункции

//заполняемТЧ документа
Функция ЗаполнитьДокумент(Документ, ОбъектЗаполнения) 
	
	ТекстОшибки = "";
	ДокОбъект = ОбъектЗаполнения.ПолучитьОбъект();
	
	Попытка
	
	Для Каждого СтрокаТаблицы ИЗ Документ.ТабличнаяЧасть Цикл
		//лучше искать по штрихкоду. нужно добавить поиск по шк и нтин
		СтрокаТоваров = ДокОбъект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТоваров, СтрокаТаблицы); 
		Если ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			ЭлНоменклатура = НайтиЭлементСправочника(СтрокаТаблицы.Номенклатура, "Номенклатура");
			Если ЗначениеЗаполнено(ЭлНоменклатура) Тогда
				СтрокаТоваров.Номенклатура = ЭлНоменклатура;	
			    СтрокаТоваров.СтавкаНДС = ЭлНоменклатура.СтавкаНДС;
				СтрокаТоваров.ЕдиницаИзмерения = ЭлНоменклатура.БазоваяЕдиницаИзмерения;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТоваров.Коэффициент = 1;
		СтрокаТоваров.СуммаНДС = УчетНДСиАкцизаКлиентСервер.РассчитатьСуммуНДС(СтрокаТоваров.Сумма, Истина, 
			ДокОбъект.СуммаВключаетНДС, УчетНДСиАкцизаВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаТоваров.СтавкаНДС),,);

	КонецЦикла;
	
	ТоварыЗаполнитьСчетаУчета(ДокОбъект);
	ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	Исключение
		ТекстОшибки = "Не удалось создать и записать документ";
	КонецПопытки;
	
	Возврат ТекстОшибки;	
			
КонецФункции

Процедура ТоварыЗаполнитьСчетаУчета(ОбъектЗаполнения)
	
	Документы.ПоступлениеТоваровУслуг.ЗаполнитьСчетаУчетаВТабличнойЧасти(ОбъектЗаполнения, "Товары");

КонецПроцедуры

Функция НайтиЭлементСправочника(ЭлПоиска, ТипЭлемента)
	
	ОбъектСсылка = Неопределено;
	Запрос = Новый Запрос;
    Запрос.Текст = ТекстЗапроса(ТипЭлемента);
	Запрос.УстановитьПараметр("Наименование", ЭлПоиска);
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
    Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбъектСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат ОбъектСсылка;
	
КонецФункции

Функция ТекстЗапроса(ТипЭлемента) 
	
	ТекстЗапроса = "";
	
	Если ТипЭлемента = "Контрагент" Тогда
	
		ТекстЗапроса = 	
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.Наименование = &Наименование";

	 ИначеЕсли ТипЭлемента = "Номенклатура" Тогда
	
		ТекстЗапроса = 	
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Наименование = &Наименование";

	 ИначеЕсли ТипЭлемента = "ЕИ" Тогда
	
		ТекстЗапроса = 	
			"ВЫБРАТЬ
			|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
			|ГДЕ
			|	КлассификаторЕдиницИзмерения.Наименование = &Наименование";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
			
КонецФункции

Функция НайтиКонтрагента(Контрагент) 
	
	КонтрагентСсылка = Справочники.Контрагенты.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", Контрагент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		КонтрагентСсылка = ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат КонтрагентСсылка;
			
КонецФункции

&НаСервере
Функция ПечатьНакладная(ТаблицаДляПечати) Экспорт
	
	Если НЕ Константы.DR_ПоказатьТабличныйДокумент.Получить() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
	Макет = Обработки.DR_РаспознаваниеДокументов.ПолучитьМакет("МакетТаблица");
	
	ТабДокумент = Новый ТабличныйДокумент;
	ШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицыСКодом");
	Строка = Макет.ПолучитьОбласть("СтрокаСКодом");
	
	ТабДокумент.Вывести(ШапкаТаблицы);

	Для Каждого СтрокаТаблицы ИЗ ТаблицаДляПечати Цикл	
		Строка.Параметры.Заполнить(СтрокаТаблицы);
       	ТабДокумент.Вывести(Строка);
	КонецЦикла;
			
	Возврат ТабДокумент;
	
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти

