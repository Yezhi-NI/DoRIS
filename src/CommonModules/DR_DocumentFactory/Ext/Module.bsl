#Область СтруктураДанных

Функция СоздатьСтруктуруДокумент() Экспорт

	Документ = Новый Структура;

	Документ.Вставить("ТипОбъекта", "");
	Документ.Вставить("ТипДокумента", ""); 
	Документ.Вставить("МассивСтрок", "");	
	Документ.Вставить("РеквизитыДокумента", СоздатьРеквизитыДокумента());
	Документ.Вставить("ТабличнаяЧасть", СоздатьТабличнуюЧастьДокумента());

	Возврат Документ;

КонецФункции

Функция СоздатьРеквизитыДокумента() Экспорт

	Реквизиты = Новый Структура;

	Реквизиты.Вставить("Контрагент", "");
	Реквизиты.Вставить("Организация", "");
	Реквизиты.Вставить("ДатаДокумента", Неопределено);
	Реквизиты.Вставить("НомерДокумента", "");
	Реквизиты.Вставить("Валюта", "");
	Реквизиты.Вставить("СуммаДокумента", 0);
	Реквизиты.Вставить("Комментарий", "");
	
	Возврат Реквизиты;

КонецФункции

Функция СоздатьТабличнуюЧастьДокумента() Экспорт
	
	ТаблицаТоваров = Новый ТаблицаЗначений;
	ТаблицаТоваров.Колонки.Добавить("НомерСтроки",,"НомерСтроки"); 
	ТаблицаТоваров.Колонки.Добавить("Номенклатура",,"Номенклатура"); 
	ТаблицаТоваров.Колонки.Добавить("ЕИ",,"ЕдиницаИзмерения"); 
	ТаблицаТоваров.Колонки.Добавить("Количество",,"Количество"); 
	ТаблицаТоваров.Колонки.Добавить("Цена",,"Цена"); 
	ТаблицаТоваров.Колонки.Добавить("СуммаБезНДС",,"СуммаБезНДС"); 
	ТаблицаТоваров.Колонки.Добавить("СуммаНДС",,"СуммаНДС"); 
	ТаблицаТоваров.Колонки.Добавить("Сумма",,"СуммаСНДС"); 
	ТаблицаТоваров.Колонки.Добавить("GTIN",,"GTIN"); 
	ТаблицаТоваров.Колонки.Добавить("NTIN",,"NTIN"); 
	ТаблицаТоваров.Колонки.Добавить("СтавкаНДС",,"СтавкаНДС"); 
	ТаблицаТоваров.Колонки.Добавить("Артикул",,"Артикул"); 
	ТаблицаТоваров.Колонки.Добавить("Код",,"Код");	
	Возврат ТаблицаТоваров;

КонецФункции

Функция СоздатьСтрокуТабличнойЧасти() Экспорт

