Функция ПолучитьНастройки() Экспорт
	
	Провайдер = Константы.DR_АктивныйАдаптер.Получить();
	
	СохраненныеНастройки = ПрочитатьНастройки(Провайдер); 
	
	Провайдер = ПолучитьПровайдерРаспознавания(Провайдер);
		
	Если Провайдер = Неопределено Тогда
		DR_Validation.ВызватьИсключениеОшибки("Не удалось определить адаптер для распознавания");	
	КонецЕсли;

    Настройки = Новый Структура;
	
	// OCR
    Настройки.Вставить("ПровайдерOCR", Провайдер);
    Настройки.Вставить("Сервер", СохраненныеНастройки.АдресСервиса);
	Настройки.Вставить("АдресСервиса", СохраненныеНастройки.АдресРесурса);
    Настройки.Вставить("ApiKey", СохраненныеНастройки.ApiKey);
    Настройки.Вставить("Промпт", СохраненныеНастройки.Промпт);
    // Таймауты
    Настройки.Вставить("ТаймаутHTTP", СохраненныеНастройки.Таймаут);
    Настройки.Вставить("ИнтервалОпроса", 2);
    Настройки.Вставить("МаксимальноеКоличествоОпросов", 300);

    Возврат Настройки;

КонецФункции

Функция ТипыОтветовOCR() Экспорт

    Типы = Новый Структура;

    Типы.Вставить("MistralOCR", 1);
    Типы.Вставить("PaddleOCR", 2);
    Типы.Вставить("AzureOCR", 3);
    Типы.Вставить("GoogleOCR", 4);
    Типы.Вставить("LocalOCR", 5);
    Типы.Вставить("Unknown", 0);

    Возврат Типы;

КонецФункции

Функция ТипыМоделейOCR() Экспорт

    Типы = Новый Структура;

    Типы.Вставить("MistralOCR", "mistral-ocr-latest");
    Типы.Вставить("Unknown", 0);

    Возврат Типы;

КонецФункции

Функция СтатусыРаспознавания() Экспорт

    Статусы = Новый Структура;
    Статусы.Вставить("Успешно", 1);
    Статусы.Вставить("Ошибка", 0);

    Возврат Статусы;

КонецФункции 

Функция ПрочитатьНастройки(Провайдер)
	
	СохраненныеНастройки = Новый Структура;
	
	Если ЗначениеЗаполнено(Провайдер) Тогда
		Отбор = Новый Структура("Провайдер", Провайдер);
		Выборка = РегистрыСведений.DR_НастройкиАдаптера.Выбрать(Отбор);
		Если Выборка.Следующий() Тогда
	        Запись = Выборка.ПолучитьМенеджерЗаписи();
		    Запись.Прочитать();
			СохраненныеНастройки.Вставить("АдресСервиса", Запись.АдресСервиса);
			СохраненныеНастройки.Вставить("АдресРесурса", Запись.АдресРесурса);
			СохраненныеНастройки.Вставить("Порт", Запись.Порт); 
			СохраненныеНастройки.Вставить("Таймаут", Запись.Таймаут);
			СохраненныеНастройки.Вставить("ApiKey", Запись.ApiKey); 
			СохраненныеНастройки.Вставить("Промпт", Запись.Промпт);
            Запись.Записать(Истина);
		КонецЕсли; 
	КонецЕсли;

	Возврат СохраненныеНастройки;
	
КонецФункции 

Функция ПолучитьПровайдерРаспознавания(Провайдер)
	
	Если НЕ ЗначениеЗаполнено(Провайдер) Тогда
		Возврат Неопределено;	
	КонецЕсли;	
	
	ПровайдерСоответствие = Новый Соответствие;
	ПровайдерСоответствие.Вставить("MistralOCR", DR_MistralCloudProvider); 
	ПровайдерСоответствие.Вставить("PaddleOCR", DR_PaddleCloudProvider); 
	
	Возврат ПровайдерСоответствие.Получить(Провайдер);

КонецФункции  


