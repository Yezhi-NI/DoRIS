Функция ВыполнитьРаспознавание(Настройки, СтруктураФайла) Экспорт

	Попытка

		ДвоичныеДанные = ПолучитьИзВременногоХранилища(СтруктураФайла.АдресФайла);

		Если ДвоичныеДанные = Неопределено Тогда
			Возврат СоздатьРезультат(, "Не удалось получить файл из временного хранилища.");
		КонецЕсли;
		
		Base64 = Base64Строка(ДвоичныеДанные);
    	Base64 = СтрЗаменить(Base64, Символы.ВК, "");
		Base64 = СтрЗаменить(Base64, Символы.ПС, "");
		
		УдалитьИзВременногоХранилища(СтруктураФайла.АдресФайла);
		
		HTTPЗапрос_ = СоздатьHTTPЗапрос(
			Настройки.Сервер,
			Настройки.АдресСервиса,
			ПолучитьЗаголовки(Настройки),
			ПолучитьПараметры(Настройки, Base64, СтруктураФайла.ТипФайла),
			Неопределено,
			СтруктураФайла.ТипФайла);

		HTTPОтвет = DR_HttpClient.ОтправитьPOSTЗапрос(HTTPЗапрос_);

		Если Не DR_HttpClient.ПроверитьHTTPОтвет(HTTPОтвет) Тогда
			Возврат СоздатьРезультат(, HTTPОтвет.Ошибка);
		КонецЕсли;
		
		СтруктураДокументов = РазобратьОтветMistralOCR(HTTPОтвет.Тело); 
		Возврат СоздатьРезультат(HTTPОтвет.Тело, СтруктураДокументов.ТекстОшибки,
			СтруктураДокументов.МассивДокументов);
		
	Исключение

		Возврат СоздатьРезультат(, ОписаниеОшибки());

	КонецПопытки;

КонецФункции

Функция СоздатьHTTPЗапрос( URL, АдресСервиса, Заголовки, Параметры = Неопределено, ДвоичныеДанные = Неопределено, ТипФайла = "") 

	HTTPЗапрос_ = DR_HttpClient.ПолучитьСтруктуруHTTPЗапроса();

	HTTPЗапрос_.URL = URL;
	HTTPЗапрос_.Заголовки = Заголовки;
	HTTPЗапрос_.Параметры = Параметры;
	HTTPЗапрос_.ДвоичныеДанные = ДвоичныеДанные;
	HTTPЗапрос_.ТипФайла = ТипФайла;
	HTTPЗапрос_.ИмяПоляФайла = "file";
    HTTPЗапрос_.АдресСервиса = АдресСервиса;
	
	Возврат HTTPЗапрос_;

КонецФункции

Функция ПолучитьЗаголовки(Настройки)

	Заголовки = Новый Соответствие;
    Заголовки.Вставить("Authorization", "Bearer " + Настройки.ApiKey);
    Заголовки.Вставить("Content-Type", "application/json");
    Заголовки.Вставить("Accept", "application/json");

	Возврат Заголовки;

КонецФункции

Функция ПолучитьПараметры(Настройки, Base64, ТипФайла = "")

	Документ = Новый Структура;

	//пока если не pdf, то изображение. добавить обработку других форматов
	Если НРег(ТипФайла) = "pdf" Тогда
    	Документ.Вставить("type", "document_url");
    	Документ.Вставить("document_url", "data:application/pdf;base64," + Base64);
	Иначе 
		Документ.Вставить("type", "image_url");
    	Документ.Вставить("image_url", "data:image/jpeg;base64," + Base64);
	КонецЕсли;
	
	Параметры = Новый Структура;
    Параметры.Вставить("model", "mistral-ocr-latest");
    Параметры.Вставить("document", Документ);
    Параметры.Вставить("table_format", "html");
	
	//Если ЗначениеЗаполнено("Настройки.Промпт") Тогда
	//	Параметры = ДобавитьПромпт(Параметры, Настройки.Промпт);
	//КонецЕсли;
	
	Возврат Параметры;

КонецФункции

Функция СоздатьРезультат(JSONОтвет = "", ТекстОшибки = "", МассивДокументов = Неопределено)

	Результат = Новый Структура;

	Результат.Вставить("JobID", Неопределено);
	Результат.Вставить("ТипОтвета", DR_Settings.ТипыОтветовOCR().MistralOCR);
	Результат.Вставить("JSONОтвет", JSONОтвет);
	Результат.Вставить("МассивДокументов", МассивДокументов);
	Результат.Вставить("Статус", ?(ЗначениеЗаполнено(ТекстОшибки), DR_Settings.СтатусыРаспознавания().Ошибка, 
						DR_Settings.СтатусыРаспознавания().Успешно));
	Результат.Вставить("Ошибка", ТекстОшибки);

	Возврат Результат;

КонецФункции

Функция ПолучитьСтруктуруЗапроса(ТекстURL)

	Результат = Новый Структура;
	
	Индекс = СтрНайти(ТекстURL, "/v1/job/");
	ДлинаСтрокиАдресаСервиса = СтрДлина(ТекстURL); 
	
	АдресСервиса = Сред(ТекстURL, Индекс, ДлинаСтрокиАдресаСервиса - Индекс + 1);
	Сервер = СтрЗаменить(Лев(ТекстURL, Индекс -1), "https://","");
	
	Результат.Вставить("АдресСервиса", АдресСервиса);
	Результат.Вставить("Сервер", Сервер);

	Возврат Результат;

КонецФункции

Функция РазобратьОтветMistralOCR(РезультатOCR)
	
	////для теста
	//Markdown = ПолучитьОбщийМакет("DR_тест1").ПолучитьТекст();
	////---------
	СтруктураРаспознанныхДокументов = Новый Структура("ТекстОшибки, МассивДокументов");
	СтруктураРаспознанныхДокументов.МассивДокументов = Новый Массив;
	
	Markdown = ПолучитьРезультатMistralOCR(РезультатOCR);
	
	Если ПустаяСтрока(Markdown) Тогда
		СтруктураРаспознанныхДокументов.ТекстОшибки = "Markdown отсутствует.";
		Возврат СтруктураРаспознанныхДокументов;  
	КонецЕсли;
	
	РезультатРазбораMarkdown = РазобратьMarkdownMistralOCR(Markdown, СтруктураРаспознанныхДокументов);

	Возврат РезультатРазбораMarkdown;

КонецФункции

Функция РазобратьMarkdownMistralOCR(Markdown, СтруктураРаспознанныхДокументов)

	СтрокиMarkdown = СтрРазделить(Markdown, Символы.ПС);
	
	Документ = Новый Структура;
	//шапка, подвал и тп
	СтрокиДокумента = Новый Массив;
	//таблицы товаров
	ТаблицыТоваров = Новый Массив;
	
	Для Каждого СтрокаMarkdown Из СтрокиMarkdown Цикл

		СтрокаMarkdown = СокрЛП(СтрокаMarkdown);

		Если ПустаяСтрока(СтрокаMarkdown) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтоТаблица(СтрокаMarkdown) Тогда
			РазобратьТаблицу(СтрокаMarkdown, ТаблицыТоваров);
			Продолжить;
        КонецЕсли;
		
		//если обычная строка, то добавляем в СтрокиДокумента
		СтрокиДокумента.Добавить(СтрокаMarkdown);
		
	КонецЦикла;
	
	Документ.Вставить("СтрокиДокумента", СтрокиДокумента);
	Документ.Вставить("ТаблицыТоваров", ТаблицыТоваров);
	СтруктураРаспознанныхДокументов.МассивДокументов.Добавить(Документ);
	
	Возврат СтруктураРаспознанныхДокументов;	
	
КонецФункции

// Получение Markdown из ответа PaddleOCR
Функция ПолучитьРезультатMistralOCR(JSONОтвет)
	
	ОтветJSON = РазобратьJSON(JSONОтвет);
	
	Markdown = "";
	
	Попытка
	Если ОтветJSON.Свойство("model") Тогда
		Если ОтветJSON.model = DR_Settings.ТипыМоделейOCR().MistralOCR Тогда
			//масиив страниц
			Если ОтветJSON.Свойство("pages") Тогда
				Для Каждого Страница ИЗ ОтветJSON.pages Цикл
					//шапка
					Markdown = Markdown + Страница.markdown + Символы.ПС;
					//таблица. обрабатываем только простые таблицы - одна таблица на странице
					Если Страница.Свойство("tables") Тогда
						Markdown = Markdown + Страница.tables[0].content + Символы.ПС;		
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			//если задавали промпт, здесь будет ответ. пока без обработки
			Если ОтветJSON.Свойство("document_annotation") Тогда
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Исключение Markdown = "";
	КонецПопытки;

	Возврат Markdown;

КонецФункции
 
Процедура РазобратьТаблицу(СтрокаMarkdown, ТаблицыТоваров)
	
	ЧтениеHTML = Новый ЧтениеHTML;
	ЧтениеHTML.УстановитьСтроку(СтрокаMarkdown, "UTF-8");
    ПостроительDOM = Новый ПостроительDOM;
    ДокументHTML = ПостроительDOM.Прочитать(ЧтениеHTML);
    
    // Находим все таблицы в исходном файле
    Таблицы = ДокументHTML.ПолучитьЭлементыПоИмени("table");
	
	Для Каждого Таблица Из Таблицы Цикл

		// Ищем строки таблиц
        СтрокиТаблицы = Таблица.ПолучитьЭлементыПоИмени("tr");
		ТаблицаМассив = Новый Массив;
				
		Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл 
			СтрокаМассив = Новый Массив;
			Колонки = СтрокаТаблицы.ПолучитьЭлементыПоИмени("td");
			Если Колонки.Количество() = 0 Тогда
	        	Колонки = СтрокаТаблицы.ПолучитьЭлементыПоИмени("th");
			КонецЕсли;	
			Для Каждого Колонка Из Колонки Цикл 
				ЗначениеСтроки = "";
                Для Каждого ЭлементУзла Из Колонка.ДочерниеУзлы Цикл
					Если ЭлементУзла.ИмяУзла = "#text" Тогда
						ЗначениеСтроки = ЗначениеСтроки + ЭлементУзла.ЗначениеУзла; 
					ИначеЕсли ЭлементУзла.ИмяУзла = "#br" Тогда 
						ЗначениеСтроки = ЗначениеСтроки + " ";
                    КонецЕсли;
				КонецЦикла;
				СтрокаМассив.Добавить(ЗначениеСтроки);
			КонецЦикла;
			ТаблицаМассив.Добавить(СтрокаМассив);
		КонецЦикла;	
		
	ТаблицыТоваров.Добавить(ТаблицаМассив);	
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ЭтоТаблица(СтрокаMarkdown)
	
    Возврат СтрНачинаетсяС(НРег(СтрокаMarkdown), "<table") 
			И СтрЗаканчиваетсяНа(НРег(СтрокаMarkdown),"</table>");
	
КонецФункции

Функция РазобратьJSON(СтрокаJSON)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

	Попытка
		Возврат ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
	Исключение
		ЧтениеJSON.Закрыть();
	КонецПопытки;

КонецФункции  

#Область Промпт 

//пока только текст
Функция ДобавитьПромпт(Параметры, Промпт) 
	
	ФорматАннотации = Новый Структура;
	ФорматАннотации.Вставить("type", "json_object");
	Параметры.Вставить("document_annotation_format", ФорматАннотации);
	Параметры.Вставить("document_annotation_prompt", Промпт);
	Возврат Параметры;
	
КонецФункции

Функция Demo_ДобавитьПромпт(ТелоЗапроса) 

	ТелоЗапроса.Вставить("document_annotation_prompt",
	    "Извлеки логическую структуру всего документа. " +
	    "Сохраняй исходные названия полей, колонок и значения. " +
	    "Не приводи документ к заранее определенному типу или бизнес-схеме. " +
	    "Не добавляй отсутствующие в документе данные. " +

	    "Для таблиц возвращай логические колонки, определяемые по заголовкам таблицы, " +
	    "а не физические ячейки HTML или визуальной сетки. " +

	    "Если один заголовок таблицы охватывает несколько физических ячеек или колонок, " +
	    "это ОДНА логическая колонка. " +
	    "В массиве Колонки такой заголовок должен присутствовать только ОДИН раз. " +
	    "Значения всех физических ячеек строки, относящихся к этому заголовку, " +
	    "объединяй в ОДНО строковое значение через пробел. " +

	    "Количество элементов каждой строки в массиве Строки должно точно совпадать " +
	    "с количеством элементов массива Колонки. " +

	    "Не создавай несколько одинаковых названий колонок из-за colspan. " +

	    "Таблица может продолжаться на следующих страницах. " +
	    "Если таблица продолжается без повторного заголовка, используй логические колонки, " +
	    "определенные по заголовку этой таблицы на предыдущей странице. " +
	    "Не считай первую строку данных следующей страницы новым заголовком. " +
	    "Если заголовок таблицы повторяется на следующей странице, " +
	    "не добавляй его как строку данных. " +

	    "Все значения возвращай строками.");
	
	// Поле документа:
	// {
	//     "Название": "...",
	//     "Значение": "..."
	// }

	СвойстваПоля = Новый Структура;
	СвойстваПоля.Вставить("Название", Новый Структура("type", "string"));
	СвойстваПоля.Вставить("Значение", Новый Структура("type", "string"));

	ОбязательныеПоляПоля = Новый Массив;
	ОбязательныеПоляПоля.Добавить("Название");
	ОбязательныеПоляПоля.Добавить("Значение");

	СхемаПоля = Новый Структура;
	СхемаПоля.Вставить("type", "object");
	СхемаПоля.Вставить("properties", СвойстваПоля);
	СхемаПоля.Вставить("required", ОбязательныеПоляПоля);
	СхемаПоля.Вставить("additionalProperties", Ложь);

	// Массив полей

	Поля = Новый Структура;
	Поля.Вставить("type", "array");
	Поля.Вставить("items", СхемаПоля);

	// Колонки таблицы:
	// ["№", "Код", "Товар", ...]

	Колонка = Новый Структура("type", "string");

	Колонки = Новый Структура;
	Колонки.Вставить("type", "array");
	Колонки.Вставить("items", Колонка);

	// Одна строка таблицы:
	// ["1", "00000000017", "...", "800 шт", ...]

	ЗначениеЯчейки = Новый Структура("type", "string");

	СтрокаТаблицы = Новый Структура;
	СтрокаТаблицы.Вставить("type", "array");
	СтрокаТаблицы.Вставить("items", ЗначениеЯчейки);

	// Все строки таблицы

	СтрокиТаблицы = Новый Структура;
	СтрокиТаблицы.Вставить("type", "array");
	СтрокиТаблицы.Вставить("items", СтрокаТаблицы);

	// Одна таблица:
	// {
	//     "Колонки": [...],
	//     "Строки": [
	//         [...],
	//         [...]
	//     ]
	// }

	СвойстваТаблицы = Новый Структура;
	СвойстваТаблицы.Вставить("Колонки", Колонки);
	СвойстваТаблицы.Вставить("Строки", СтрокиТаблицы);

	ОбязательныеПоляТаблицы = Новый Массив;
	ОбязательныеПоляТаблицы.Добавить("Колонки");
	ОбязательныеПоляТаблицы.Добавить("Строки");

	СхемаТаблицы = Новый Структура;
	СхемаТаблицы.Вставить("type", "object");
	СхемаТаблицы.Вставить("properties", СвойстваТаблицы);
	СхемаТаблицы.Вставить("required", ОбязательныеПоляТаблицы);
	СхемаТаблицы.Вставить("additionalProperties", Ложь);

	// Массив таблиц

	Таблицы = Новый Структура;
	Таблицы.Вставить("type", "array");
	Таблицы.Вставить("items", СхемаТаблицы);

	// Корневой объект

	СвойстваДокумента = Новый Структура;
	СвойстваДокумента.Вставить("Поля", Поля);
	СвойстваДокумента.Вставить("Таблицы", Таблицы);

	ОбязательныеПоляДокумента = Новый Массив;
	ОбязательныеПоляДокумента.Добавить("Поля");
	ОбязательныеПоляДокумента.Добавить("Таблицы");

	СхемаДокумента = Новый Структура;
	СхемаДокумента.Вставить("type", "object");
	СхемаДокумента.Вставить("properties", СвойстваДокумента);
	СхемаДокумента.Вставить("required", ОбязательныеПоляДокумента);
	СхемаДокумента.Вставить("additionalProperties", Ложь);

	// document_annotation_format

	JSONSchema = Новый Структура;
	JSONSchema.Вставить("name", "document");
	JSONSchema.Вставить("schema", СхемаДокумента);

	ФорматАннотации = Новый Структура;
	ФорматАннотации.Вставить("type", "json_schema");
	ФорматАннотации.Вставить("json_schema", JSONSchema);

	ТелоЗапроса.Вставить(
	    "document_annotation_format",
	    ФорматАннотации);
		
	Возврат ТелоЗапроса;
	
КонецФункции

Функция Demo_ДобавитьПромпт2(ТелоЗапроса) 
	
	ФорматАннотации = Новый Структура;
	ФорматАннотации.Вставить("type", "json_object");

	ТелоЗапроса.Вставить("document_annotation_format", ФорматАннотации);
	
	ТелоЗапроса.Вставить(
	    "document_annotation_prompt",
	    "Верни результат распознавания всего документа в JSON. " +
	    "Структуру JSON определяй по структуре самого документа. " +
	    "Не используй заранее заданную бизнес-схему. " +
	    "Сохраняй исходные названия реквизитов, секций, таблиц и колонок. " +
	    "Для таблиц используй логические колонки, заданные их заголовками. " +
	    "Если один заголовок охватывает несколько физических колонок, " +
	    "считай их одной логической колонкой и объединяй соответствующие значения. " +
	    "Таблицы могут продолжаться на следующих страницах. " +
	    "Для продолжения таблицы используй структуру и заголовки таблицы с предыдущих страниц. " +
	    "Не считай первую строку продолжения таблицы новым заголовком. " +
